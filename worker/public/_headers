# Response headers for files served by the Workers ASSET LAYER.
#
# These apply ONLY to assets the asset layer serves directly — never to
# responses generated by Worker code. That is why wrangler.jsonc excludes
# /icons/* and /ranks/* from run_worker_first: routed through the Worker they
# would be Worker responses, and every rule below would be silently ignored.
#
# Not served itself; parsed by Workers at deploy time. Max 100 rules.

# Fingerprinted subresources: the content hash is in the filename (see
# vite.config.ts assetRev), so a given URL's bytes can never change and the
# file is safe to keep for a year without revalidating. A UI deploy changes
# the URL, and the no-cache index.html that references it is what propagates.
/app.*.js
  Cache-Control: public, max-age=31536000, immutable
/style.*.css
  Cache-Control: public, max-age=31536000, immutable

# Vendored BAR bitmaps. NOT fingerprinted, and deliberately: each unit icon's
# path is baked into the unitIcons map of every published .brw head
# (internal/viz/icons.go writes "icons/<file>", the viewer requests "/" + it),
# so renaming them would 404 the icons of every replay already published.
#
# A week, and not `immutable`, because the name cannot carry the content: if
# the vendored bitmaps are ever re-synced from BAR, the old bytes stay valid
# only until this expires. Purge the zone after a re-sync to make it immediate.
/icons/*
  Cache-Control: public, max-age=604800
/ranks/*
  Cache-Control: public, max-age=604800

# The favicon cannot be fingerprinted either: /favicon.ico is requested by the
# browser on its own, at that fixed path, with no markup to point elsewhere. A
# day is the lag between changing the icon and a browser noticing it.
/favicon.*
  Cache-Control: public, max-age=86400
