{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://replay.fogofwar.dev",
          "https://replay.bartools.workers.dev",
          "http://127.0.0.1:5173",
          "http://localhost:5173",
          "https://lavabalance.fogofwar.dev",
