{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["./worker-configuration.d.ts", "vite/client", "node", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src", "tools", "tests", "vite.config.ts", "vitest.config.ts", "worker-configuration.d.ts"],
  // The summary library runs in a BROWSER, and the Workers types redefine
  // DOM names (Element, Response) incompatibly; it has its own config.
  "exclude": ["src/summary"]
}
