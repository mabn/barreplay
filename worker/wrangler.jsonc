{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replay",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-27",
  // Same Cloudflare account as the sibling claudebar/lavabalance worker.
  "account_id": "9a1829e6502587e153ffa45b76de7ed3",

  // The public hostname. `custom_domain` (as opposed to a plain route pattern)
  // makes Cloudflare create the DNS record and provision the certificate for
  // this exact hostname, so no wildcard cert is involved and no Advanced
  // Certificate Manager subscription is needed.
  //
  // REQUIREMENT: the fogofwar.dev zone must live in the SAME Cloudflare
  // account as account_id above. A Custom Domain cannot bind a zone held by
  // another account, so if the registration sits elsewhere it has to be moved
  // first (Registrar -> Manage Domain -> Configuration -> Start; the domain
  // must be >10 days old) — or this worker redeployed into that account.
  //
  // The workers.dev hostname keeps working alongside this, so the switch is
  // additive: nothing that already points at replay.bartools.workers.dev
  // breaks when this lands.
  "routes": [
    {
      "pattern": "replay.fogofwar.dev",
      "custom_domain": true
    }
  ],

  // PREVIEWS. `wrangler versions upload` uploads a build WITHOUT routing any
  // traffic to it and hands back a URL to try it on; `wrangler versions deploy`
  // is what later promotes one to production. Preview URLs can only live on
  // workers.dev (never on the custom domain), which is why the workers.dev
  // hostname stays enabled here.
  //
  // Each upload also mints a versioned URL of its own
  // (<version-prefix>-replay.bartools.workers.dev), but PREFER THE ALIAS
  // (`--preview-alias staging` -> staging-replay.bartools.workers.dev, wired
  // into the npm scripts): the replay pieces are fetched cross-origin from the
  // bucket hostname, so the origin has to be named in the bucket's CORS policy
  // (r2-cors.json), and R2 matches origins exactly — a per-version hostname
  // could never be listed there, and its replays would silently fail to load.
  //
  // A preview shares production's BINDINGS — the same R2 bucket and the same
  // catalog/jobs Durable Object. Reading is therefore the real thing; writing
  // (an upload dropped on the preview) also lands in the real queue.
  "workers_dev": true,
  "preview_urls": true,

  // The Vite build (client bundle in dist/client) is served as static assets by the
  // runtime BEFORE the Worker runs. Requests that don't match an asset fall through to
  // the Hono app in src/worker/index.ts. `single-page-application` serves index.html for
  // unmatched non-API navigations so client-side routing works.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything still goes through the Worker EXCEPT the two prefixes that
    // are plain vendored files. "/*" keeps the original guarantee — the SPA
    // entry is served no-cache by the serveEntry route (index.html carries
    // content-hashed subresource URLs, so a revalidated entry is all a UI
    // deploy needs to propagate), and no route can fall through to the asset
    // layer's single-page-application handling, which would answer /api/*
    // with index.html. That trap is why this is "/*" plus exclusions rather
    // than a list of the paths the Worker wants: the list form is
    // deny-by-default in exactly the wrong direction.
    //
    // The exclusions matter twice over. A cold replay load requests 300-650
    // unit icons; through the Worker each one is an invocation, and served by
    // the asset layer they are cached on Cloudflare's network instead. And
    // public/_headers only applies to what the ASSET LAYER serves — a Worker
    // response ignores it — so without these exclusions the cache-control
    // rules for those prefixes would be silently dead.
    //
    // The favicons are named individually rather than matched: they are two
    // fixed files, and /favicon.ico in particular must resolve to the real
    // object. Left to the Worker it reached the catch-all, where the asset
    // layer's single-page-application handling answered it with index.html —
    // a 200 carrying the whole HTML document, labelled text/html, as the tab
    // icon.
    //
    // The widget download (/setup's step 1, synced into public/ from
    // assets/lua by tools/sync-assets.mjs) is excluded for the _headers
    // reason: routed through the Worker its no-cache rule would be dead, and
    // it is the one file here whose bytes change under a stable URL.
    "run_worker_first": [
      "/*",
      "!/icons/*",
      "!/ranks/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/replay_uploader.lua"
    ]
  },

  // The growing set of replay data (index.json + per-capture head/chunks/resources)
  // lives in this R2 bucket, produced by `barreplay-static` and synced up. The Worker
  // serves it byte-for-byte with Range support; the viewer can't tell it from the Go
  // server. Fixed assets (SPA, unit/rank icons) ship as static assets, not R2.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "barreplay-replays",
      "preview_bucket_name": "barreplay-replays-preview"
    }
  ],

  // The replay catalog (id + when/how-long/map/team-size stats shown by the
  // picker) lives in a single SQLite-backed Durable Object instance; see
  // src/worker/replayindex.ts. `pack -upload` upserts rows via
  // PUT /api/replays/<id>. Optional write auth: `wrangler secret put
  // REPLAY_PUT_TOKEN` (the uploader sends it as a bearer token).
  "durable_objects": {
    "bindings": [
      {
        "name": "REPLAY_INDEX",
        "class_name": "ReplayIndex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReplayIndex"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
