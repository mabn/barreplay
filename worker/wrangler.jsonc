{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replay",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-27",
  // Same Cloudflare account as the sibling claudebar/lavabalance worker.
  "account_id": "9a1829e6502587e153ffa45b76de7ed3",

  // The Vite build (client bundle in dist/client) is served as static assets by the
  // runtime BEFORE the Worker runs. Requests that don't match an asset fall through to
  // the Hono app in src/worker/index.ts. `single-page-application` serves index.html for
  // unmatched non-API navigations so client-side routing works.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // The growing set of replay data (index.json + per-capture head/chunks/resources)
  // lives in this R2 bucket, produced by `barreplay-static` and synced up. The Worker
  // serves it byte-for-byte with Range support; the viewer can't tell it from the Go
  // server. Fixed assets (SPA, unit/rank icons) ship as static assets, not R2.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "barreplay-replays",
      "preview_bucket_name": "barreplay-replays-preview"
    }
  ],

  // The replay catalog (id + when/how-long/map/team-size stats shown by the
  // picker) lives in a single SQLite-backed Durable Object instance; see
  // src/worker/replayindex.ts. `pack -upload` upserts rows via
  // PUT /api/replays/<id>. Optional write auth: `wrangler secret put
  // REPLAY_PUT_TOKEN` (the uploader sends it as a bearer token).
  "durable_objects": {
    "bindings": [
      {
        "name": "REPLAY_INDEX",
        "class_name": "ReplayIndex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReplayIndex"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
