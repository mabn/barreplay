{
  "name": "barreplay-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker hosting the barreplay UI and server (Hono + Vite).",
  "type": "module",
  "scripts": {
    "sync-assets": "node tools/sync-assets.mjs",
    "upload": "tsx tools/upload.ts",
    "test": "npm run test:node && npm run test:do",
    "test:node": "tsx --test tests/*.test.ts",
    "test:do": "vitest run",
    "smoke": "node tools/smoke.mjs",
    "dev": "cf dev",
    "dev:prod": "cf dev --mode proddev",
    "build": "cf build",
    "preview": "vite preview",
    "deploy": "npm test && cf build && npm run smoke && cf deploy --prebuilt",
    "deploy:prodproxy": "cf deploy --mode prodproxy",
    "typecheck": "cf workers types && tsc --noEmit",
    "types": "cf workers types"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@types/node": "^22.15.0",
    "aws4fetch": "^1.0.20",
    "cf": "^1.0.0-rc.2",
    "esbuild": "0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.11"
  }
}
