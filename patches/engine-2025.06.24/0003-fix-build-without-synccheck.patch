From 9de9c73a5501154638f2f6d0bc075680e17a106a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 7 Jul 2026 03:19:39 +0000
Subject: [PATCH] fix building with -DSYNCCHECK=FALSE

Nobody had compiled this configuration in a while:
- add missing <cstdint>/<cassert> includes that SYNCCHECK headers used to
  provide transitively (BuildingMaskMap.h, Serializer.h, UpdateList.cpp,
  AILibraryManager.cpp, creg.cpp)
- give plain float3 the bitExactEquals() SyncedFloat3 has, so call sites
  compile whether or not SYNCCHECK aliases the types
- only FORCE-enable SYNC_HISTORY when SYNCCHECK is on (it neither works
  nor compiles without it)

No behavior change for SYNCCHECK=TRUE builds.
---
 CMakeLists.txt                      | 8 +++++++-
 rts/ExternalAI/AILibraryManager.cpp | 1 +
 rts/Rendering/Common/UpdateList.cpp | 2 ++
 rts/Sim/Misc/BuildingMaskMap.h      | 1 +
 rts/System/creg/Serializer.h        | 1 +
 rts/System/creg/creg.cpp            | 1 +
 rts/System/float3.h                 | 6 ++++++
 7 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a7f7772..793b0a3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -246,7 +246,13 @@ if    (SYNCCHECK)
 endif (SYNCCHECK)
 
 option(SYNC_HISTORY "Save sync history (for semidebug builds)" FALSE)
-set(SYNC_HISTORY ON CACHE BOOL "Force enable save sync history" FORCE)
+# [barreplay] the sync-history ring only makes sense (and only compiles) with
+# SYNCCHECK; keep the upstream force-enable in that case, drop it otherwise.
+if    (SYNCCHECK)
+	set(SYNC_HISTORY ON CACHE BOOL "Force enable save sync history" FORCE)
+else  (SYNCCHECK)
+	set(SYNC_HISTORY OFF CACHE BOOL "Sync history requires SYNCCHECK" FORCE)
+endif (SYNCCHECK)
 if    (SYNC_HISTORY)
 	add_definitions(-DSYNC_HISTORY)
 endif (SYNC_HISTORY)
diff --git a/rts/ExternalAI/AILibraryManager.cpp b/rts/ExternalAI/AILibraryManager.cpp
index 0ed039c..8c4a12e 100644
--- a/rts/ExternalAI/AILibraryManager.cpp
+++ b/rts/ExternalAI/AILibraryManager.cpp
@@ -1,6 +1,7 @@
