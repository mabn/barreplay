index 89351a3..b06b30f 100644
--- a/rts/Sim/Misc/BuildingMaskMap.h
+++ b/rts/Sim/Misc/BuildingMaskMap.h
@@ -3,6 +3,7 @@
 #ifndef BUILDINGMASKMAP_H
 #define BUILDINGMASKMAP_H
 
+#include <cstdint>
 #include <vector>
 
 #include "System/creg/creg_cond.h"
diff --git a/rts/System/creg/Serializer.h b/rts/System/creg/Serializer.h
index 97334f0..e476db1 100644
--- a/rts/System/creg/Serializer.h
+++ b/rts/System/creg/Serializer.h
@@ -8,6 +8,7 @@
 
 #ifdef USING_CREG
 
+#include <cstdint>
 #include <map>
 #include <vector>
 #include <deque>
diff --git a/rts/System/creg/creg.cpp b/rts/System/creg/creg.cpp
index 679bf77..9253774 100644
--- a/rts/System/creg/creg.cpp
+++ b/rts/System/creg/creg.cpp
@@ -7,6 +7,7 @@
 
 #include <vector>
 #include <string>
+#include <cassert>
