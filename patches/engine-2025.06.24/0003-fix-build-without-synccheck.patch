 #include "AILibraryManager.h"
+#include <cassert>
 
 #include "Interface/aidefines.h"
 #include "Interface/SAIInterfaceLibrary.h"
diff --git a/rts/Rendering/Common/UpdateList.cpp b/rts/Rendering/Common/UpdateList.cpp
