diff --git a/rts/System/float3.h b/rts/System/float3.h
index f096c11..af57642 100644
--- a/rts/System/float3.h
+++ b/rts/System/float3.h
@@ -304,6 +304,12 @@ public:
 		return (!equals(f));
 	}
 
+	// For when bit level precision is necessary (same API as SyncedFloat3,
+	// so code compiles whether or not SYNCCHECK aliases the two types).
+	bool bitExactEquals(const float3& f) const {
+		return (x == f.x) && (y == f.y) && (z == f.z);
+	}
+
 
 	/**
 	 * @brief operator[]
