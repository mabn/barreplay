+/***
+ * [barreplay] Every unit's sampled state in one call, for a full-read handle:
+ * what Spring.GetAllUnits + GetUnitTeam / GetUnitPosition / GetUnitDefID /
+ * GetUnitHealth / GetUnitVelocity / GetUnitIsBuilding / GetUnitLosState(id,
+ * allyTeam, true) return under full read, in GetAllUnits' order, as one flat
+ * array: unitID, team, unitDefID, x, z, health, maxHealth, buildProgress,
+ * speed.x, speed.z, buildee unitID (0 = none), then one raw losStatus per
+ * requested ally team (0 for an invalid one). The same float values the
+ * separate calls push, so a widget gets identical numbers for ~1/10 of the
+ * Lua->C calls. Passing a table as arg 2 reuses it.
+ *
+ * @function Spring.GetUnitSampleData
+ * @param allyTeams integer[]
+ * @param reuse table?
+ * @return number[] data, integer count, integer stride
+ */
+int LuaEngineEventLog::GetUnitSampleData(lua_State* L)
+{
+	if (!CLuaHandle::GetHandleFullRead(L))
+		return 0;
+
+	std::vector<int> allyTeams;
+	if (lua_istable(L, 1)) {
+		const int n = lua_objlen(L, 1);
+		for (int i = 1; i <= n; i++) {
+			lua_rawgeti(L, 1, i);
+			allyTeams.push_back(lua_isnumber(L, -1) ? lua_toint(L, -1) : -1);
+			lua_pop(L, 1);
+		}
+	}
+	const int stride = 11 + static_cast<int>(allyTeams.size());
+	const auto& units = unitHandler.GetActiveUnits();
+
+	int prevLen = 0;
+	if (lua_istable(L, 2)) {
+		prevLen = lua_objlen(L, 2);
+		lua_pushvalue(L, 2);
+	} else {
+		lua_createtable(L, units.size() * stride, 0);
+	}
+
+	int k = 0;
+	const auto put = [&](lua_Number v) { lua_pushnumber(L, v); lua_rawseti(L, -2, ++k); };
+	for (const CUnit* u: units) {
+		int buildee = 0;
+		if (const CBuilder* b = dynamic_cast<const CBuilder*>(u); b != nullptr && b->curBuild) {
+			buildee = b->curBuild->id;
+		} else if (const CFactory* f = dynamic_cast<const CFactory*>(u); f != nullptr && f->curBuild) {
+			buildee = f->curBuild->id;
+		}
+		put(u->id);
+		put(u->team);
+		put(u->unitDef->id);
+		put(u->pos.x);
+		put(u->pos.z);
+		put(u->health);
+		put(u->maxHealth);
+		put(u->buildProgress);
+		put(u->speed.x);
+		put(u->speed.z);
+		put(buildee);
+		for (const int at: allyTeams)
+			put(teamHandler.IsValidAllyTeam(at) ? u->losStatus[at] : 0);
+	}
+	for (int i = k + 1; i <= prevLen; i++) {
+		lua_pushnil(L);
+		lua_rawseti(L, -2, i);
+	}
+	lua_pushnumber(L, units.size());
+	lua_pushnumber(L, stride);
+	return 3;
+}
