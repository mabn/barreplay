+/***
+ * [barreplay] Drains the weapon reload-frame changes recorded since the
+ * previous call (third flag of SetEngineEventLog): every write of a weapon's
+ * reloadStatus, in the order the simulation made them.
+ *
+ * @function Spring.GetLoggedReloads
+ * @param fill table? reused for the result
+ * @return number[]? values flat, 3 per change: unitID, weaponNum (0-based), reloadFrame
+ * @return integer count
+ */
+int LuaEngineEventLog::GetLoggedReloads(lua_State* L)
+{
+	if (!CLuaHandle::GetHandleFullRead(L))
+		return 0;
+	int prevLen = 0;
+	if (lua_istable(L, 1)) {
+		prevLen = lua_objlen(L, 1);
+		lua_pushvalue(L, 1);
+	} else {
+		lua_createtable(L, g_brReloadLog.size(), 0);
+	}
+	const int n = static_cast<int>(g_brReloadLog.size());
+	for (int i = 0; i < n; i++) {
+		lua_pushnumber(L, g_brReloadLog[i]);
+		lua_rawseti(L, -2, i + 1);
+	}
+	for (int i = n + 1; i <= prevLen; i++) {
+		lua_pushnil(L);
+		lua_rawseti(L, -2, i);
+	}
+	lua_pushnumber(L, n / 3);
+	g_brReloadLog.clear();
+	return 2;
+}
+
 /***
  * [barreplay] Drains the explosions recorded since the previous call.
  *
@@ -269,3 +319,77 @@ int LuaEngineEventLog::GetLoggedDamage(lua_State* L)
 {
