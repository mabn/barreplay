diff --git a/rts/Sim/Weapons/Weapon.h b/rts/Sim/Weapons/Weapon.h
index b350a6e..0908112 100644
--- a/rts/Sim/Weapons/Weapon.h
+++ b/rts/Sim/Weapons/Weapon.h
@@ -24,6 +24,14 @@ struct WeaponVectorsState {
 	float3 weaponDir;
 };
 
+// [barreplay] W3: every change of a weapon's reloadStatus, as (unitID,
+// weaponNum, value) triples, while switched on (Spring.SetEngineEventLog's
+// third flag). Lets a full-read widget follow reload frames without polling
+// every weapon every frame. Off: one predictable branch per write.
+extern bool g_brReloadLogOn;
+extern std::vector<int> g_brReloadLog;
+#define BR_RELOAD_CHANGED(w) do { if (g_brReloadLogOn) { g_brReloadLog.push_back((w)->owner->id); g_brReloadLog.push_back((w)->weaponNum); g_brReloadLog.push_back((w)->reloadStatus); } } while (0)
+
 class CWeapon : public CObject
 {
 	CR_DECLARE_DERIVED(CWeapon)
