@@ -370,6 +370,19 @@ static inline void LuaPushString(lua_State* L, const string& str) {
 	lua_pushsstring(L, str);
 } 
 
+// [barreplay] P4 (Sim/Weapons/BrPipeTarget.h): the Lua functions that write
+// simulation state, or read weapon targets, are entered through this
+// trampoline, which first finishes and applies the slow-update loop's
+// pipelined target searches; Lua that only reads cannot see them running
+int BrLuaDrainingCall(lua_State* L);
+static inline void BrPushDrainingRawNamedCFunc(lua_State* L, const char* key, lua_CFunction func)
+{
+	lua_pushstring(L, key);
+	lua_pushlightuserdata(L, reinterpret_cast<void*>(func));
+	lua_pushcclosure(L, BrLuaDrainingCall, 1);
+	lua_rawset(L, -3);
+}
+
 #define REGISTER_LUA_CFUNC(func)                LuaPushRawNamedCFunc(L, #func,        func)
 #define REGISTER_NAMED_LUA_CFUNC(name, func)    LuaPushRawNamedCFunc(L,  name,        func)
 #define REGISTER_SCOPED_LUA_CFUNC(scope, func)  LuaPushRawNamedCFunc(L, #func, scope::func)
