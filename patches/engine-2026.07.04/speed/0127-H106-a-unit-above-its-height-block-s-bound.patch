From f8e31b5d72ef0a0db02f8f6f706c70b6db9d25b1 Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Tue, 20 Oct 2026 04:46:31 +0000
Subject: [PATCH] [barreplay] H106: a unit above its height block's bound takes
 its physical state from the bound, skipping the corner lookup (toggle2
 0x10000000)

Per 32x32-square block, an upper bound of the synced corner heights, raised
by every synced write (never lowered, so it stays a bound). Above it (and
with mid-height plus radius above it), ground contact and underground are
false whatever the real height, and in-air is decided by the bound or the
water, so the state bits are the same. GetHeightReal was half of
CUnit::Update's own time (2.3% of the main thread), mostly aircraft.
---
 rts/Map/ReadMap.cpp           | 42 +++++++++++++++++++++++++++++++++++
 rts/Map/ReadMap.h             | 14 +++++++++++-
 rts/Sim/Units/Unit.cpp        | 38 +++++++++++++++++++++++++------
 rts/Sim/Units/UnitHandler.cpp |  5 +++++
 4 files changed, 91 insertions(+), 8 deletions(-)

diff --git a/rts/Map/ReadMap.cpp b/rts/Map/ReadMap.cpp
index 13d3edd..fae55a2 100644
--- a/rts/Map/ReadMap.cpp
+++ b/rts/Map/ReadMap.cpp
@@ -6,6 +6,8 @@
 
 #include "xsimd/xsimd.hpp"
 #include "ReadMap.h"
+#include <limits>
+#include <algorithm>
 #include "Sim/MoveTypes/Systems/BrParallelAir.h"
 #include "Game/GameVersion.h"
 #include "Game/GameSetup.h"
@@ -113,6 +115,46 @@ CR_REG_METADATA(CReadMap, (
 CReadMap* readMap = nullptr;
 unsigned g_brHeightMapVersion = 0;
 
+// [barreplay] H106 (Map/ReadMap.h)
+std::vector<float> g_brHeightBlockMax;
+int g_brHeightBlocksX = 0;
+
+void BrBuildHeightBlocks()
+{
+	const float* hm = readMap->GetCornerHeightMapSynced();
+	const int cx = mapDims.mapxp1, cz = mapDims.mapyp1;
+	const int nbx = (mapDims.mapx + BR_HBLOCK - 1) / BR_HBLOCK;
+	const int nbz = (mapDims.mapy + BR_HBLOCK - 1) / BR_HBLOCK;
+	std::vector<float> m(size_t(nbx) * nbz, std::numeric_limits<float>::lowest());
+	for (int z = 0; z < cz; ++z) {
+		for (int x = 0; x < cx; ++x) {
+			const float h = hm[z * cx + x];
+			// a corner on a block edge belongs to both blocks' ranges
+			const int bx1 = std::min(x / BR_HBLOCK, nbx - 1), bz1 = std::min(z / BR_HBLOCK, nbz - 1);
+			const int bx0 = (x % BR_HBLOCK == 0 && x > 0)? std::min(x / BR_HBLOCK - 1, nbx - 1): bx1;
+			const int bz0 = (z % BR_HBLOCK == 0 && z > 0)? std::min(z / BR_HBLOCK - 1, nbz - 1): bz1;
+			for (int bz = bz0; bz <= bz1; ++bz)
+				for (int bx = bx0; bx <= bx1; ++bx)
+					m[bz * nbx + bx] = std::max(m[bz * nbx + bx], h);
+		}
+	}
+	g_brHeightBlocksX = nbx;
+	g_brHeightBlockMax.swap(m);
+}
+
+void BrRaiseHeightBlocks(int idx, float h)
+{
+	const int cx = mapDims.mapxp1;
+	const int x = idx % cx, z = idx / cx;
+	const int nbx = g_brHeightBlocksX, nbz = int(g_brHeightBlockMax.size()) / nbx;
+	const int bx1 = std::min(x / BR_HBLOCK, nbx - 1), bz1 = std::min(z / BR_HBLOCK, nbz - 1);
+	const int bx0 = (x % BR_HBLOCK == 0 && x > 0)? std::min(x / BR_HBLOCK - 1, nbx - 1): bx1;
+	const int bz0 = (z % BR_HBLOCK == 0 && z > 0)? std::min(z / BR_HBLOCK - 1, nbz - 1): bz1;
+	for (int bz = bz0; bz <= bz1; ++bz)
+		for (int bx = bx0; bx <= bx1; ++bx)
+			g_brHeightBlockMax[bz * nbx + bx] = std::max(g_brHeightBlockMax[bz * nbx + bx], h);
+}
+
 MapDimensions mapDims;
 
 std::vector<float> CReadMap::mapFileHeightMap;
diff --git a/rts/Map/ReadMap.h b/rts/Map/ReadMap.h
index 8ceac76..a6f5820 100644
--- a/rts/Map/ReadMap.h
+++ b/rts/Map/ReadMap.h
@@ -17,6 +17,15 @@
 
 // [barreplay] H88: bumped by every synced corner-height write (CReadMap::SetHeight)
 extern unsigned g_brHeightMapVersion;
+// [barreplay] H106: an upper bound of the synced corner heights per block of
+// BR_HBLOCK x BR_HBLOCK squares (a block's corner range includes its far edge),
+// raised by every synced write and never lowered, so it stays a true bound.
+// Empty until BrBuildHeightBlocks() (main thread) has run.
+constexpr int BR_HBLOCK = 32;
+extern std::vector<float> g_brHeightBlockMax;
+extern int g_brHeightBlocksX;
+void BrBuildHeightBlocks();
+void BrRaiseHeightBlocks(int idx, float h);
 
 #define USE_HEIGHTMAP_DIGESTS
 
@@ -321,7 +330,10 @@ extern MapDimensions mapDims;
 inline float CReadMap::AddHeight(const int idx, const float a) { return SetHeight(idx, a, 1); }
 inline float CReadMap::SetHeight(const int idx, const float h, const int add) {
 	++g_brHeightMapVersion; // [barreplay] H88: every synced corner-height write
-	return SetHeightValue((*heightMapSyncedPtr)[idx], idx, h, add);
+	const float nh = SetHeightValue((*heightMapSyncedPtr)[idx], idx, h, add);
+	if (!g_brHeightBlockMax.empty())
+		BrRaiseHeightBlocks(idx, nh); // [barreplay] H106
+	return nh;
 }
 
 inline float CReadMap::AddOriginalHeight(const int idx, const float a) { return SetOriginalHeight(idx, a, 1); }
diff --git a/rts/Sim/Units/Unit.cpp b/rts/Sim/Units/Unit.cpp
index 2fed5ab..96ead18 100644
--- a/rts/Sim/Units/Unit.cpp
+++ b/rts/Sim/Units/Unit.cpp
@@ -1975,14 +1975,38 @@ void CUnit::UpdatePhysicalState(float eps)
 	// x and z are compared bit for bit, so it is the very same GetHeightReal
 	// argument.
 	if ((g_brToggles & 0x100000) != 0) {
-		if (pos.x != brPhysX || pos.z != brPhysZ || g_brHeightMapVersion != brPhysHmv || !brPhysValid) {
-			brPhysX = pos.x;
-			brPhysZ = pos.z;
-			brPhysHmv = g_brHeightMapVersion;
-			brPhysGround = CGround::GetHeightReal(pos.x, pos.z);
-			brPhysValid = true;
+		// [barreplay] H106 (toggle2 0x10000000): a unit above its block's height
+		// bound (Map/ReadMap.h), with its mid-height plus radius above it too,
+		// gets the same state bits from the bound as from the ground height under
+		// it (ground contact and underground are false either way, and in-air
+		// holds whichever of bound and water is higher), so the corner lookup is
+		// skipped. The bound is a block maximum plus 1 elmo, far above the
+		// interpolation's rounding.
+		bool brAbove = false;
+		float brBound = 0.0f;
+		if ((g_brToggles2 & 0x10000000) != 0 && !g_brHeightBlockMax.empty()
+			&& !(pos.x == brPhysX && pos.z == brPhysZ && g_brHeightMapVersion == brPhysHmv && brPhysValid)) {
+			const int ix = int(std::clamp(pos.x, 0.0f, float3::maxxpos) / SQUARE_SIZE);
+			const int iz = int(std::clamp(pos.z, 0.0f, float3::maxzpos) / SQUARE_SIZE);
+			const int nbx = g_brHeightBlocksX;
+			const int bx = std::min(ix / BR_HBLOCK, nbx - 1);
+			const int bz = std::min(iz / BR_HBLOCK, int(g_brHeightBlockMax.size()) / nbx - 1);
+			brBound = g_brHeightBlockMax[bz * nbx + bx] + 1.0f;
+			brAbove = ((pos.y - brBound) > eps && (midPos.y + radius) >= brBound);
+		}
+		if (brAbove) {
+			CSolidObject::UpdatePhysicalStateAt(eps, brBound);
+			brPhysValid = false;
+		} else {
+			if (pos.x != brPhysX || pos.z != brPhysZ || g_brHeightMapVersion != brPhysHmv || !brPhysValid) {
+				brPhysX = pos.x;
+				brPhysZ = pos.z;
+				brPhysHmv = g_brHeightMapVersion;
+				brPhysGround = CGround::GetHeightReal(pos.x, pos.z);
+				brPhysValid = true;
+			}
+			CSolidObject::UpdatePhysicalStateAt(eps, brPhysGround);
 		}
-		CSolidObject::UpdatePhysicalStateAt(eps, brPhysGround);
 	} else {
 		CSolidObject::UpdatePhysicalState(eps);
 	}
diff --git a/rts/Sim/Units/UnitHandler.cpp b/rts/Sim/Units/UnitHandler.cpp
index 3312709..93a6534 100644
--- a/rts/Sim/Units/UnitHandler.cpp
+++ b/rts/Sim/Units/UnitHandler.cpp
@@ -4,6 +4,7 @@
 
 #include "UnitHandler.h"
 #include "BrWeaponVectors.h"
+#include "Map/ReadMap.h"
 #include <algorithm>
 #include <unordered_map>
 #include <cstring>
@@ -631,6 +632,10 @@ void CUnitHandler::UpdateUnits()
 {
 	SCOPED_TIMER("Sim::Unit::Update");
 
+	// [barreplay] H106: the height-block bounds, built once on the main thread
+	if ((g_brToggles2 & 0x10000000) != 0 && g_brHeightBlockMax.empty())
+		BrBuildHeightBlocks();
+
 	size_t activeUnitCount = activeUnits.size();
 
 	// [barreplay] H101 (toggle2 0x4000): CUnit::Update changes only its own
