From be764ffcf6281e048cd7776b5023351b3601b5a2 Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Wed, 21 Oct 2026 02:15:26 +0000
Subject: [PATCH 157/160] [barreplay] N3: N2 for UnitCreated, UnitDestroyed and
 UnitCommand (toggle3 0x1000000)

luaprof63: BAR's gadget handler's own code in these three callins (the
loops, the tracy stub calls, markIdle's call) is ~0.8% of the main thread,
the installed wrapper around every callin another 0.16%. N3 replaces wrapper
and handler with the C dispatcher as N2 does, when their bytecode hashes are
on the list: the handlers' upvalues are checked by name and order (the tracy
ones the stubs), self:MetaUnitAdded/MetaUnitRemoved called before the list is
read, the list walked with the same table reads, UnitCommand's
_unitCommandIDs filter and 'cmdId < 0 and cmdIDs[CMD_BUILD]' read through the
same gets and lua_lessthan, markIdle called through its upvalue after the
loop. The three handler hashes are not listed yet: until they are learned
from a run (the infolog's 'N2 <callin>: wrapper .. handler ..' line) and read
against the source, BARREPLAY_N2_HASHES enables them, and without it the Lua
runs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rts/Lua/BrNativeHandler.cpp | 201 +++++++++++++++++++++++++++++++++++-
 rts/Lua/BrNativeHandler.h   |   8 +-
 rts/Lua/LuaHandle.cpp       |   3 +
 3 files changed, 207 insertions(+), 5 deletions(-)

diff --git a/rts/Lua/BrNativeHandler.cpp b/rts/Lua/BrNativeHandler.cpp
index 3e39f37..9ef193e 100644
--- a/rts/Lua/BrNativeHandler.cpp
+++ b/rts/Lua/BrNativeHandler.cpp
@@ -15,10 +15,19 @@
 
 namespace BrN2 {
 	namespace {
-		const char* const CALLIN_NAMES[CI_N] = {"UnitPreDamaged", "UnitDamaged", "Explosion", "ProjectileDestroyed"};
-		const char* const LIST_NAMES[CI_N] = {"UnitPreDamagedList", "UnitDamagedList", "ExplosionList", "ProjectileDestroyedList"};
+		const char* const CALLIN_NAMES[CI_N] = {"UnitPreDamaged", "UnitDamaged", "Explosion", "ProjectileDestroyed", "UnitCreated", "UnitDestroyed", "UnitCommand"};
+		const char* const LIST_NAMES[CI_N] = {"UnitPreDamagedList", "UnitDamagedList", "ExplosionList", "ProjectileDestroyedList", "UnitCreatedList", "UnitDestroyedList", "UnitCommandList"};
 		// the handler functions' upvalues: the tracy stubs, or none
-		const bool HANDLER_TRACY[CI_N] = {true, true, false, true};
+		const bool HANDLER_TRACY[CI_N] = {true, true, false, true, false, false, false};
+		// [barreplay] N3: the handlers whose upvalues are checked by name, in
+		// order (the hash pins the order too): the tracy ones must be the stubs,
+		// the others are read when the Lua would read them
+		const char* const* const HANDLER_UPVALUES[CI_N] = {
+			nullptr, nullptr, nullptr, nullptr,
+			(const char* const[]) {"tracyZoneBeginN", "tracyZoneEnd", nullptr},
+			(const char* const[]) {"tracyZoneBeginN", "markIdle", "tracyZoneEnd", nullptr},
+			(const char* const[]) {"tracyZoneBeginN", "CMD_BUILD", "markIdle", "tracyZoneEnd", nullptr},
+		};
 
 		// the bytecode hashes of the code this replicates, each read against
 		// the source: BAR test-31620's luarules/gadgets.lua (the installed
@@ -42,6 +51,7 @@ namespace BrN2 {
 			int nativeRef = LUA_NOREF;
 			bool ok = false;
 			int uvDepth = 0, uvSelf = 0, uvReorder = 0;
+			int uvFunc = 0, uvMarkIdle = 0, uvCmdBuild = 0; // [barreplay] N3: the handler's, by index
 		};
 		struct State {
 			lua_State* L = nullptr;
@@ -223,7 +233,36 @@ namespace BrN2 {
 				if (h == nullptr)
 					break;
 				hh = ProtoHash(h->p);
-				if (HANDLER_TRACY[ci]) {
+				e.uvFunc = uvFunc;
+				if (HANDLER_UPVALUES[ci] != nullptr) {
+					// [barreplay] N3: every upvalue by name; the tracy ones the stubs
+					const int hi = lua_gettop(L);
+					const lua_CFunction noop = TracyNoop(L);
+					int n = 0;
+					bool good = true;
+					for (; HANDLER_UPVALUES[ci][n] != nullptr; ++n) {
+						const char* want = HANDLER_UPVALUES[ci][n];
+						const char* name = lua_getupvalue(L, hi, n + 1);
+						if (name == nullptr || strcmp(name, want) != 0) {
+							good = false;
+							if (name != nullptr)
+								lua_pop(L, 1);
+							break;
+						}
+						if (strncmp(want, "tracy", 5) == 0) {
+							const LClosure* t = LuaClosureAt(L, -1);
+							const bool isNoop = (noop != nullptr && lua_iscfunction(L, -1) && lua_tocfunction(L, -1) == noop);
+							good = good && ((t != nullptr && IsEmptyStub(t)) || isNoop);
+						} else if (strcmp(want, "markIdle") == 0) {
+							e.uvMarkIdle = n + 1;
+						} else if (strcmp(want, "CMD_BUILD") == 0) {
+							e.uvCmdBuild = n + 1;
+						}
+						lua_pop(L, 1);
+					}
+					if (!good || h->nupvalues != n)
+						break;
+				} else if (HANDLER_TRACY[ci]) {
 					if (h->nupvalues != 2)
 						break;
 					// the tracy upvalues: BAR's empty Lua stubs (no engine
@@ -410,6 +449,145 @@ namespace BrN2 {
 			lua_pushnil(L);
 		}
 
+		// [barreplay] N3: `local i, g = 1, list[1]; while g do g:<key>(a1..an);
+		// i = i + 1; g = list[i] end`, with no results
+		void GadgetLoop(lua_State* L, int nargs, int list, int key, int nparams) {
+			for (lua_Number i = 1; ; i = i + 1) {
+				lua_pushnumber(L, i);
+				lua_gettable(L, list);
+				if (!lua_toboolean(L, -1)) {
+					lua_pop(L, 1);
+					break;
+				}
+				const int g = lua_gettop(L);
+				lua_pushvalue(L, key);
+				lua_gettable(L, g);
+				lua_pushvalue(L, g);
+				for (int a = 1; a <= nparams; ++a) {
+					if (a <= nargs)
+						lua_pushvalue(L, a);
+					else
+						lua_pushnil(L);
+				}
+				lua_call(L, 1 + nparams, 0);
+				lua_settop(L, g - 1);
+			}
+		}
+
+		// self:<method>(a1, a2, a3): OP_SELF's table read, then the call
+		void SelfCall3(lua_State* L, int self, int nargs, const char* method) {
+			lua_pushstring(L, method);
+			lua_gettable(L, self);
+			lua_pushvalue(L, self);
+			for (int a = 1; a <= 3; ++a) {
+				if (a <= nargs)
+					lua_pushvalue(L, a);
+				else
+					lua_pushnil(L);
+			}
+			lua_call(L, 4, 0);
+		}
+
+		// the handler closure's upvalue <uv> (the wrapper's selffunc)
+		void PushHandlerUpvalue(lua_State* L, const Entry& e, int inst, int uv) {
+			lua_getupvalue(L, inst, e.uvFunc);
+			lua_getupvalue(L, -1, uv);
+			lua_remove(L, -2);
+		}
+
+		// markIdle(unitID)
+		void MarkIdle(lua_State* L, const Entry& e, int inst, int nargs) {
+			PushHandlerUpvalue(L, e, inst, e.uvMarkIdle);
+			if (nargs >= 1) lua_pushvalue(L, 1); else lua_pushnil(L);
+			lua_call(L, 1, 0);
+		}
+
+		// gadgetHandler:UnitCreated(unitID, unitDefID, unitTeam, builderID)
+		void HandlerUnitCreated(lua_State* L, int nargs, int self, int key) {
+			SelfCall3(L, self, nargs, "MetaUnitAdded");
+			lua_getfield(L, self, "UnitCreatedList");
+			GadgetLoop(L, nargs, lua_gettop(L), key, 4);
+			lua_pop(L, 1);
+			lua_pushnil(L);
+			lua_pushnil(L);
+		}
+
+		// gadgetHandler:UnitDestroyed(unitID, unitDefID, unitTeam, attackerID, attackerDefID, attackerTeam, weaponDefID)
+		void HandlerUnitDestroyed(lua_State* L, const Entry& e, int inst, int nargs, int self, int key) {
+			SelfCall3(L, self, nargs, "MetaUnitRemoved");
+			lua_getfield(L, self, "UnitDestroyedList");
+			GadgetLoop(L, nargs, lua_gettop(L), key, 7);
+			lua_pop(L, 1);
+			MarkIdle(L, e, inst, nargs);
+			lua_pushnil(L);
+			lua_pushnil(L);
+		}
+
+		// gadgetHandler:UnitCommand(unitID, unitDefID, unitTeam, cmdId, cmdParams, cmdOpts, cmdTag, playerID, fromSynced, fromLua):
+		// for i = 1, #list do local g = list[i]; local cmdIDs = g._unitCommandIDs
+		//   if not cmdIDs or cmdIDs[cmdId] or (cmdId < 0 and cmdIDs[CMD_BUILD]) then g:UnitCommand(...) end end
+		// markIdle(unitID)
+		void HandlerUnitCommand(lua_State* L, State& st, const Entry& e, int inst, int nargs, int self, int key) {
+			lua_getfield(L, self, "UnitCommandList");
+			const int list = lua_gettop(L);
+			lua_Number n;
+			if (lua_istable(L, list)) {
+				n = lua_Number(lua_objlen(L, list)); // OP_LEN on a table: luaH_getn
+			} else {
+				if (st.lenRef == LUA_NOREF) {
+					luaL_loadstring(L, "local t = ... return #t");
+					st.lenRef = luaL_ref(L, LUA_REGISTRYINDEX);
+				}
+				lua_rawgeti(L, LUA_REGISTRYINDEX, st.lenRef);
+				lua_pushvalue(L, list);
+				lua_call(L, 1, 1);
+				n = lua_tonumber(L, -1);
+				lua_pop(L, 1);
+			}
+			if (nargs >= 4) lua_pushvalue(L, 4); else lua_pushnil(L);
+			const int cmdId = lua_gettop(L);
+			lua_pushnumber(L, 0.0f);
+			const int zero = lua_gettop(L);
+			for (lua_Number i = 1; i <= n; i = i + 1) {
+				lua_pushnumber(L, i);
+				lua_gettable(L, list);
+				const int g = lua_gettop(L);
+				lua_pushstring(L, "_unitCommandIDs");
+				lua_gettable(L, g);
+				const int ids = lua_gettop(L);
+				bool call = !lua_toboolean(L, ids);
+				if (!call) {
+					lua_pushvalue(L, cmdId);
+					lua_gettable(L, ids);
+					call = lua_toboolean(L, -1);
+					lua_pop(L, 1);
+				}
+				if (!call && lua_lessthan(L, cmdId, zero)) {
+					PushHandlerUpvalue(L, e, inst, e.uvCmdBuild);
+					lua_gettable(L, ids);
+					call = lua_toboolean(L, -1);
+					lua_pop(L, 1);
+				}
+				if (call) {
+					lua_pushvalue(L, key);
+					lua_gettable(L, g);
+					lua_pushvalue(L, g);
+					for (int a = 1; a <= 10; ++a) {
+						if (a <= nargs)
+							lua_pushvalue(L, a);
+						else
+							lua_pushnil(L);
+					}
+					lua_call(L, 11, 0);
+				}
+				lua_settop(L, g - 1);
+			}
+			lua_settop(L, list - 1);
+			MarkIdle(L, e, inst, nargs);
+			lua_pushnil(L);
+			lua_pushnil(L);
+		}
+
 		// the installed wrapper: upvalue 1 the wrapper closure, 2 the Entry, 3
 		// the State, 4 the callin index, 5 the method key ("UnitPreDamaged")
 		int Dispatch(lua_State* L) {
@@ -430,6 +608,18 @@ namespace BrN2 {
 			// (its tracy stubs do nothing; the handler reads self.<X>List first)
 			lua_getupvalue(L, inst, e.uvSelf);
 			const int self = lua_gettop(L);
+			if (ci >= CI_UnitCreated) {
+				// [barreplay] N3: these handlers read their list themselves, after
+				// the Meta call; UnitCommand's loop holds up to 20 values beyond
+				// the arguments (a C function is promised LUA_MINSTACK = 20)
+				luaL_checkstack(L, 32, "N3");
+				switch (ci) {
+					case CI_UnitCreated:   { HandlerUnitCreated(L, nargs, self, key); } break;
+					case CI_UnitDestroyed: { HandlerUnitDestroyed(L, e, inst, nargs, self, key); } break;
+					case CI_UnitCommand:   { HandlerUnitCommand(L, st, e, inst, nargs, self, key); } break;
+					default: { lua_pushnil(L); lua_pushnil(L); } break;
+				}
+			} else {
 			lua_getfield(L, self, LIST_NAMES[ci]);
 			const int list = lua_gettop(L);
 
@@ -440,6 +630,7 @@ namespace BrN2 {
 				case CI_ProjectileDestroyed: { HandlerDamaged(L, nargs, list, key, 3); } break;
 				default: { lua_pushnil(L); lua_pushnil(L); } break;
 			}
+			}
 			const int res = lua_gettop(L) - 1;
 
 			// callinDepth = callinDepth - 1
@@ -475,6 +666,8 @@ namespace BrN2 {
 	{
 		if ((g_brToggles2 & 1) == 0)
 			return;
+		if (ci >= CI_UnitCreated && (g_brToggles3 & 0x1000000) == 0)
+			return; // [barreplay] N3
 		if (!inited)
 			Init();
 
diff --git a/rts/Lua/BrNativeHandler.h b/rts/Lua/BrNativeHandler.h
index ff427b4..1bc4ab9 100644
--- a/rts/Lua/BrNativeHandler.h
+++ b/rts/Lua/BrNativeHandler.h
@@ -22,7 +22,13 @@
 struct lua_State;
 
 namespace BrN2 {
-	enum Callin { CI_UnitPreDamaged, CI_UnitDamaged, CI_Explosion, CI_ProjectileDestroyed, CI_N };
+	// [barreplay] N3 (toggle3 0x1000000, with N2's toggle): UnitCreated,
+	// UnitDestroyed and UnitCommand the same way. Their handlers also call
+	// self:MetaUnitAdded/MetaUnitRemoved before reading the gadget list, and
+	// the upvalue markIdle after the loop (UnitCommand also filters by each
+	// gadget's _unitCommandIDs and the upvalue CMD_BUILD); those are read and
+	// called at the same points, through the same table reads and calls.
+	enum Callin { CI_UnitPreDamaged, CI_UnitDamaged, CI_Explosion, CI_ProjectileDestroyed, CI_UnitCreated, CI_UnitDestroyed, CI_UnitCommand, CI_N };
 
 	// the stack top is the global the engine fetched for the callin: replace
 	// it with the native dispatcher when it is BAR's wrapper over the handler
diff --git a/rts/Lua/LuaHandle.cpp b/rts/Lua/LuaHandle.cpp
index 82b3beb..f53da72 100644
--- a/rts/Lua/LuaHandle.cpp
+++ b/rts/Lua/LuaHandle.cpp
@@ -1103,6 +1103,7 @@ void CLuaHandle::UnitCreated(const CUnit* unit, const CUnit* builder)
 	static const LuaHashString cmdStr(__func__);
 	if (!cmdStr.GetGlobalFunc(L))
 		return;
+	BrN2::Substitute(L, BrN2::CI_UnitCreated); // [barreplay] N3
 
 	lua_pushnumber(L, unit->id);
 	lua_pushnumber(L, unit->unitDef->id);
@@ -1233,6 +1234,7 @@ void CLuaHandle::UnitDestroyed(const CUnit* unit, const CUnit* attacker, int wea
 
 	if (!cmdStr.GetGlobalFunc(L))
 		return;
+	BrN2::Substitute(L, BrN2::CI_UnitDestroyed); // [barreplay] N3
 
 	static constexpr int argCount = 3 + 3 + 1;
 
@@ -1343,6 +1345,7 @@ void CLuaHandle::UnitCommand(const CUnit* unit, const Command& command, int play
 	static const LuaHashString cmdStr(__func__);
 	if (!cmdStr.GetGlobalFunc(L))
 		return;
+	BrN2::Substitute(L, BrN2::CI_UnitCommand); // [barreplay] N3
 
 	const int argc = LuaUtils::PushUnitAndCommand(L, unit, command);
 
