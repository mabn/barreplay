 	static int GetLoggedExplosions(lua_State* L);
 	static int GetLoggedDamage(lua_State* L);
 	static int GetUnitSampleData(lua_State* L);
+	static int GetUnitSampleDelta(lua_State* L);
 	static int GetLoggedReloads(lua_State* L);
 };
 
