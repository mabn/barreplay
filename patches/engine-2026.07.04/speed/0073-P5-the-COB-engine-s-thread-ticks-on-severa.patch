+	// (the queue is ordered by (wake time, id), so push order does not matter;
+	// a thread scheduled to RUN only comes from START, at a serial point)
+	if (BrP5::deferring && thread->GetState() == CCobThread::Sleep) {
+		BrP5::DeferSleep(thread->GetID(), thread->GetWakeTime());
