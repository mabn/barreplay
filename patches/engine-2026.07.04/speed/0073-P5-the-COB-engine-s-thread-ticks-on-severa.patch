index 0000000..5f4b943
--- /dev/null
+++ b/rts/Sim/Units/Scripts/BrCobPar.h
@@ -0,0 +1,61 @@
+/* This file is part of the Spring engine (GPL v2 or later), see LICENSE.html */
+
+#ifndef BR_COB_PAR_H
+#define BR_COB_PAR_H
+
+// [barreplay] P5 (toggle 0x10000000): the COB engine's thread ticks on several
+// threads with EXACTLY the sequential result.
+//
+// A frame's ticks run in a known order (the running list, then the sleepers
+// due, which pop in (wake time, id) order whatever runs in between). Most
+// ticks touch nothing but their own unit: its script state, its pieces and
+// animations, and reads. A tick runs on a worker when every function its
+// thread can be executing (its call stack and everything those call) uses
+// only such operations, decided once per function from the bytecode
+// (FunctionSafe). Those ticks form segments between the others, which run
+// alone on the main thread, in order, exactly as before. Within a segment:
+//   - ticks start in order, and a unit's ticks keep their order;
+//   - RAND and START are serial points: the tick waits until every earlier
+//     tick has finished, then draws or starts in place (both are ordered
+//     global state: the synced RNG, the thread id counter);
+//   - the global bookkeeping a tick does (a sleep scheduled, a thread ended,
+//     a kill signalled, an instance entering or leaving the animation list)
+//     goes into the tick's buffer, applied in tick order when the segment
+//     ends. Nothing in a segment reads those structures, and the sleep queue
+//     is ordered by (wake time, id), so its pushes commute anyway.
+
+#include <vector>
+
+class CCobEngine;
+class CCobThread;
+class CCobFile;
+class CUnitScript;
+
+extern unsigned g_brToggles;
+
+namespace BrP5 {
+	// this thread is running a tick inside a segment
+	extern thread_local bool deferring;
+
+	inline bool Enabled() { return ((g_brToggles & 0x10000000) != 0); }
+
+	// the bookkeeping, buffered while deferring
+	void DeferSleep(int threadID, int wakeTime);
+	void DeferRemoveThread(int threadID);
+	void DeferQueueRemove(int threadID);
+	void DeferAnimating(CUnitScript* script, bool add);
+
+	// RAND and START inside a segment: wait for every earlier tick
+	void SerialPoint();
+
+	// every function a thread may run from here is worker-safe
+	bool FunctionSafe(const CCobFile* file, int functionId);
+
+	// one phase of the COB engine's tick: <ids> in order; sleepers = the
+	// thread is woken first (state Sleep -> Run), or removed if dead
+	void RunPhase(CCobEngine* engine, const std::vector<int>& ids, bool sleepers);
+	// the COB engine's tick is over: the workers go back to the pool
+	void EndTick();
+}
+
+#endif
