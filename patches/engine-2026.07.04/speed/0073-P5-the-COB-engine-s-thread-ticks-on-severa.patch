+		// [barreplay] P5: the same two loops, on several threads (BrCobPar.h)
+		BrP5::RunPhase(this, runningThreadIDs, false);
+		runningThreadIDs.clear();
+		std::swap(runningThreadIDs, waitingThreadIDs);
+		ProcessQueuedThreads();
