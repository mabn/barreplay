+			if (zzzThread == nullptr) {
+				sleepingThreadIDs.pop();
+				continue;
+			}
+			if (zzzThread->GetWakeTime() >= currentTime)
+				break;
+
+			brDueThreadIDs.push_back(sleepingThreadIDs.top().id);
+			sleepingThreadIDs.pop();
+		}
+		BrP5::RunPhase(this, brDueThreadIDs, true);
+		ProcessQueuedThreads();
+		BrP5::EndTick();
+		return;
+	}
+
 	TickRunningThreads();
 	ProcessQueuedThreads();
 
