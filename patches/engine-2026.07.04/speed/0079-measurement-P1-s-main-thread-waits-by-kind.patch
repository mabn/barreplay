diff --git a/rts/Sim/MoveTypes/Systems/GeneralMoveSystem.cpp b/rts/Sim/MoveTypes/Systems/GeneralMoveSystem.cpp
index a11e983..4d803ee 100644
--- a/rts/Sim/MoveTypes/Systems/GeneralMoveSystem.cpp
+++ b/rts/Sim/MoveTypes/Systems/GeneralMoveSystem.cpp
@@ -5,6 +5,7 @@
 #include "GeneralMoveSystem.h"
 
 #include <vector>
+#include <x86intrin.h>
 
 #include "Sim/Ecs/Registry.h"
 #include "Sim/MoveTypes/Components/MoveTypesComponents.h"
@@ -95,10 +96,32 @@ namespace BrParAir {
 	static std::atomic<int> claim{0}, frontier{0}, nextStart{0}, handoff{-1};
 	static std::atomic<unsigned> serialRuns{0};
 
+	// [barreplay] measurement: the main thread's waits by kind (cycles, count),
+	// and the serial items by (hover, aircraft state, zero speed)
+	enum { MW_START, MW_PRED, MW_SERIAL, MW_FINAL, MW_POINT, MW_N };
+	static unsigned long long mainWaitCyc[MW_N] = {}, mainWaitN[MW_N] = {};
+	static std::atomic<long long> serialHist[2][8][2];
+	static thread_local bool brIsMain = false;
+	struct MainWait {
+		int kind; unsigned long long t0;
+		explicit MainWait(int k): kind(k), t0(brIsMain? __rdtsc(): 0) {}
+		~MainWait() { if (brIsMain) { mainWaitCyc[kind] += __rdtsc() - t0; mainWaitN[kind]++; } }
+	};
+
 	int StatsLine(char* buf, int size) {
-		char w[256];
+		char w[1024];
 		snprintf(w, sizeof(w), " serialWhy: type=%lld script=%lld collide=%lld stun=%lld speed=%lld state=%lld crash=%lld",
 			why[0].load(), why[1].load(), why[2].load(), why[3].load(), why[4].load(), why[5].load(), why[6].load());
+		char m[640];
+		int mk = snprintf(m, sizeof(m), " mainWaitMcyc: start=%.1f/%llu pred=%.1f/%llu serial=%.1f/%llu final=%.1f/%llu point=%.1f/%llu serialHist:",
+			mainWaitCyc[MW_START] / 1e6, mainWaitN[MW_START], mainWaitCyc[MW_PRED] / 1e6, mainWaitN[MW_PRED], mainWaitCyc[MW_SERIAL] / 1e6, mainWaitN[MW_SERIAL],
+			mainWaitCyc[MW_FINAL] / 1e6, mainWaitN[MW_FINAL], mainWaitCyc[MW_POINT] / 1e6, mainWaitN[MW_POINT]);
+		for (int h = 0; h < 2; ++h)
+			for (int st = 0; st < 8; ++st)
+				for (int z = 0; z < 2; ++z)
+					if (const long long v = serialHist[h][st][z].load(); v != 0 && mk < int(sizeof(m)) - 24)
+						mk += snprintf(m + mk, sizeof(m) - mk, " %c%d%c=%lld", h? 'h': 's', st, z? 'z': 'm', v);
+		strncat(w, m, sizeof(w) - strlen(w) - 1);
 		const int a = snprintf(buf, size,
 			"[BR_PARAIR] frames=%lld serialFrames=%lld items=%lld parallel=%lld serial=%lld replanned=%lld earlyChecks=%lld statics=%lld targetEdges=%lld deferredTrails=%lld crashKills=%lld serialPoints=%lld scriptCalls=%lld collisionWrites=%lld bigWrites=%lld oobKills=%lld\n",
 			stats.frames.load(), stats.serialFrames.load(), stats.items.load(), stats.parallel.load(), stats.serial.load(), stats.replanned.load(), stats.earlyChecks.load(), stats.statics.load(),
@@ -177,6 +200,7 @@ namespace BrParAir {
 
 		stats.serialPoints++;
 		unsigned n = 0;
+		MainWait mw(MW_POINT);
 		while (frontier.load(std::memory_order_acquire) < curRank)
 			Spin(n);
 	}
@@ -326,9 +350,12 @@ namespace BrParAir {
 		const bool early = !isSerial[k] && StillAsPlanned(k);
 
 		// in-order start
-		while (nextStart.load(std::memory_order_acquire) != k) {
-			if (!isMain || !ServiceHandoff())
-				Spin(n);
+		if (nextStart.load(std::memory_order_acquire) != k) {
+			MainWait mw(MW_START);
+			while (nextStart.load(std::memory_order_acquire) != k) {
+				if (!isMain || !ServiceHandoff())
+					Spin(n);
+			}
 		}
 
 		if (!isSerial[k]) {
@@ -355,6 +382,7 @@ namespace BrParAir {
 			if (same? early: StillAsPlanned(k)) {
 				nextStart.store(k + 1, std::memory_order_release);
 				if (releaseEarly) {
+					MainWait mw(MW_PRED);
 					for (int i = predBeg[k], e = predBeg[k + 1]; i < e; ++i) {
 						const int j = preds[i];
 						while (!done[j].load(std::memory_order_acquire)) {
@@ -375,8 +403,11 @@ namespace BrParAir {
 
 		// serial: nothing later starts before it is done (nextStart stays at k)
 		if (isMain) {
-			while (frontier.load(std::memory_order_acquire) != k)
-				Spin(n);
+			{
+				MainWait mw(MW_SERIAL);
+				while (frontier.load(std::memory_order_acquire) != k)
+					Spin(n);
+			}
 			RunExclusive(k);
 		} else {
 			handoff.store(k, std::memory_order_release);
@@ -398,6 +429,7 @@ namespace BrParAir {
 		if (!isMain)
 			return;
 		unsigned spins = 0;
+		MainWait mw(MW_FINAL);
 		while (frontier.load(std::memory_order_acquire) < n) {
 			if (!ServiceHandoff())
 				Spin(spins);
@@ -434,8 +466,14 @@ namespace BrParAir {
 			}
 			int w = 0;
 			p.kind = ParallelSafeWhy(u, w)? 1: 2;
-			if (p.kind == 2)
+			if (p.kind == 2) {
 				why[w].fetch_add(1, std::memory_order_relaxed);
+				// [barreplay] measurement: which aircraft are serial
+				const bool hv = (typeid(*mt) == typeid(CHoverAirMoveType));
+				const AAirMoveType* am = (hv || typeid(*mt) == typeid(CStrafeAirMoveType))? static_cast<const AAirMoveType*>(mt): nullptr;
+				const int st = (am != nullptr)? std::clamp(int(am->aircraftState), 0, 6): 7;
+				serialHist[hv][st][u->speed == ZeroVector].fetch_add(1, std::memory_order_relaxed);
+			}
 			p.tgtType = int(u->curTarget.type);
 			p.tgtUnit = (u->curTarget.type == Target_Unit)? u->curTarget.unit: nullptr;
 			p.tgtId = (p.tgtUnit != nullptr)? p.tgtUnit->id: -1;
@@ -540,7 +578,9 @@ namespace BrParAir {
 		}
 		ThreadPool::NotifyWorkerThreads(true, false);
 
+		brIsMain = true;
 		Loop(true);
+		brIsMain = false;
 		FlushTrails(n);
 
 		{
diff --git a/rts/Sim/Units/Scripts/BrCobPar.cpp b/rts/Sim/Units/Scripts/BrCobPar.cpp
index 271fb9a..3cce801 100644
--- a/rts/Sim/Units/Scripts/BrCobPar.cpp
+++ b/rts/Sim/Units/Scripts/BrCobPar.cpp
@@ -553,6 +553,13 @@ namespace BrP5 {
 		}
 	}
 
+	// [barreplay] measurement: the counters for the bench harness's result line
+	int BenchLine(char* buf, int size)
+	{
+		return snprintf(buf, size, "[BR_P5] phases=%lld ticks=%lld parallel=%lld segments=%lld segTicks=%lld serialPoints=%lld byMain=%lld byWorkers=%lld waitMcyc=%.1f startMcyc=%.1f\n",
+			st.phases, st.ticks, st.par, st.segs, st.segTicks, st.serialPoints, st.byMain, st.byWorkers.load(), st.waitCycles / 1e6, st.startCycles / 1e6);
+	}
+
 	void EndTick()
 	{
 		StopWorkers();
diff --git a/rts/Sim/Units/Scripts/BrCobPar.h b/rts/Sim/Units/Scripts/BrCobPar.h
