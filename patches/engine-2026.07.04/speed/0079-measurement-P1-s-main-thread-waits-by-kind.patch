+	int BenchLine(char* buf, int size);
 }
 
 #endif
diff --git a/rts/Sim/Weapons/BrPipeTarget.cpp b/rts/Sim/Weapons/BrPipeTarget.cpp
index a7bdbce..a19fe86 100644
--- a/rts/Sim/Weapons/BrPipeTarget.cpp
+++ b/rts/Sim/Weapons/BrPipeTarget.cpp
@@ -194,6 +194,18 @@ namespace BrP4 {
 	}
 
 
+	// [barreplay] measurement: the counters for the bench harness's result line
+	int BenchLine(char* buf, int size)
+	{
+		int k = snprintf(buf, size, "[BR_P4] slices=%lld launched=%lld slaveCopies=%lld notNative=%lld weight=%lld full=%lld waits=%lld waitMcyc=%.1f inline=%lld drains:",
+			st.slices, st.launched, st.slaveCopies, st.notNative, st.targetWeight, st.full, st.waits, st.waitCycles / 1e6, st.inlineRuns);
+		for (int r = 0; r < DR_N && k < size; ++r)
+			k += snprintf(buf + k, size - k, " %s=%lld", DrainName(r), st.drains[r]);
+		if (k < size)
+			k += snprintf(buf + k, size - k, "\n");
+		return k;
+	}
+
 	bool Begin()
 	{
 		if ((g_brToggles & 0x800000) == 0)
