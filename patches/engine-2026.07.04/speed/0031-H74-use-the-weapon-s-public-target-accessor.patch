From: mabn <github@mabn.pl>
Date: Sat, 17 Oct 2026 11:10:37 +0000
Subject: [PATCH 31/43] H74: use the weapon's public target accessor

---
 rts/Sim/Units/UnitHandler.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/rts/Sim/Units/UnitHandler.cpp b/rts/Sim/Units/UnitHandler.cpp
index bfebea8..3c202ee 100644
--- a/rts/Sim/Units/UnitHandler.cpp
+++ b/rts/Sim/Units/UnitHandler.cpp
@@ -153,8 +153,9 @@ namespace BrRunAhead {
 			PF(reinterpret_cast<const char*>(w) + 64);
 			PF(reinterpret_cast<const char*>(w) + 128);
 			PF(reinterpret_cast<const char*>(w) + 192);
-			PF(&w->currentTarget);
-			const CUnit* t = __atomic_load_n(&w->currentTarget.unit, __ATOMIC_RELAXED);
+			const SWeaponTarget& ct = w->GetCurrentTarget();
+			PF(&ct);
+			const CUnit* t = __atomic_load_n(&ct.unit, __ATOMIC_RELAXED);
 			if (t != nullptr)
 				PF(&t->pos);
 		}
