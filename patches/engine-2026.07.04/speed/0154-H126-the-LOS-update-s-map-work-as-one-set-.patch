 void ILosType::UpdateHeightMapSynced(SRectangle rect)
 {
@@ -1156,6 +1227,74 @@ void CLosHandler::BrP7Begin()
 void CLosHandler::BrP7JoinA() {}
 
 // at the LOS point: false when the window did not open (the ordinary update runs)
+// [barreplay] H126 (toggle3 0x400000): each type's unit loop (perType), then
+// its Update; with H126, every type's map work as one set of tasks instead of
+// one task per type, whose heaviest (the sight type's removes and adds) the
+// others waited for. Four steps: per type, the units and Update's queues and
+// filtering (BrUpdateBegin, BrStageMapWork); every type's raycasts at once;
+// each (type, ally team)'s removes and adds; per type, the cache
+// (BrUpdateEnd). A type's state is touched only in its own first and last
+// step; a map step touches one ally team's map (integer adds, which commute)
+// and reads the squares the raycasts wrote. Only in full view: a visible add
+// otherwise reports squares entering LOS to the unsynced height map.
+template <typename F>
+static void BrH126Types(std::array<ILosType*, 7>& losTypes, F&& perType)
+{
+	if ((g_brToggles3 & 0x400000) == 0 || !gu->spectatingFullView) {
+		for_mt(0, losTypes.size(), [&](const int idx) {
+			perType(idx);
+			losTypes[idx]->Update();
+		});
+		return;
+	}
+
+	static std::array<uint8_t, 7> busy;
+	busy.fill(0);
+	for_mt(0, losTypes.size(), [&](const int idx) {
+		perType(idx);
+		ILosType* lt = losTypes[idx];
+		if (lt->BrUpdateBegin()) {
+			lt->BrStageMapWork();
+			busy[idx] = 1;
+		}
+	});
+
+	static std::vector<std::pair<ILosType*, SLosInstance*>> rays;
+	rays.clear();
+	for (size_t t = 0; t < losTypes.size(); ++t) {
+		if (busy[t] == 0 || losTypes[t]->algoType != ILosType::LOS_ALGO_RAYCAST)
+			continue;
+		for (SLosInstance* li: losTypes[t]->BrRecalc())
+			rays.emplace_back(losTypes[t], li);
+	}
+	for_mt(0, rays.size(), [&](const int i) {
+		ILosType* lt = rays[i].first;
+		SLosInstance* li = rays[i].second;
+		assert(li->refCount > 0);
+		li->squares.clear();
+		lt->losMaps[li->allyteam].PrepareRaycast(li);
+	});
+
+	static std::vector<std::pair<int, int>> jobs;
+	jobs.clear();
+	for (size_t t = 0; t < losTypes.size(); ++t) {
+		if (busy[t] == 0)
+			continue;
+		for (size_t a = 0; a < losTypes[t]->losMaps.size(); ++a) {
+			if (losTypes[t]->BrHasMapWork(int(a)))
+				jobs.emplace_back(int(t), int(a));
+		}
+	}
+	for_mt(0, jobs.size(), [&](const int j) {
+		losTypes[jobs[j].first]->BrMapWork(jobs[j].second);
+	});
+
+	for_mt(0, losTypes.size(), [&](const int idx) {
+		if (busy[idx] != 0)
+			losTypes[idx]->BrUpdateEnd();
+	});
+}
