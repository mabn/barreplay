+// [barreplay] H126: Update's map work sorted by ally team, in its order. A
+// remove whose instance is also recalculated keeps the old squares (moved
+// aside, leaving the instance empty as Update's raycast leaves it before
+// filling it), so the raycast may run on any thread before the removes.
+void ILosType::BrStageMapWork()
+{
+	const size_t na = losMaps.size();
+	brRem.resize(na);
+	brAdd.resize(na);
+	for (auto& v: brRem) v.clear();
+	for (auto& v: brAdd) v.clear();
+	brRecalcRem.assign(losRemove.size(), 0);
+	if (brOld.size() < losRemove.size())
+		brOld.resize(losRemove.size());
+
+	if (algoType == LOS_ALGO_RAYCAST && !losRecalc.empty()) {
+		if (brTag.size() < instances.size())
+			brTag.resize(instances.size(), 0);
+		if (++brGen == 0) {
+			std::fill(brTag.begin(), brTag.end(), 0);
+			brGen = 1;
+		}
+		for (const SLosInstance* li: losRecalc)
+			brTag[li->id] = brGen;
+		for (size_t k = 0; k < losRemove.size(); ++k) {
+			SLosInstance* li = losRemove[k];
+			if (brTag[li->id] != brGen)
+				continue;
+			brRecalcRem[k] = 1;
+			brOld[k].clear();
+			std::swap(li->squares, brOld[k]);
+		}
+	}
+	for (size_t k = 0; k < losRemove.size(); ++k)
+		brRem[losRemove[k]->allyteam].push_back(int(k));
+	for (SLosInstance* li: losAdd)
+		brAdd[li->allyteam].push_back(li);
+}
+
+// [barreplay] H126: ally team a's removes, then its adds (the raycasts have run)
+void ILosType::BrMapWork(int a)
+{
+	for (const int k: brRem[a]) {
+		if (brRecalcRem[k]) {
+			losMaps[a].BrAddSquares(brOld[k], -1);
+		} else {
+			LosRemove(losRemove[k]);
+		}
+	}
+	for (SLosInstance* li: brAdd[a]) {
+		assert(li->refCount > 0);
+		LosAdd(li);
+	}
+}
