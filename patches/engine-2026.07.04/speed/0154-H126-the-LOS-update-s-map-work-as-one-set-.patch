+	// raycast (on any thread) cannot clobber what its removal needs;
+	// BrMapWork(a) is ally team a's removes and adds; BrUpdateEnd is the cache.
+	bool BrUpdateBegin();
+	void BrStageMapWork();
+	bool BrHasMapWork(int a) const { return size_t(a) < brRem.size() && (!brRem[a].empty() || !brAdd[a].empty()); }
+	void BrMapWork(int a);
+	void BrUpdateEnd();
+	const std::vector<SLosInstance*>& BrRecalc() const { return losRecalc; }
+
 
 private:
 	//void PostLoad();
@@ -202,6 +216,16 @@ private:
 	std::vector<SLosInstance*> losDeleted;
 	std::vector<SLosInstance*> losRecalc;
 
+	// [barreplay] H126: BrStageMapWork's sorting (indices into losRemove, and
+	// losAdd's entries, per ally team) and the old squares of the removes whose
+	// instance is also recalculated
+	std::vector<std::vector<int>> brRem;
+	std::vector<std::vector<SLosInstance*>> brAdd;
+	std::vector<std::vector<SLosInstance::RLE>> brOld;
+	std::vector<uint8_t> brRecalcRem;
+	std::vector<unsigned> brTag;
+	unsigned brGen = 0;
+
 	static constexpr int CACHE_SIZE = 4096;
 };
 
diff --git a/rts/Sim/Misc/LosMap.h b/rts/Sim/Misc/LosMap.h
index e0adebe..6f7f5ae 100644
--- a/rts/Sim/Misc/LosMap.h
+++ b/rts/Sim/Misc/LosMap.h
@@ -53,6 +53,20 @@ public:
 	// FIXME temp fix for CBaseGroundDrawer and AI interface, which need raw data
 	const unsigned short& front() const { return losmap.front(); }
 	const auto& GetLosMap() const { return losmap; }
+	// [barreplay] H126: AddRaycast's plain path (any amount but a visible
+	// add's) over the given squares instead of the instance's own (a template
+	// only because SLosInstance is incomplete here; 0 is EMPTY_RLE's length)
+	template <typename RLEs>
+	void BrAddSquares(const RLEs& losSquares, int amount) {
+		if (losSquares.empty() || losSquares[0].length == 0)
+			return;
+
+		for (const auto rle: losSquares) {
+			for (int idx = rle.start, len = rle.length; len > 0; --len, ++idx) {
+				losmap[idx] += amount;
+			}
+		}
+	}
 private:
 	void LosAdd(SLosInstance* instance) const;
 	void UnsafeLosAdd(SLosInstance* instance) const;
