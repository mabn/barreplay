 				lt->UpdateUnit(u, false);
 			}
-			lt->Update();
 		});
 	} else {
 		// a unit whose inputs changed in the window: tested again, every type
@@ -1229,14 +1365,13 @@ bool CLosHandler::BrP7Finish()
 			}
 			st.marks += marked.size();
 		}
-		for_mt(0, losTypes.size(), [&](const int idx) {
+		BrH126Types(losTypes, [&](const int idx) {
 			ILosType* lt = losTypes[idx];
 			const uint8_t bit = uint8_t(1u << idx);
 			for (size_t n = 0, m = units.size(); n < m; ++n) {
 				if ((needs[n] & bit) != 0)
 					lt->UpdateUnit(units[n], false);
 			}
-			lt->Update();
