From b4c45785f89e57de50cba227032dab225436a821 Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Tue, 20 Oct 2026 19:08:17 +0000
Subject: [PATCH 136/149] [barreplay] H111: Lua's hashmod remainder by Lemire's
 reciprocal (toggle3 0x10)

lsizenode is at most MAXBITS (26), so the divisors (sizenode-1)|1 are 27; each
gets M = floor((2^64-1)/d) + 1 and ((M*n mod 2^64) * d) >> 64 equals n % d for
every 32-bit n and d. Tested against % for 41.6e9 numerators (exhaustive for
tables of up to 256 nodes, every 7th to 4096, 20M random and the multiples of d
for each size): 0 differences. Every key lands where it did, so iteration order
is unchanged; the Table struct is untouched (its size moves allocations, and
pointer-keyed order follows addresses).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rts/lib/lua/src/ltable.cpp | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/rts/lib/lua/src/ltable.cpp b/rts/lib/lua/src/ltable.cpp
index b912c7a..8c9d71d 100644
--- a/rts/lib/lua/src/ltable.cpp
+++ b/rts/lib/lua/src/ltable.cpp
@@ -21,6 +21,7 @@
 //SPRING#include <math.h>
 #include "streflop_cond.h"
 #include <string.h>
+#include <stdint.h>
 
 #define ltable_c
 #define LUA_CORE
@@ -58,7 +59,34 @@
 ** for some types, it is better to avoid modulus by power of 2, as
 ** they tend to have many 2 factors.
 */
-#define hashmod(t,n)	(gnode(t, ((n) % ((sizenode(t)-1)|1))))
+#define hashmod(t,n)	(gnode(t, brHashMod((n), (t))))
+
+/*
+** [barreplay] H111 (toggle3 0x10): hashmod's remainder by (sizenode-1)|1
+** without a division (a 32-bit div is ~25 cycles, on every number- and
+** pointer-keyed lookup). lsizenode is at most MAXBITS, so the divisors are
+** few; each gets Lemire's reciprocal M = floor((2^64-1)/d) + 1, and
+** ((M*n mod 2^64) * d) >> 64 equals n % d for every 32-bit n and d (Lemire,
+** Kaser, Kurz, "Faster remainder by direct computation", 2019). So every key
+** lands in the node it always did, and iteration order is unchanged.
+*/
+extern unsigned g_brToggles3;
+struct BrHashModTable {
+  uint64_t m[MAXBITS + 1];
+  constexpr BrHashModTable(): m() {
+    for (int k = 0; k <= MAXBITS; ++k)
+      m[k] = UINT64_MAX / ((((uint32_t)1 << k) - 1) | 1) + 1;
+  }
+};
+static constexpr BrHashModTable brHashModTable{};
+static inline unsigned int brHashMod (unsigned int n, const Table *t) {
+  if ((g_brToggles3 & 0x10) == 0)
+    return n % ((sizenode(t)-1)|1);
+  const int k = t->lsizenode;
+  const uint64_t d = (((uint32_t)1 << k) - 1) | 1;
+  const uint64_t low = brHashModTable.m[k] * (uint64_t)n;
+  return (unsigned int)(((__uint128_t)low * d) >> 64);
+}
 
 
 #define hashpointer(t,p)	hashmod(t, IntPoint(p))
