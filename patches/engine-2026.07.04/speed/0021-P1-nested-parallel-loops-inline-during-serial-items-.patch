 					|| (CGround::GetHeightAboveWater(owner->pos.x, owner->pos.z) + 5.0f + owner->radius) > owner->pos.y){
+				// [barreplay] P1: a parallel crashing aircraft was checked not to get here
+				if (BrParAir::Active())
+					BrParAir::stats.crashKills++;
