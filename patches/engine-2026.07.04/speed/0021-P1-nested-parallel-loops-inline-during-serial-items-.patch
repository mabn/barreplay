+
 		if (doneCap < size_t(n)) {
 			doneCap = size_t(n) * 2;
 			done.reset(new std::atomic<uint8_t>[doneCap]);
@@ -337,6 +395,7 @@ namespace BrParAir {
 		ThreadPool::NotifyWorkerThreads(true, false);
 
 		Loop(true);
+		FlushTrails(n);
 
 		{
 			// the worker slices find nothing left to claim, whoever runs them
