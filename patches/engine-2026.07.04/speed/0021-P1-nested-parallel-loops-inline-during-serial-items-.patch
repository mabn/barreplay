+			if (BrParAir::Active())
+				BrParAir::DeferTrail(owner, crashExpGenID);
+			else
+				amtEmitCrashTrailFuncs[crashExpGenID != -1u](owner, crashExpGenID);
 		} break;
 		case AIRCRAFT_TAKEOFF:
 			UpdateTakeOff();
