 		if (curRank < 0)
 			return;
@@ -123,9 +143,14 @@ namespace BrParAir {
 
 	// main thread only: every earlier item has finished and no later one has started
 	static void RunExclusive(int k) {
+		FlushTrails(k);
 		const bool mt = ThreadPool::IsInMultiThreadedSection();
 		ThreadPool::SetInMultiThreadedSection(false);
+		// the workers are spinning in this loop: a parallel loop started from
+		// inside the item would wait for them forever
+		ThreadPool::SetInlineOnly(true);
 		RunItem(work[k]);
+		ThreadPool::SetInlineOnly(false);
 		ThreadPool::SetInMultiThreadedSection(mt);
 
 		Finish(k);
@@ -143,6 +168,31 @@ namespace BrParAir {
 		return true;
 	}
 
+	// A crashing aircraft dies when it reaches the ground (UpdateAirPhysics'
+	// ground contact, or 5 + radius above it). It moves at most its speed plus
+	// a frame of gravity, and the terrain under any point is no higher than the
+	// highest height-map corner around it (and water is 0), so this bound says it
+	// cannot happen in this frame's update.
+	static bool CrashCannotEndThisFrame(const CUnit* u) {
+		const float reach = u->speed.w + 4.0f;
+		const float lowY = std::min(u->pos.y, u->midPos.y) - reach - u->pos.distance(u->midPos);
+		const float* hm = readMap->GetCornerHeightMapSynced();
+
+		const int x0 = std::clamp(int((u->pos.x - reach) / SQUARE_SIZE) - 1, 0, mapDims.mapx);
+		const int x1 = std::clamp(int((u->pos.x + reach) / SQUARE_SIZE) + 2, 0, mapDims.mapx);
+		const int z0 = std::clamp(int((u->pos.z - reach) / SQUARE_SIZE) - 1, 0, mapDims.mapy);
+		const int z1 = std::clamp(int((u->pos.z + reach) / SQUARE_SIZE) + 2, 0, mapDims.mapy);
+
+		float hmax = 0.0f;
+		for (int z = z0; z <= z1; ++z) {
+			for (int x = x0; x <= x1; ++x) {
+				hmax = std::max(hmax, hm[z * mapDims.mapxp1 + x]);
+			}
+		}
+
+		return (lowY > (hmax + 5.0f + u->radius + 1.0f));
+	}
+
 	static bool ParallelSafe(const CUnit* u) {
 		const AMoveType* mt = u->moveType;
 
@@ -152,14 +202,19 @@ namespace BrParAir {
 			return false;
 
 		const CStrafeAirMoveType* amt = static_cast<const CStrafeAirMoveType*>(mt);
-		if (amt->aircraftState != AAirMoveType::AIRCRAFT_FLYING || amt->collide)
+		if (amt->collide)
 			return false;
-		if (u->IsStunned() || u->IsCrashing() || u->beingBuilt || u->UnderFirstPersonControl() || u->GetTransporter() != nullptr)
+		if (u->IsStunned() || u->beingBuilt || u->UnderFirstPersonControl() || u->GetTransporter() != nullptr)
 			return false;
 		if (u->speed.w > (MAX_UNIT_SPEED * 0.5f) || u->speed == ZeroVector)
 			return false;
 
-		return true;
+		if (amt->aircraftState == AAirMoveType::AIRCRAFT_FLYING)
+			return !u->IsCrashing();
+		if (amt->aircraftState == AAirMoveType::AIRCRAFT_CRASHING)
+			return ((g_brToggles & 8) != 0 && CrashCannotEndThisFrame(u));
+
+		return false;
 	}
 
 	// still what the plan assumed, now that every earlier serial item has run
