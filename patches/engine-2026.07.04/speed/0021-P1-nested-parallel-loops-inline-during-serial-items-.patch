+	// main thread, every item before <upTo> finished: emit their trails in order
+	static void FlushTrails(int upTo) {
+		for (; trailsFlushed < upTo; ++trailsFlushed) {
+			const auto& t = trails[trailsFlushed];
+			if (t.first != nullptr)
+				amtEmitCrashTrailFuncs[t.second != -1u](t.first, t.second);
+		}
+	}
