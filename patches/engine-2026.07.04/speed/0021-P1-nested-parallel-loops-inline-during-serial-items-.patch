diff --git a/rts/System/Threading/ThreadPool.cpp b/rts/System/Threading/ThreadPool.cpp
index 60913af..e8d0407 100644
--- a/rts/System/Threading/ThreadPool.cpp
+++ b/rts/System/Threading/ThreadPool.cpp
@@ -135,7 +135,13 @@ static int GetDefaultNumWorkers() {
 int GetNumThreads() { return (workerThreads[false].size() + 1); }
 int GetMaxThreads() { return std::min(MAX_THREADS, Threading::GetLogicalCpuCores()); }
 
-bool HasThreads() { return !workerThreads[false].empty(); }
+// [barreplay] P1: while the main thread runs a serial item of the parallel
+// move-type loop, the workers are busy waiting for it, so any parallel loop
+// started from inside that item must run inline (the engine's single-thread
+// mode, which multithreaded results must equal anyway).
+static _threadlocal bool brInlineOnly(false);
+void SetInlineOnly(bool b) { brInlineOnly = b; }
+bool HasThreads() { return !brInlineOnly && !workerThreads[false].empty(); }
 
 
 
