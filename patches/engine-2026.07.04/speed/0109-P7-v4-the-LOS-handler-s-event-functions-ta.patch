From 4aa6b05fb693f8bf94cfe862ce1d6eb69525aec1 Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Mon, 19 Oct 2026 18:56:12 +0000
Subject: [PATCH] [barreplay] P7 v4: the LOS handler's event functions take
 phase A back for their unit; a height-map change in the window takes it back
 for all. H104: the unsynced handles keep UnitGiven and UnitTaken

The governed whole game on speed53 had identical unit samples but a capture
that differed: (1) a unit dying in the window kept its lingering (delayed)
sight at the square phase A had moved it to, where stock keeps it at the old
one; 8 visibility records differed. (2) BAR's unsynced Widget Events gadget
forwards UnitGiven/UnitTaken to LuaUI for transfers between teams not allied
with the local one, and the capture widget records both calls; muting it lost
183 duplicate given events at 77176 and 8 at 82033.
---
 rts/Game/Game.cpp           | 18 ++++++++-
 rts/Lua/LuaHandle.cpp       |  2 +-
 rts/Sim/Misc/BrLosOverlap.h | 11 ++++++
 rts/Sim/Misc/LosHandler.cpp | 74 ++++++++++++++++++++++++++++++++++---
 rts/Sim/Misc/LosHandler.h   |  5 +++
 rts/System/EventHandler.cpp | 13 +++++++
 rts/System/EventHandler.h   |  2 +
 7 files changed, 117 insertions(+), 8 deletions(-)

diff --git a/rts/Game/Game.cpp b/rts/Game/Game.cpp
index c9f06f5..ae9c69c 100644
--- a/rts/Game/Game.cpp
+++ b/rts/Game/Game.cpp
@@ -1833,11 +1833,25 @@ void CGame::SimFrame() {
 		if (!brH104Done && (g_brToggles2 & 0x40000) != 0 && gameSetup != nullptr && gameSetup->hostDemo) {
 			brH104Done = true;
 			int muted = 0;
+			// except UnitGiven and UnitTaken: BAR's unsynced "Widget Events"
+			// gadget forwards those to LuaUI (Script.LuaUI.UnitGiven) for
+			// units changing hands between teams not allied with the local
+			// one, full-view spectator or not, and the capture widget records
+			// what it is handed, so they are part of the capture
+			static const char* const keep[] = {"UnitGiven", "UnitTaken"};
 			for (CSplitLuaHandle* h: {static_cast<CSplitLuaHandle*>(luaRules), static_cast<CSplitLuaHandle*>(luaGaia)}) {
 				if (h == nullptr)
 					continue;
-				h->unsyncedLuaHandle.brMuted = true;
-				eventHandler.RemoveClient(&h->unsyncedLuaHandle);
+				CUnsyncedLuaHandle* u = &h->unsyncedLuaHandle;
+				bool had[2];
+				for (int k = 0; k < 2; ++k)
+					had[k] = eventHandler.BrHasEvent(u, keep[k]);
+				u->brMuted = true;
+				eventHandler.RemoveClient(u);
+				for (int k = 0; k < 2; ++k) {
+					if (had[k])
+						eventHandler.InsertEvent(u, keep[k]);
+				}
 				muted += 1;
 			}
 			LOG("[BR_H104] f=%d muted %d unsynced Lua handles", gs->frameNum, muted);
