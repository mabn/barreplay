@@ -927,16 +944,58 @@ namespace BrP7 {
 
 // phase A, one chunk of units: H93's test of every type (UpdateUnit's tests in
 // its order, reads only), the bit set where UpdateUnit would act
+// P7 v4: the LOS handler's event functions run, in stock, before the LOS
+// update has touched the unit, so the first one in the window takes phase A's
+// change back for it (its instance returns to what it was, and phase B's redo
+// of the marked unit then does what the stock update would)
+void CLosHandler::BrP7RevertUnit(const CUnit* unit)
+{
+	using namespace BrP7;
+	const int i = idxOf[unit->id];
+	if (i < 0 || size_t(i) >= units.size() || units[i] != unit || reverted[i] != 0)
+		return;
+	reverted[i] = 1;
+	revertedUnits += 1;
+	CUnit* u = units[i];
+	for (size_t t = 0; t < losTypes.size(); ++t) {
+		ILosType* lt = losTypes[t];
+		SLosInstance* cur = u->los[lt->type];
+		SLosInstance* old = prevInst[t][i];
+		if (cur == old)
+			continue;
+		// the old one first: it may be the same key the new one released
+		if (old != nullptr)
+			lt->BrRefInstance(old);
+		u->los[lt->type] = old;
+		if (cur != nullptr)
+			lt->BrUnrefInstance(cur);
+	}
+}
+
+// a height-map change in the window: stock changes the instances as they were
+// before the LOS update, so take phase A back for every unit and let phase B
+// run the whole ordinary update
+void CLosHandler::BrP7RevertAll()
+{
+	using namespace BrP7;
+	revertedAll += 1;
+	for (size_t k = 0; k < units.size(); ++k)
+		BrP7RevertUnit(units[k]);
+	all = true;
+}
+
 void CLosHandler::BrP7RunTypes()
 {
 	using namespace BrP7;
 	const int n = int(losTypes.size());
 	for (int t; (t = nextType.fetch_add(1, std::memory_order_acq_rel)) < n; ) {
 		ILosType* lt = losTypes[t];
+		SLosInstance** prev = prevInst[t].data();
 		for (size_t k = 0, m = units.size(); k < m; ++k) {
 			CUnit* u = units[k];
 			if (t == 0)
 				idxOf[u->id] = int(k);
+			prev[k] = u->los[lt->type];
 			lt->UpdateUnit(u, false);
 		}
 		doneTypes.fetch_add(1, std::memory_order_acq_rel);
@@ -954,10 +1013,12 @@ void CLosHandler::BrP7PhaseA(int chunk)
 		const int n = int(losTypes.size());
 		for (int t; (t = nextType.fetch_add(1, std::memory_order_acq_rel)) < n; ) {
 			ILosType* lt = losTypes[t];
+			SLosInstance** prev = prevInst[t].data();
 			for (size_t k = 0, m = units.size(); k < m; ++k) {
 				CUnit* u = units[k];
 				if (t == 0)
 					idxOf[u->id] = int(k);
+				prev[k] = u->los[lt->type];
 				lt->UpdateUnit(u, false);
 			}
 			doneTypes.fetch_add(1, std::memory_order_acq_rel);
@@ -1003,6 +1064,9 @@ void CLosHandler::BrP7Begin()
 	launched = true;
 	v4 = (g_brToggles2 & 0x80000) != 0;
 	if (v4) {
+		for (size_t t = 0; t < losTypes.size(); ++t)
+			prevInst[t].resize(units.size());
+		reverted.assign(units.size(), 0);
 		nextType.store(0, std::memory_order_relaxed);
 		doneTypes.store(0, std::memory_order_relaxed);
 		joined = false;
@@ -1180,7 +1244,7 @@ void CLosHandler::Update()
 void CLosHandler::UpdateHeightMapSynced(SRectangle rect)
 {
 	RECOIL_DETAILED_TRACY_ZONE;
-	BrP7::Join(); // [barreplay] P7 v4: phase A writes the types
+	BrP7::RevertAll(); // [barreplay] P7 v4: every unit's phase A taken back
 	// [barreplay] H94 (toggle 0x40000000): the sensor types on all threads. Each
 	// type's update touches only its own instances, cache and queues (and reads
 	// the instances' own fields), and does exactly what it did, in its own
