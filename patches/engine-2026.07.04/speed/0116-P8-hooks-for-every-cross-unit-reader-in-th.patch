 // is the sequential one.
 
 #include "BrPipeTarget.h"
+#include "Sim/Units/BrWeaponVectors.h"
 
 #include <algorithm>
 #include <cstdio>
@@ -80,6 +81,9 @@ namespace BrP4 {
 		}
 
 		void RunTask(Task& t, int thread) {
+			// [barreplay] P8: the search reads the weapon's own vectors
+			if (!t.slave)
+				BrP8::Ensure(t.w->owner);
 			if (!t.slave)
 				t.result = t.w->BrSearchTarget(t.avoid, tlPairs, -1, thread);
 			t.done.store(1, std::memory_order_release);
