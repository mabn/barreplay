 #include "Sim/MoveTypes/Systems/BrParallelAir.h"
 #include "Map/ReadMap.h"
@@ -1188,6 +1189,7 @@ void CQuadField::GetUnitsAndFeaturesColVol(
 				const auto* colvol = &r->collisionVolume;
