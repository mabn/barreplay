From 9f35034a93b29640c6309a2331addbadb3698ad1 Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Mon, 19 Oct 2026 23:22:37 +0000
Subject: [PATCH] [barreplay] P8: hooks for every cross-unit reader in the loop

Collision tests (piece-tree volumes read and lazily update another unit's
piece matrices, which its weapon vectors also do), the quad field's shield
query (muzzle positions), Lua's unit lookups (synced and unsynced reads may
read pieces or weapons), CallAsUnit, P4's search tasks (they read the
searching weapon's vectors on a worker), and the hold-fire flag writers.
Stats counted atomically (workers ensure too).
---
 rts/Lua/LuaSyncedRead.cpp               |  6 +++++-
 rts/Lua/LuaUnsyncedRead.cpp             |  3 +++
 rts/Sim/Misc/CollisionHandler.cpp       |  4 ++++
 rts/Sim/Misc/CollisionVolume.cpp        |  2 ++
 rts/Sim/Misc/QuadField.cpp              |  2 ++
 rts/Sim/MoveTypes/HoverAirMoveType.cpp  |  2 ++
 rts/Sim/Units/Scripts/LuaUnitScript.cpp |  2 ++
 rts/Sim/Units/Unit.h                    |  3 ++-
 rts/Sim/Units/UnitHandler.cpp           | 13 +++++++------
 rts/Sim/Weapons/BrPipeTarget.cpp        |  4 ++++
 10 files changed, 33 insertions(+), 8 deletions(-)

diff --git a/rts/Lua/LuaSyncedRead.cpp b/rts/Lua/LuaSyncedRead.cpp
index 5afdbf4..4459a31 100644
--- a/rts/Lua/LuaSyncedRead.cpp
+++ b/rts/Lua/LuaSyncedRead.cpp
@@ -608,7 +608,11 @@ static inline CUnit* ParseRawUnit(lua_State* L, const char* caller, int index)
 		return nullptr;
 	}
 
-	return (unitHandler.GetUnit(lua_toint(L, index)));
+	CUnit* unit = unitHandler.GetUnit(lua_toint(L, index));
+	// [barreplay] P8: a read of a unit may read its pieces or weapons
+	if (unit != nullptr)
+		BrP8::Ensure(unit);
+	return unit;
 }
 
 static inline const CUnit* ParseUnit(lua_State* L, const char* caller, int index)
