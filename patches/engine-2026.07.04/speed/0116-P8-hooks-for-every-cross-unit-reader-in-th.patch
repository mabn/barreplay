 #include "LuaUnsyncedRead.h"
+#include "Sim/Units/BrWeaponVectors.h"
 #include "LuaEngineEventLog.h"
 
 #include "LuaConfig.h"
@@ -347,6 +348,8 @@ static inline CUnit* ParseUnit(lua_State* L, const char* caller, int index)
 	}
 
 	CUnit* unit = unitHandler.GetUnit(lua_toint(L, index));
+	if (unit != nullptr)
+		BrP8::Ensure(unit); // [barreplay] P8: a read of a unit may read its pieces or weapons
 
