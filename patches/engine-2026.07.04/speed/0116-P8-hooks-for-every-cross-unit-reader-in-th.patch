diff --git a/rts/Sim/Units/UnitHandler.cpp b/rts/Sim/Units/UnitHandler.cpp
index 20e4cdb..6015d29 100644
--- a/rts/Sim/Units/UnitHandler.cpp
+++ b/rts/Sim/Units/UnitHandler.cpp
@@ -885,7 +885,8 @@ namespace BrP8 {
 		std::atomic<int> nextChunk{0};
 		int numChunks = 0;
 		constexpr int CHUNK = 32;
-		struct Stats { long long frames = 0, units = 0, byMain = 0, waits = 0, all = 0; } st;
+		// byMain/waits/all are counted from any thread (P4's search tasks ensure too)
+		struct Stats { long long frames = 0, units = 0; std::atomic<long long> byMain{0}, waits{0}, all{0}; } st;
 		int lastLog = -1000000;
 
 		inline void Compute(size_t k) { units[k]->UpdateWeaponVectors(); }
@@ -899,10 +900,10 @@ namespace BrP8 {
 			if (state[k].compare_exchange_strong(z, 1, std::memory_order_acq_rel)) {
 				Compute(k);
 				state[k].store(2, std::memory_order_release);
-				st.byMain += 1;
+				st.byMain.fetch_add(1, std::memory_order_relaxed);
 				return;
 			}
-			st.waits += 1;
+			st.waits.fetch_add(1, std::memory_order_relaxed);
 			while (state[k].load(std::memory_order_acquire) != 2)
 				_mm_pause();
 		}
@@ -949,7 +950,7 @@ namespace BrP8 {
 
 	void EnsureAllSlow()
 	{
-		st.all += 1;
+		st.all.fetch_add(1, std::memory_order_relaxed);
 		for (size_t k = 0; k < units.size(); ++k)
 			EnsureIdx(k);
 	}
@@ -1001,8 +1002,8 @@ namespace BrP8 {
 		if ((gs->frameNum - lastLog) >= 900 && getenv("BARREPLAY_P8_STATS") != nullptr) {
 			lastLog = gs->frameNum;
 			LOG("[BR_P8] f=%d pipelined frames=%lld avgUnits=%.0f byMain/frame=%.1f waits/frame=%.2f ensureAll/frame=%.2f",
-				gs->frameNum, st.frames, double(st.units) / st.frames, double(st.byMain) / st.frames,
-				double(st.waits) / st.frames, double(st.all) / st.frames);
+				gs->frameNum, st.frames, double(st.units) / st.frames, double(st.byMain.load()) / st.frames,
+				double(st.waits.load()) / st.frames, double(st.all.load()) / st.frames);
 		}
 	}
 }
