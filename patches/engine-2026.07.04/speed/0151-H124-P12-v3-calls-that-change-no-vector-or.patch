+	// vector input at all (H124, LuaUtils.cpp BrNoSimInput)
+	inline void LuaWrite(const char* name, bool dataOnly, bool quiet) {
 		if (__builtin_expect(active.load(std::memory_order_relaxed), false))
-			LuaWriteSlow(name, dataOnly);
+			LuaWriteSlow(name, dataOnly, quiet);
 	}
 }
 
