 	void EnsureAllSlow();
-	void LuaWriteSlow(const char* name, bool dataOnly);
+	void LuaWriteSlow(const char* name, bool dataOnly, bool quiet);
 
 	inline void Ensure(const CUnit* unit) {
 		if (__builtin_expect(active.load(std::memory_order_relaxed), false))
@@ -61,10 +61,11 @@ namespace BrP8 {
 	// a Lua write function is entered: every unit made ready, except, with
 	// toggle2 0x800000, for the writes that touch only Lua data or team
 	// resources (rules params, resources: nothing a weapon vector reads);
-	// counted by name for BARREPLAY_P8_STATS
-	inline void LuaWrite(const char* name, bool dataOnly) {
