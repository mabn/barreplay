--- a/rts/Lua/LuaUtils.cpp
+++ b/rts/Lua/LuaUtils.cpp
@@ -12,6 +12,9 @@
 #include "Sim/Projectiles/BrPreCollide.h"
 #include "Sim/MoveTypes/Systems/BrParallelAir.h"
 #include "Sim/Units/UnitHandler.h"
+#include "Sim/Units/Unit.h"
+#include "Sim/Units/CommandAI/Command.h"
+#include "Sim/Units/CommandAI/CommandAI.h"
 
 // [barreplay] H101: how many calls of a Lua function that writes simulation
 // state there have been (the functions entered through the two trampolines)
@@ -43,15 +46,48 @@ namespace {
 	};
 }
 
+// [barreplay] H124 (toggle3 0x80000, P8) and P12 v3 (toggle3 0x100000):
+// the functions in the draining list that change nothing a weapon vector or a
+// collision check reads. GetUnitWeaponState and GetUnitWeaponVectors are reads
+// (there for P4; the second makes its own unit ready); SpawnCEG spawns only
+// unsynced effects (H113's audit) and may load a generator; a stockpile order
+// (GiveOrderToUnit, CMD_STOCKPILE, read as ParseCommand reads it) on a unit
+// for which it is a non-queueing command goes through every command AI's
+// GiveCommandReal without a queueing command's side effects (stopping a build,
+// dropping a temporary order) to ExecuteStateCommand, which changes the
+// stockpile queue and the command's icon. The callins on the way
+// (AllowCommand, UnitCommand) are Lua, whose writes come through here
+// themselves.
+static bool BrNoSimInput(lua_State* L, const char* name)
+{
+	if (name == nullptr)
+		return false;
+	switch (name[0]) {
+		case 'S': return std::strcmp(name, "SpawnCEG") == 0;
+		case 'G': {
+			if (std::strcmp(name, "GetUnitWeaponState") == 0 || std::strcmp(name, "GetUnitWeaponVectors") == 0)
+				return true;
+			if (std::strcmp(name, "GiveOrderToUnit") != 0 || !lua_isnumber(L, 1) || !lua_isnumber(L, 2) || lua_toint(L, 2) != CMD_STOCKPILE)
+				return false;
+			const CUnit* u = unitHandler.GetUnit(lua_toint(L, 1));
+			return u != nullptr && u->commandAI != nullptr && u->commandAI->nonQueingCommands.find(CMD_STOCKPILE) != u->commandAI->nonQueingCommands.end();
+		}
+		default: return false;
+	}
+}
+
 int BrLuaDrainingCall(lua_State* L)
 {
 	++g_brLuaWrites;
 	const char* brName = static_cast<const char*>(lua_touserdata(L, lua_upvalueindex(2)));
+	const bool brData = lua_toboolean(L, lua_upvalueindex(3));
+	const bool brQuiet = !brData && (g_brToggles3 & 0x180000) != 0
+		&& (BrP8::active.load(std::memory_order_relaxed) || g_brP12Active) && BrNoSimInput(L, brName);
 	// [barreplay] P8: Lua can change anything a weapon vector reads
-	BrP8::LuaWrite(brName, lua_toboolean(L, lua_upvalueindex(3)));
+	BrP8::LuaWrite(brName, brData, brQuiet && (g_brToggles3 & 0x80000) != 0);
 	// [barreplay] P12: any write but rules params and team resources
 	BrP12After brAfter{nullptr};
-	if (!lua_toboolean(L, lua_upvalueindex(3)) && g_brP12Active) {
+	if (!brData && g_brP12Active && !(brQuiet && (g_brToggles3 & 0x100000) != 0)) {
 		brAfter.u = BrP12WriteTarget(L, brName);
 		if (brAfter.u != nullptr)
 			BrP12MarkUnit(brAfter.u);
@@ -87,7 +123,7 @@ int BrLuaDrainingCallLus(lua_State* L)
 {
 	++g_brLuaWrites;
 	// [barreplay] P8: Lua can change anything a weapon vector reads
-	BrP8::LuaWrite(static_cast<const char*>(lua_touserdata(L, lua_upvalueindex(2))), false);
+	BrP8::LuaWrite(static_cast<const char*>(lua_touserdata(L, lua_upvalueindex(2))), false, false);
 	BrP12Global(); // [barreplay] P12: unit-script pieces
 	BrP4::Drain(BrP4::DR_LUA);
 	const lua_CFunction f = reinterpret_cast<lua_CFunction>(lua_touserdata(L, lua_upvalueindex(1)));
