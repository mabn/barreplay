 		if (stats && name != nullptr)
@@ -1021,15 +1021,26 @@ namespace BrP8 {
 			luaSkipped += 1;
 			return;
 		}
+		if (quiet) {
+			luaQuiet += 1;
+			return;
+		}
 		luaAll += 1;
 		EnsureAllSlow();
 	}
 
+	// [barreplay] H124 (toggle3 0x80000): a unit once ready stays ready until
+	// the next Begin (its state only goes 0 -> 1 -> 2), so after the first
+	// EnsureAll of a frame the next ones have nothing to visit
+	namespace { size_t allFrom = 0; }
+
 	void EnsureAllSlow()
 	{
 		st.all.fetch_add(1, std::memory_order_relaxed);
-		for (size_t k = 0; k < units.size(); ++k)
+		const size_t k0 = ((g_brToggles3 & 0x80000) != 0) ? allFrom : 0;
+		for (size_t k = k0; k < units.size(); ++k)
 			EnsureIdx(k);
+		allFrom = units.size();
 	}
 
 	void Begin(const std::vector<CUnit*>& activeUnits)
@@ -1055,6 +1066,7 @@ namespace BrP8 {
 		}
 		numChunks = int((n + CHUNK - 1) / CHUNK);
 		nextChunk.store(0, std::memory_order_relaxed);
+		allFrom = 0; // [barreplay] H124
 
 		const int nw = ThreadPool::GetNumThreads() - 1;
 		static TaskPool<ForTaskGroup, decltype(workerFn)> pool;
@@ -1093,7 +1105,7 @@ namespace BrP8 {
 				top.emplace_back(e.second, e.first);
 			std::sort(top.begin(), top.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
 			char buf[512];
-			int k = snprintf(buf, sizeof(buf), "[BR_P8] f=%d Lua writes in the loop: ensureAll=%lld skipped(data)=%lld top:", gs->frameNum, luaAll, luaSkipped);
+			int k = snprintf(buf, sizeof(buf), "[BR_P8] f=%d Lua writes in the loop: ensureAll=%lld skipped(data)=%lld quiet(H124)=%lld top:", gs->frameNum, luaAll, luaSkipped, luaQuiet);
 			for (size_t j = 0; j < top.size() && j < 8 && k < int(sizeof(buf)); ++j)
 				k += snprintf(buf + k, sizeof(buf) - k, " %s=%lld", top[j].second, top[j].first);
 			LOG("%s", buf);
