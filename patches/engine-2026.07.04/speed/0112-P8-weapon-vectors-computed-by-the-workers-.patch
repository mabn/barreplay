diff --git a/rts/Sim/Units/BrWeaponVectors.h b/rts/Sim/Units/BrWeaponVectors.h
new file mode 100644
index 0000000..b9b6a5b
--- /dev/null
+++ b/rts/Sim/Units/BrWeaponVectors.h
@@ -0,0 +1,62 @@
+/* This file is part of the Spring engine (GPL v2 or later), see LICENSE.html */
+
+#ifndef BR_WEAPON_VECTORS_H
+#define BR_WEAPON_VECTORS_H
+
+#include <atomic>
+
+// [barreplay] P8 (toggle2 0x200000): the weapon vectors (CUnit::UpdateWeaponVectors:
+// each weapon's aim-from and muzzle positions and direction) computed by the
+// workers, in unit order, WHILE the main thread runs the weapon loop behind
+// them, instead of in a parallel section that has to finish first.
+//
+// In stock every unit's vectors are computed before any weapon updates, from
+// the unit's position, direction vectors, piece matrices, its weapon-use flags
+// (dead, stunned, hold fire, ...) and the height map. The weapon loop changes
+// those for a unit other than the one updating only through what the hooks
+// below see, and each hook first makes the unit's vectors ready (computing
+// them right there if no worker has started them, or waiting for the worker
+// that has), so they come from the same state as in stock:
+//   - damage and kills (DoDamage, ForcedKillUnit: hit-by-weapon and death
+//     scripts move the target's pieces, a kill or a stun clears its weapon-use
+//     flags);
+//   - moves and turns (CSolidObject's position and direction writers), team
+//     changes and transports;
+//   - every Lua write (all units: Lua can change anything).
+// And whatever READS another unit's vectors in the loop makes them ready
+// first: a beam's shield hit (the shield weapon's muzzle), the intercept check
+// a new interceptable projectile runs (every interceptor), Lua's weapon reads.
+// The main thread makes each unit ready before its own weapons update. Units
+// created during the loop get none (stock computed vectors only for the units
+// there before it).
+
+class CUnit;
+class CSolidObject;
+
+extern unsigned g_brToggles2;
+
+namespace BrP8 {
+	// the weapon loop is running with the vectors pipelined
+	extern std::atomic<bool> active;
+
+	void EnsureSlow(const CUnit* unit);
+	void EnsureObjSlow(const CSolidObject* obj);
+	void EnsureAllSlow();
+
+	inline void Ensure(const CUnit* unit) {
+		if (__builtin_expect(active.load(std::memory_order_relaxed), false))
+			EnsureSlow(unit);
+	}
+	// a position or direction writer of any solid object (a feature is no unit
+	// of the loop and is ignored)
+	inline void EnsureObj(const CSolidObject* obj) {
+		if (__builtin_expect(active.load(std::memory_order_relaxed), false))
+			EnsureObjSlow(obj);
+	}
+	inline void EnsureAll() {
+		if (__builtin_expect(active.load(std::memory_order_relaxed), false))
+			EnsureAllSlow();
+	}
+}
+
+#endif
