+// [barreplay] P8 (Sim/Units/BrWeaponVectors.h): the weapon vectors pipelined
+// into the weapon loop
+namespace BrP8 {
+	std::atomic<bool> active{false};
+
+	namespace {
+		std::vector<CUnit*> units;                      // the active units when the loop started
+		std::unique_ptr<std::atomic<uint8_t>[]> state;  // per unit: 0 waiting, 1 being computed, 2 done
+		size_t stateCap = 0;
+		std::vector<int> idxOf;                         // unit id -> index in units (checked against units)
+		std::atomic<int> nextChunk{0};
+		int numChunks = 0;
+		constexpr int CHUNK = 32;
+		struct Stats { long long frames = 0, units = 0, byMain = 0, waits = 0, all = 0; } st;
+		int lastLog = -1000000;
+
+		inline void Compute(size_t k) { units[k]->UpdateWeaponVectors(); }
+
+		// main thread or a hook: this unit's vectors, now
+		void EnsureIdx(size_t k)
+		{
+			if (state[k].load(std::memory_order_acquire) == 2)
+				return;
+			uint8_t z = 0;
+			if (state[k].compare_exchange_strong(z, 1, std::memory_order_acq_rel)) {
+				Compute(k);
+				state[k].store(2, std::memory_order_release);
+				st.byMain += 1;
+				return;
+			}
+			st.waits += 1;
+			while (state[k].load(std::memory_order_acquire) != 2)
+				_mm_pause();
+		}
+
+		void WorkerLoop()
+		{
+			for (int c; (c = nextChunk.fetch_add(1, std::memory_order_acq_rel)) < numChunks; ) {
+				const size_t b = size_t(c) * CHUNK, e = std::min(units.size(), b + CHUNK);
+				for (size_t k = b; k < e; ++k) {
+					uint8_t z = 0;
+					if (state[k].compare_exchange_strong(z, 1, std::memory_order_acq_rel)) {
+						Compute(k);
+						state[k].store(2, std::memory_order_release);
+					}
+				}
+			}
+		}
+
+		auto workerFn = [](const int) { WorkerLoop(); };
+		std::shared_ptr<ForTaskGroup<decltype(workerFn)>> taskGroup;
+	}
+
+	void EnsureSlow(const CUnit* unit)
+	{
+		const int id = unit->id;
+		if (id < 0 || size_t(id) >= idxOf.size())
+			return;
+		const int k = idxOf[id];
+		if (k < 0 || size_t(k) >= units.size() || units[k] != unit)
+			return;
+		EnsureIdx(size_t(k));
+	}
+
+	void EnsureObjSlow(const CSolidObject* obj)
+	{
+		const int id = obj->id;
+		if (id < 0 || size_t(id) >= idxOf.size())
+			return;
+		const int k = idxOf[id];
+		if (k < 0 || size_t(k) >= units.size() || static_cast<const CSolidObject*>(units[k]) != obj)
+			return;
+		EnsureIdx(size_t(k));
+	}
+
+	void EnsureAllSlow()
+	{
+		st.all += 1;
+		for (size_t k = 0; k < units.size(); ++k)
+			EnsureIdx(k);
+	}
+
+	void Begin(const std::vector<CUnit*>& activeUnits)
+	{
+		units = activeUnits;
+		const size_t n = units.size();
+		if (stateCap < n) {
+			stateCap = n + n / 2;
+			state.reset(new std::atomic<uint8_t>[stateCap]);
+		}
+		for (size_t k = 0; k < n; ++k)
+			state[k].store(0, std::memory_order_relaxed);
+		if (idxOf.size() != size_t(unitHandler.MaxUnits()))
+			idxOf.assign(unitHandler.MaxUnits(), -1);
+		for (size_t k = 0; k < n; ++k)
+			idxOf[units[k]->id] = int(k);
+		numChunks = int((n + CHUNK - 1) / CHUNK);
+		nextChunk.store(0, std::memory_order_relaxed);
+
+		const int nw = ThreadPool::GetNumThreads() - 1;
+		static TaskPool<ForTaskGroup, decltype(workerFn)> pool;
+		taskGroup = pool.GetTaskGroup();
+		taskGroup->Enqueue(0, nw, 1, workerFn);
+		taskGroup->UpdateId();
+		for (int i = 1; i <= nw; ++i) {
+			taskGroup->wantedThread.store(i);
+			ThreadPool::PushTaskGroup(taskGroup);
+		}
+		ThreadPool::NotifyWorkerThreads(true, false);
+		active.store(true, std::memory_order_release);
+	}
+
+	void End()
+	{
+		// whatever nobody reached (units the loop never got to after a late
+		// creation, the tail when the workers fell behind)
+		for (size_t k = 0; k < units.size(); ++k)
+			EnsureIdx(k);
+		active.store(false, std::memory_order_release);
+		{
+			MultithreadedSection mtSection;
+			ThreadPool::WaitForFinished(taskGroup);
+		}
+		taskGroup.reset();
+		st.frames += 1;
+		st.units += units.size();
+		if ((gs->frameNum - lastLog) >= 900 && getenv("BARREPLAY_P8_STATS") != nullptr) {
+			lastLog = gs->frameNum;
+			LOG("[BR_P8] f=%d pipelined frames=%lld avgUnits=%.0f byMain/frame=%.1f waits/frame=%.2f ensureAll/frame=%.2f",
+				gs->frameNum, st.frames, double(st.units) / st.frames, double(st.byMain) / st.frames,
+				double(st.waits) / st.frames, double(st.all) / st.frames);
+		}
+	}
+}
+
 void CUnitHandler::UpdateUnitWeapons()
 {
-	{
+	// [barreplay] P8 (toggle2 0x200000): the vectors computed by the workers
+	// while the weapon loop runs behind them (BrWeaponVectors.h); from 2048 units
+	const bool brP8On = (g_brToggles2 & 0x200000) != 0 && activeUnits.size() >= 2048
+		&& ThreadPool::HasThreads() && !ThreadPool::IsInMultiThreadedSection();
+	if (brP8On) {
+		BrP8::Begin(activeUnits);
+	} else {
 		SCOPED_TIMER("Sim::Unit::UpdateWeaponVectors");
 
 		for_mt_chunk(0, activeUnits.size(), [&](const int idx) {
@@ -862,12 +1006,16 @@ void CUnitHandler::UpdateUnitWeapons()
 					}
 				}
 			}
+			if (brP8On)
+				BrP8::Ensure(activeUnits[activeUpdateUnit]);
 			activeUnits[activeUpdateUnit]->UpdateWeapons();
 			if (brFirstLua < 0 && g_brLuaWrites != brLua0)
 				brFirstLua = (long long) activeUpdateUnit;
 		}
 		BrRunAhead::End();
 	}
+	if (brP8On)
+		BrP8::End();
 	brP8.frames += 1;
 	brP8.units += activeUnits.size();
 	brP8.luaWrites += (g_brLuaWrites - brLua0);
