+	void LaunchFighters(const std::vector<CUnit*>& units, size_t beg, size_t end)
+	{
+		if ((g_brToggles2 & 0x1000000) == 0)
+			return;
+
+		for (size_t i = beg; i < end; ++i) {
+			const CUnit* u = units[i];
+			if (!u->unitDef->IsFighterAirUnit() || u->isDead)
+				continue;
+			const CAirCAI* cai = dynamic_cast<const CAirCAI*>(u->commandAI);
+			if (cai == nullptr)
+				continue;
+
+			float3 pos;
+			float radius;
+			if (!cai->BrPredictEnemyAircraftQuery(pos, radius))
+				continue;
+
+			const int n = published.load(std::memory_order_relaxed);
+			if (n >= MAX_TASKS)
+				return;
+
+			Task& t = tasks[n];
+			t.w = nullptr;
+			t.kind = 2;
+			t.slave = false;
+			t.avoid = nullptr;
+			t.cx = pos.x;
+			t.cz = pos.z;
+			t.r = radius;
+			t.ownerAlly = u->allyteam;
+			t.result = nullptr;
+			t.checkResult = nullptr;
+			t.qpos = pos;
+			t.owner = u;
+			t.epoch = p10Epoch;
+			t.done.store(0, std::memory_order_relaxed);
+
+			if (size_t(u->id) >= p10Task.size()) {
+				p10Task.resize(u->id + 1, -1);
+				p10Slice.resize(u->id + 1, -1);
+			}
+			p10Task[u->id] = n;
+			p10Slice[u->id] = st.slices;
+
+			published.store(n + 1, std::memory_order_release);
+			p10.launched++;
+		}
+	}
+
+	CUnit* FighterQuery(const CUnit* owner, const float3& pos, float radius, int allyTeam)
+	{
+		if (Active() && (g_brToggles2 & 0x1000000) != 0) {
+			const int id = owner->id;
+
+			if (size_t(id) < p10Task.size() && p10Slice[id] == st.slices) {
+				const int i = p10Task[id];
+				Task& t = tasks[i];
+
+				if (t.kind != 2 || t.owner != owner) {
+					p10.none++;
+				} else if (t.epoch != p10Epoch) {
+					p10.stale++;
+				} else if (std::memcmp(&t.qpos, &pos, sizeof(float3)) != 0 || std::memcmp(&t.r, &radius, sizeof(float)) != 0 || t.ownerAlly != allyTeam) {
+					p10.args++;
+				} else {
+					Complete(i);
+					p10.used++;
+
+					if (check) {
+						// the search in order, which also draws its tempNum
+						CUnit* ref = CGameHelper::GetClosestEnemyAircraft(nullptr, pos, radius, allyTeam);
+						if (ref != t.result) {
+							p10.mismatches++;
+							LOG_L(L_WARNING, "[BR_P10] mismatch f=%d unit %d: pipelined %d, in order %d", gs->frameNum, id, (t.result != nullptr)? t.result->id: -1, (ref != nullptr)? ref->id: -1);
+						}
+						return ref;
+					}
+
+					// the synced tempNum the search would have drawn
+					gs->GetTempNum();
+					return t.result;
+				}
+			} else {
+				p10.none++;
+			}
+		}
+
+		return CGameHelper::GetClosestEnemyAircraft(nullptr, pos, radius, allyTeam);
+	}
