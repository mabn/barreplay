+// [barreplay] P10: ExecuteFight's (and AirAutoGenerateTarget's) way to the
+// search, replayed on copies; an argument that comes out different later just
+// means the precomputed answer is not used
+bool CAirCAI::BrPredictEnemyAircraftQuery(float3& pos, float& radius) const
+{
+	const UnitDef* ownerDef = owner->unitDef;
+
+	if (!ownerDef->IsFighterAirUnit() || owner->UsingScriptMoveType())
+		return false;
+	if (!(owner->fireState >= FIRESTATE_FIREATWILL && owner->moveState != MOVESTATE_HOLDPOS && owner->maxRange > 0.0f && ownerDef->canAttack))
+		return false;
+
+	if (commandQue.empty()) {
+		// AirAutoGenerateTarget (a Lua callin may still change the radius)
+		if (owner->weapons.empty())
+			return false;
+		pos = owner->pos + owner->speed * 10.0f;
+		radius = 1000.0f * owner->moveState;
+		return true;
+	}
+
+	const Command& c = commandQue.front();
+	if (c.GetID() != CMD_FIGHT || c.GetNumParams() < 3 || c.GetTimeOut() < gs->frameNum)
+		return false;
+
+	int inCmd = inCommand;
+	if (tempOrder)
+		inCmd = CMD_FIGHT;
+
+	float3 cp1 = commandPos1;
+	float3 cp2 = commandPos2;
+
+	if (c.GetNumParams() >= 6) {
+		if (inCmd == CMD_STOP)
+			cp1 = c.GetPos(3);
+	} else {
+		cp1 = ClosestPointOnLine(cp1, cp2, owner->pos);
+
+		if ((owner->pos - cp1).SqLength2D() > Square(150.0f))
+			cp1 = owner->pos;
+	}
+
+	if (inCmd == CMD_STOP)
+		cp2 = c.GetPos(0);
+
+	const float3 ofs = owner->speed * 10.0f;
+	pos = ClosestPointOnLine(cp1, cp2, owner->pos + ofs);
+	radius = 1000.0f * owner->moveState;
+	return true;
+}
