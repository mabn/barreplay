+// [barreplay] P10 (Sim/Weapons/BrPipeTarget.h): GetClosestEnemyAircraft(nullptr,
+// ...) run on a pool thread. QueryUnits' walk in the same order with the same
+// filter and the same closest-unit rule, so the same answer; units are marked
+// with the thread's own numbers (as GenerateWeaponTargets does there), not the
+// synced tempNum, and the quad query uses the thread's pools
+CUnit* CGameHelper::BrClosestEnemyAircraftMt(const float3& pos, float searchRadius, int searchAllyteam, int thread)
+{
+	Query::ClosestUnit q(pos, searchRadius);
+	Filter::EnemyAircraft filter(nullptr, searchAllyteam);
+
+	QuadFieldQuery qfQuery;
+	qfQuery.threadOwner = thread;
+	quadField.GetQuads(qfQuery, q.pos, q.radius);
+	const int tempNum = gs->GetMtTempNum(thread);
+
+	for (int t = 0; t < teamHandler.ActiveAllyTeams(); ++t) {
+		if (!filter.Team(t))
+			continue;
+
+		for (const int qi: *qfQuery.quads) {
+			for (CUnit* u: quadField.GetQuad(qi).teamUnits[t]) {
+				int& mark = u->mtTempNum[thread];
+				if (mark == tempNum)
+					continue;
+
+				mark = tempNum;
+
+				if (!filter.Unit(u))
+					continue;
+
+				q.AddUnit(u);
+			}
+		}
+	}
+
+	return q.GetClosestUnit();
+}
