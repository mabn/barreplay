@@ -14,6 +14,7 @@ set(sources_engine_Lua
 		"${CMAKE_CURRENT_SOURCE_DIR}/LuaVFSDownload.cpp"
 		"${CMAKE_CURRENT_SOURCE_DIR}/LuaEncoding.cpp"
