From f29a37a3f712cfa4d3bbc4a323e520e5b6ef1b9c Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Sat, 17 Oct 2026 18:12:58 +0000
Subject: [PATCH 43/43] H80: FindAnim's binary search on one packed 64-bit key
 (toggle 0x4000)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rts/Sim/Units/Scripts/UnitScript.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/rts/Sim/Units/Scripts/UnitScript.cpp b/rts/Sim/Units/Scripts/UnitScript.cpp
index fa2e8d6..28a1575 100644
--- a/rts/Sim/Units/Scripts/UnitScript.cpp
+++ b/rts/Sim/Units/Scripts/UnitScript.cpp
@@ -397,6 +397,22 @@ CUnitScript::AnimContainerTypeIt CUnitScript::FindAnim(AnimType type, int piece,
 	// appended or swap-erased since) a binary search finds it; otherwise a scan
 	// with ONE branch per element, where the short-circuit && took up to three
 	// data-dependent ones (this is among the top branch-miss sites of a re-sim).
+	if (!animsDirty && (g_brToggles & 0x4000) != 0) {
+		// [barreplay] H80 (toggle 0x4000): the same search on one 64-bit key that
+		// orders exactly like the tuple for piece >= -2^30 and type, axis >= -2^14
+		// (the values are a piece index, 0..3 and 0..2): one compare per step
+		// instead of up to three dependent branches.
+		const auto keyOf = [](int pc, int ty, int ax) {
+			return (uint64_t(uint32_t(pc + 0x40000000)) << 32) | (uint64_t(uint16_t(ty + 0x4000)) << 16) | uint64_t(uint16_t(ax + 0x4000));
+		};
+		const uint64_t key = keyOf(piece, type, axis);
+		const auto it = std::lower_bound(anims.begin(), anims.end(), key, [&keyOf](const AnimInfo& ai, uint64_t k) {
+			return keyOf(ai.piece, ai.animType, ai.axis) < k;
+		});
+		if (it != anims.end() && it->piece == piece && it->animType == type && it->axis == axis)
+			return it;
+		return anims.end();
+	}
 	if (!animsDirty) {
 		const auto key = std::make_tuple(piece, type, axis);
 		const auto it = std::lower_bound(anims.begin(), anims.end(), key, [](const AnimInfo& ai, const auto& k) {
