index e77491f..8cfa01e 100644
--- a/rts/Sim/Projectiles/ProjectileHandler.cpp
+++ b/rts/Sim/Projectiles/ProjectileHandler.cpp
@@ -4,6 +4,10 @@
 
 #include "Projectile.h"
 #include "ProjectileHandler.h"
+#include "Map/ReadMap.h"
+#include "Sim/Weapons/BrPipeTarget.h"
+#include "BrPreCollide.h"
+#include "Sim/Units/BrWeaponVectors.h"
 #include <x86intrin.h>
 #include <cstdio>
 #include "ProjectileMemPool.h"
@@ -578,12 +582,151 @@ void CProjectileHandler::CheckShieldCollisions(
 namespace {
 	struct BrP12Stats { long long checked[2] = {}, candidates[2] = {}, hits[2] = {}, cycles[2] = {}, passes = 0; } brP12;
 }
-void BrP12Reset() { brP12 = BrP12Stats(); }
+// [barreplay] P12 (BrPreCollide.h)
+bool g_brP12Active = false;
+extern unsigned g_brToggles3;
+namespace {
+	namespace BrP12 {
+		constexpr int CELL = 256; // elmos
+		int cellsX = 0, cellsZ = 0;
+		std::vector<uint32_t> cells;  // the pass that last marked the cell
+		uint32_t pass = 0;
+		bool global = false;
+		long long skipped = 0, dirty = 0, acting = 0, prepassed = 0;
+		// check mode (BARREPLAY_P12_CHECK): a would-be skip runs the ordinary
+		// code, which must then do nothing (no mark, no collision)
+		long long marks = 0, checked = 0, wrong = 0;
+		bool CheckMode() {
+			static const bool c = (getenv("BARREPLAY_P12_CHECK") != nullptr);
+			return c;
+		}
+
+		// what the detection was run with: a skip also needs the projectile's
+		// own position, speed and radius unchanged
+		struct Pre { const CProjectile* p; float3 pos; float3 spd; float r; uint8_t acts; };
+		bool Same(const Pre& e, const CProjectile* p) {
+			// exact (float3's == allows an epsilon)
+			return e.p == p && e.pos.x == p->pos.x && e.pos.y == p->pos.y && e.pos.z == p->pos.z
+				&& e.spd.x == p->speed.x && e.spd.y == p->speed.y && e.spd.z == p->speed.z
+				&& e.r == p->speed.w + p->radius;
+		}
+		std::vector<Pre> pre;
+
+		void MarkBox(float x0, float z0, float x1, float z1) {
+			marks += 1;
+			const int cx0 = std::clamp(int(x0) / CELL, 0, cellsX - 1), cx1 = std::clamp(int(x1) / CELL, 0, cellsX - 1);
+			const int cz0 = std::clamp(int(z0) / CELL, 0, cellsZ - 1), cz1 = std::clamp(int(z1) / CELL, 0, cellsZ - 1);
+			for (int z = cz0; z <= cz1; ++z)
+				for (int x = cx0; x <= cx1; ++x)
+					cells[z * cellsX + x] = pass;
+		}
+		void MarkSphere(const float3& c, float r) {
+			r += 2.0f * SQUARE_SIZE; // slack for float rounding at cell edges
+			MarkBox(c.x - r, c.z - r, c.x + r, c.z + r);
+		}
+		bool Dirty(const float3& c, float r) {
+			if (global)
+				return true;
+			r += 2.0f * SQUARE_SIZE;
+			const int cx0 = std::clamp(int(c.x - r) / CELL, 0, cellsX - 1), cx1 = std::clamp(int(c.x + r) / CELL, 0, cellsX - 1);
+			const int cz0 = std::clamp(int(c.z - r) / CELL, 0, cellsZ - 1), cz1 = std::clamp(int(c.z + r) / CELL, 0, cellsZ - 1);
+			for (int z = cz0; z <= cz1; ++z)
+				for (int x = cx0; x <= cx1; ++x)
+					if (cells[z * cellsX + x] == pass)
+						return true;
+			return false;
+		}
+		size_t MinProjectiles() {
+			static const size_t m = []() { const char* v = getenv("BARREPLAY_P12_MINPROJ"); return (v != nullptr)? size_t(atoi(v)): size_t(256); }();
+			return m;
+		}
+	}
+}
+
+// a unit's sphere as the collision query sees it (its volume's world centre and
+// bounding radius), and as wide as the unit itself
+void BrP12MarkUnitSlow(const CUnit* u) {
+	const auto* cv = &u->collisionVolume;
+	BrP12::MarkSphere(cv->GetWorldSpacePos(u), std::max(cv->GetBoundingRadius(), u->radius));
+	BrP12::MarkSphere(u->pos, std::max(cv->GetBoundingRadius(), u->radius));
+	// a stun turns its shields off, a death removes them
+	for (const CWeapon* w: u->weapons)
+		if (w->weaponDef->isShield)
+			BrP12MarkShieldSlow(static_cast<const CPlasmaRepulser*>(w));
+}
+void BrP12MarkFeatureSlow(const CFeature* f) {
+	const auto* cv = &f->collisionVolume;
+	BrP12::MarkSphere(cv->GetWorldSpacePos(f), std::max(cv->GetBoundingRadius(), f->radius));
+	BrP12::MarkSphere(f->pos, std::max(cv->GetBoundingRadius(), f->radius));
+}
+void BrP12MarkShieldSlow(const CPlasmaRepulser* r) {
+	BrP12::MarkSphere(r->weaponMuzzlePos, r->collisionVolume.GetBoundingRadius());
+}
+void BrP12GlobalSlow() { BrP12::global = true; BrP12::marks += 1; }
+
+// the three checks below without their effects: would this projectile reach a
+// shield's IncomingProjectile, or hit a unit or a feature?
+static bool CheckProjectileCollisionFlags(const CProjectile* p, const CUnit* u);
+static bool BrP12WouldAct(CProjectile* p, const std::vector<CUnit*>& units, const std::vector<CFeature*>& features, const std::vector<CPlasmaRepulser*>& repulsers, const float3 ppos0, const float3 ppos1)
+{
+	if (!p->checkCol)
+		return false;
+
+	CollisionQuery cq;
+
+	if (p->weapon) {
+		CWeaponProjectile* wpro = static_cast<CWeaponProjectile*>(p);
+		const WeaponDef* wdef = wpro->GetWeaponDef();
+		const unsigned int interceptType = wdef->interceptedByShieldType;
+		const unsigned int projAllyTeam = p->GetAllyteamID();
+
+		if (interceptType != 0) {
+			for (CPlasmaRepulser* repulser: repulsers) {
+				if (!repulser->CanIntercept(interceptType, projAllyTeam))
+					continue;
+				const float3 rpvec  = ppos0 - ppos1;
+				const float3 rppos0 = ppos0 + rpvec * repulser->GetDeltaDist();
+				const float3 cvpos  = repulser->weaponMuzzlePos - repulser->owner->relMidPos;
+				if (!CCollisionHandler::DetectHit(repulser->owner, &repulser->collisionVolume, CMatrix44f{cvpos}, rppos0, ppos1, &cq))
+					continue;
+				if (cq.InsideHit() && repulser->IgnoreInteriorHit(wpro))
+					continue;
+				return true;
+			}
+		}
+	}
+
+	for (CUnit* unit: units) {
+		if (unit == p->owner())
+			continue;
+		if (!unit->HasCollidableStateBit(CSolidObject::CSTATE_BIT_PROJECTILES))
+			continue;
+		if (!CheckProjectileCollisionFlags(p, unit))
+			continue;
+		if (CCollisionHandler::DetectHit(unit, unit->GetTransformMatrix(true), ppos0, ppos1, &cq))
+			return true;
+	}
+
+	if ((p->GetCollisionFlags() & Collision::NOFEATURES) != 0)
+		return false;
+
+	for (CFeature* feature: features) {
+		if (!feature->HasCollidableStateBit(CSolidObject::CSTATE_BIT_PROJECTILES))
+			continue;
+		if (CCollisionHandler::DetectHit(feature, feature->GetTransformMatrix(true), ppos0, ppos1, &cq))
+			return true;
+	}
+
+	return false;
+}
+
+void BrP12Reset() { brP12 = BrP12Stats(); BrP12::prepassed = BrP12::skipped = BrP12::dirty = BrP12::acting = BrP12::checked = BrP12::wrong = 0; }
