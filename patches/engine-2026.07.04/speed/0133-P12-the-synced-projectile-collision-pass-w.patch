+	return snprintf(buf, size, "[BR_P12] passes=%lld synced: checked=%lld candidates=%lld hits=%lld Mcyc=%.1f unsynced: checked=%lld candidates=%lld hits=%lld Mcyc=%.1f pre: prepassed=%lld skipped=%lld dirty=%lld acting=%lld check=%lld wrong=%lld ",
 		brP12.passes, brP12.checked[1], brP12.candidates[1], brP12.hits[1], brP12.cycles[1] / 1e6,
-		brP12.checked[0], brP12.candidates[0], brP12.hits[0], brP12.cycles[0] / 1e6);
+		brP12.checked[0], brP12.candidates[0], brP12.hits[0], brP12.cycles[0] / 1e6,
+		BrP12::prepassed, BrP12::skipped, BrP12::dirty, BrP12::acting, BrP12::checked, BrP12::wrong);
 }
 
 void CProjectileHandler::CheckUnitFeatureCollisions(bool synced)
@@ -595,6 +738,45 @@ void CProjectileHandler::CheckUnitFeatureCollisions(bool synced)
 	const unsigned long long brT0 = __rdtsc();
 	brP12.passes += synced;
 
+	// [barreplay] P12: the detections first, on all threads
+	const size_t brN = projectiles[synced].size();
+	const bool brPre = synced && (g_brToggles3 & 0x2) != 0 && brN >= BrP12::MinProjectiles()
+		&& ThreadPool::HasThreads() && !ThreadPool::IsInMultiThreadedSection()
+		&& !BrP8::active.load(std::memory_order_relaxed);
+	if (brPre) {
+		if (BrP12::cells.empty()) {
+			BrP12::cellsX = std::max(1, (mapDims.mapx * SQUARE_SIZE + BrP12::CELL - 1) / BrP12::CELL);
+			BrP12::cellsZ = std::max(1, (mapDims.mapy * SQUARE_SIZE + BrP12::CELL - 1) / BrP12::CELL);
+			BrP12::cells.assign(size_t(BrP12::cellsX) * BrP12::cellsZ, 0);
+		}
+		BrP12::pass += 1;
+		BrP12::global = false;
+		BrP12::pre.resize(brN);
+
