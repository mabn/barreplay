+/* This file is part of the Spring engine (GPL v2 or later), see LICENSE.html */
+
+#ifndef BR_PRE_COLLIDE_H
+#define BR_PRE_COLLIDE_H
+
+// [barreplay] P12 (toggle3 0x2): the synced projectile collision pass
+// (CProjectileHandler::CheckUnitFeatureCollisions) with its detections run on
+// all threads first. A projectile whose detection found nothing to act on (no
+// shield it would reach, no unit or feature it would hit) is skipped in the
+// pass, drawing the synced tempNum its query would have, as long as nothing the
+// detection read can have changed since: every effect of the pass marks the
+// cells of a coarse grid it may have touched (a damaged or killed unit, an
+// added or removed feature, a shield taking a projectile), and a skip needs
+// the cells under its query to be unmarked. A Lua write (other than rules
+// params and team resources) or a unit changing quads marks everything. Every
+// other projectile runs the ordinary code. From 256 projectiles
+// (BARREPLAY_P12_MINPROJ).
+
+class CUnit;
+class CFeature;
+class CPlasmaRepulser;
+struct float3;
+
+extern bool g_brP12Active;
+
+void BrP12MarkUnitSlow(const CUnit* u);
+void BrP12MarkFeatureSlow(const CFeature* f);
+void BrP12MarkShieldSlow(const CPlasmaRepulser* r);
+void BrP12GlobalSlow();
+
+inline void BrP12MarkUnit(const CUnit* u) { if (__builtin_expect(g_brP12Active, false)) BrP12MarkUnitSlow(u); }
+inline void BrP12MarkFeature(const CFeature* f) { if (__builtin_expect(g_brP12Active, false)) BrP12MarkFeatureSlow(f); }
+inline void BrP12MarkShield(const CPlasmaRepulser* r) { if (__builtin_expect(g_brP12Active, false)) BrP12MarkShieldSlow(r); }
+inline void BrP12Global() { if (__builtin_expect(g_brP12Active, false)) BrP12GlobalSlow(); }
+
+#endif
