diff --git a/rts/Sim/Misc/BrLosJoin.h b/rts/Sim/Misc/BrLosJoin.h
index 4b8293e..dc983ab 100644
--- a/rts/Sim/Misc/BrLosJoin.h
+++ b/rts/Sim/Misc/BrLosJoin.h
@@ -21,4 +21,34 @@ static inline void BrLosJoin() {
 		BrLosJoinSlow();
 }
 
+
+// [barreplay] P3 (toggle 0x20000): while CUnitHandler::SlowUpdateUnits runs its
+// serial loop with targeting scans precomputed (CGameHelper::GenerateWeaponTargets),
+// every write to what a scan read marks the unit, the quad or everything as
+// changed, and a scan whose inputs were touched is done again the old way.
+extern bool g_brScanActive;
+extern bool g_brScanAllDirty;
+extern unsigned char* g_brScanUnitDirty;
+extern int g_brScanUnitDirtyN;
+extern unsigned char* g_brScanQuadDirty;
+static inline void BrScanTouchObject(int id) {
+	// solid objects: a feature's id can coincide with a unit's, which only
+	// costs that unit's scans a needless recompute
+	if (__builtin_expect(g_brScanActive, 0) && unsigned(id) < unsigned(g_brScanUnitDirtyN))
+		g_brScanUnitDirty[id] = 1;
+}
+static inline void BrScanTouchQuad(int qi) {
+	if (__builtin_expect(g_brScanActive, 0))
+		g_brScanQuadDirty[qi] = 1;
+}
+static inline void BrScanTouchAll() {
+	if (__builtin_expect(g_brScanActive, 0))
+		g_brScanAllDirty = true;
+}
+// a synced write that may reach anything (Lua control functions, COB set-value)
+static inline void BrSyncedWrite() {
+	BrLosJoin();
+	BrScanTouchAll();
+}
+
 #endif
