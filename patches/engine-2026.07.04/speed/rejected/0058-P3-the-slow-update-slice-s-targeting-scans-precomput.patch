+// [barreplay] P3 (toggle 0x20000): the targeting scans of a slow-update slice,
+// precomputed on all threads before the slice's serial loop and replayed in it.
+//
+// A scan visits, team by team, the enemy units in the quads around the weapon
+// owner, in quad and list order, the first occurrence of each counting. What
+// it reads of each candidate before rejecting most of them is the LOS state
+// for the owner's ally team and the target position (aimPos, or the radar
+// position with the weapon's error). The precompute records every unit of
+// every enemy team in a slightly LARGER set of quads (GetQuads of a larger
+// radius returns a superset, in the same order), with those two values. The
+// replay takes the exact quads, keeps the first occurrence of each unit in
+// them, and gives each to the same scoring as the scan (BrScoreCandidate), in
+// the same order, so the same AllowWeaponTarget calls are made and the same
+// list comes out.
+//
+// It is only valid if nothing the precompute read changed before the replay:
+// the hooks in BrLosJoin.h mark a unit when its LOS state or mid/aim position
+// is written, a quad when its unit lists change, and everything on a synced Lua
+// control call, a COB set-value, a team change or a radar error size change.
+// The replay also requires the owner unmarked and at the same position, its
+// exact radius inside the precomputed one, and the weapon's error vector,
+// ground-target flag and move-error experience as they were. Otherwise the
+// weapon scans the old way.
+//
+// Not done in the replay: the scan's tempNum marks (each scan takes a fresh
+// tempNum, and nothing compares a unit's mark against an older number), so
+// gs->GetTempNum() is still called once to keep the counter where it was.
+bool g_brScanActive = false;
+bool g_brScanAllDirty = false;
+unsigned char* g_brScanUnitDirty = nullptr;
+int g_brScanUnitDirtyN = 0;
+unsigned char* g_brScanQuadDirty = nullptr;
+
+namespace BrScan {
+	struct Occ {
+		CUnit* unit;
+		int quad;
+		unsigned short los;
+		float3 tpos;
+	};
+	struct Entry {
+		const CWeapon* weapon = nullptr;
+		float3 ownerPos;
+		float superRadius = 0.0f;
+		float3 errorVector;
+		float moveErrorExp = 0.0f;
+		bool doTargetGroundPos = false;
+		std::vector<int> quads;
+		std::vector<Occ> occ;
+	};
+
+	static std::vector<Entry> entries;
+	static int numEntries = 0;
+	static std::vector<int> unitEntryBeg;
+	static int curPos = -1;
+
+	static std::vector<unsigned char> unitDirty;
+	static std::vector<unsigned char> quadDirty;
+	static std::vector<unsigned> quadExact;
+	static unsigned quadSerial = 0;
+	static std::vector<unsigned> unitSeen;
+	static unsigned unitSerial = 0;
+	static std::vector<const Occ*> firsts;
+
+	static long long statReplays = 0, statFallbacks = 0;
+	static const bool stats = (getenv("BARREPLAY_P3_STATS") != nullptr);
+
+	// worth precomputing: the weapon can reach AutoTarget's scan this slow update
+	static bool Candidate(const CWeapon* w) {
+		if (w->weaponDef->noAutoTarget || w->noAutoTarget)
+			return false;
+		if (w->slavedTo != nullptr || w->weaponDef->interceptor)
+			return false;
+		return (w->owner->fireState >= FIRESTATE_FIREATWILL);
+	}
+
+	// margin on the aim height the scan radius is computed from: the weapon's
+	// aim point is recomputed in its own SlowUpdate (pieces animated, owner moved
+	// since the last computation); a replay needing more falls back
+	static constexpr float AIM_MARGIN = 64.0f;
+
+	static void Fill(Entry& e) {
+		const CWeapon* weapon = e.weapon;
+		const CUnit* owner = weapon->owner;
+
+		BrScanCtx c = BrMakeScanCtx(weapon, nullptr);
+		e.ownerPos = c.ownerPos;
+		e.errorVector = weapon->errorVector;
+		e.moveErrorExp = weapon->MoveErrorExperience();
+		e.doTargetGroundPos = weapon->doTargetGroundPos;
+
+		c.aimPosHeight += AIM_MARGIN;
+		const float r1 = BrScanRadius(c);
+		c.aimPosHeight -= 2.0f * AIM_MARGIN;
+		const float r2 = BrScanRadius(c);
+		e.superRadius = std::max(r1, r2);
+
+		QuadFieldQuery qfQuery;
+		quadField.GetQuads(qfQuery, e.ownerPos, e.superRadius);
+		e.quads.assign(qfQuery.quads->begin(), qfQuery.quads->end());
+		e.occ.clear();
+
+		for (int t = 0; t < teamHandler.ActiveAllyTeams(); ++t) {
+			if (teamHandler.Ally(owner->allyteam, t))
+				continue;
+
+			for (const int qi: e.quads) {
+				for (CUnit* u: quadField.GetQuad(qi).teamUnits[t]) {
+					Occ o;
+					o.unit = u;
+					o.quad = qi;
+					o.los = u->losStatus[owner->allyteam];
+					if (o.los & LOS_INLOS)
+						o.tpos = u->aimPos;
+					else if (o.los & LOS_INRADAR)
+						o.tpos = weapon->GetUnitPositionWithError(u);
+					e.occ.push_back(o);
+				}
+			}
+		}
+	}
+
+	void Begin(const std::vector<CUnit*>& units, size_t beg, size_t end) {
+		numEntries = 0;
+		unitEntryBeg.assign(end - beg + 1, 0);
+		for (size_t p = beg; p < end; ++p) {
+			unitEntryBeg[p - beg] = numEntries;
+			for (const CWeapon* w: units[p]->weapons) {
+				if (!Candidate(w))
+					continue;
+				if (size_t(numEntries) >= entries.size())
+					entries.emplace_back();
+				entries[numEntries++].weapon = w;
+			}
+		}
+		unitEntryBeg[end - beg] = numEntries;
+
+		for_mt_chunk(0, numEntries, [](const int k) { Fill(entries[k]); }, 1, 16);
+
+		unitDirty.assign(unitHandler.MaxUnits(), 0);
+		quadDirty.assign(quadField.GetNumQuadsX() * quadField.GetNumQuadsZ(), 0);
+		if (quadExact.size() != quadDirty.size())
+			quadExact.assign(quadDirty.size(), 0);
+		if (unitSeen.size() != unitDirty.size())
+			unitSeen.assign(unitDirty.size(), 0);
+
+		g_brScanUnitDirty = unitDirty.data();
+		g_brScanUnitDirtyN = int(unitDirty.size());
+		g_brScanQuadDirty = quadDirty.data();
+		g_brScanAllDirty = false;
+		curPos = -1;
+		g_brScanActive = true;
+	}
+
+	void SetPos(int p) { curPos = p; }
 
-	const bool paralyzer = (weaponDmg->paralyzeDamageTime != 0);
+	void End() {
+		g_brScanActive = false;
+		curPos = -1;
+		if (stats && (gs->frameNum % 1800) == 0) {
+			LOG("[P3] frame %d: %lld replays, %lld fallbacks", gs->frameNum, statReplays, statFallbacks);
+			statReplays = statFallbacks = 0;
+		}
+	}
+
+	static const Entry* Find(const CWeapon* weapon) {
+		if (curPos < 0 || size_t(curPos + 1) >= unitEntryBeg.size())
+			return nullptr;
+		for (int k = unitEntryBeg[curPos]; k < unitEntryBeg[curPos + 1]; ++k) {
+			if (entries[k].weapon == weapon)
+				return &entries[k];
+		}
+		return nullptr;
+	}
+
+	// the scan from the precomputed occurrences, or false (nothing done) if they
+	// may not be what the scan would read now
+	static bool Replay(const CWeapon* weapon, const CUnit* avoidUnit, std::vector<std::pair<float, CUnit*>>& targets) {
+		if (!g_brScanActive || g_brScanAllDirty)
+			return false;
+		const Entry* e = Find(weapon);
+		if (e == nullptr)
+			return false;
+
+		const CUnit* owner = weapon->owner;
+		if (unitDirty[owner->id] != 0 || !owner->pos.bitExactEquals(e->ownerPos))
+			return false;
+		if (!weapon->errorVector.bitExactEquals(e->errorVector) || weapon->doTargetGroundPos != e->doTargetGroundPos)
+			return false;
+		const float mee = weapon->MoveErrorExperience();
+		if (std::memcmp(&mee, &e->moveErrorExp, sizeof(float)) != 0)
+			return false;
+
+		const BrScanCtx c = BrMakeScanCtx(weapon, avoidUnit);
+		const float scanRadius = BrScanRadius(c);
+		if (!(scanRadius <= e->superRadius))
+			return false;
+
+		QuadFieldQuery qfQuery;
+		quadField.GetQuads(qfQuery, c.ownerPos, scanRadius);
+
+		if (++quadSerial == 0) {
+			std::fill(quadExact.begin(), quadExact.end(), 0);
+			quadSerial = 1;
+		}
+		for (const int qi: *qfQuery.quads) {
+			if (quadDirty[qi] != 0)
+				return false;
+			quadExact[qi] = quadSerial;
+		}
+
+		// first pass: the occurrences the scan would see first, all unchanged
+		if (++unitSerial == 0) {
+			std::fill(unitSeen.begin(), unitSeen.end(), 0);
+			unitSerial = 1;
+		}
+		firsts.clear();
+		for (const Occ& o: e->occ) {
+			if (quadExact[o.quad] != quadSerial)
+				continue;
+			const int id = o.unit->id;
+			if (unitSeen[id] == unitSerial)
+				continue;
+			unitSeen[id] = unitSerial;
+			if (unitDirty[id] != 0)
+				return false;
+			firsts.push_back(&o);
+		}
+
+		// second pass: the scan's own work on each, in its order
+		gs->GetTempNum();
+		targets.clear();
+		targets.reserve(32);
+
+		for (const Occ* o: firsts) {
+			float targetPriority = tgtPriorityMults[(o->unit == avoidUnit) * 1];
+			if (o->los & LOS_INLOS) {
+			} else if (o->los & LOS_INRADAR) {
+				targetPriority *= tgtPriorityMults[1];
+			} else {
+				continue;
+			}
+			BrScoreCandidate(c, o->unit, o->los, o->tpos, targetPriority, targets, nullptr);
+		}
+
+		std::stable_sort(targets.begin(), targets.end(), [](const std::pair<float, CUnit*>& a, const std::pair<float, CUnit*>& b) { return (a.first < b.first); });
+		return true;
+	}
+}
+
+void BrScanBegin(const std::vector<CUnit*>& units, size_t beg, size_t end) { BrScan::Begin(units, beg, end); }
+void BrScanSetPos(int p) { BrScan::SetPos(p); }
+void BrScanEnd() { BrScan::End(); }
