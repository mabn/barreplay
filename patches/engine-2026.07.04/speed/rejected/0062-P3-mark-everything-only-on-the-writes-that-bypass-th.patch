From 6fbf0aa6c22d08a0be8c8060d1bddccd73d5fe6e Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Sun, 18 Oct 2026 02:47:11 +0000
Subject: [PATCH 62/62] P3: mark everything only on the writes that bypass the
 hooked setters (four Lua controls, alliances, teams, radar errors), not on
 every Lua control call

---
 rts/Game/GameHelper.cpp                 |   7 +-
 rts/Lua/LuaSyncedCtrl.cpp               | 380 ++++++++++++------------
 rts/Lua/LuaSyncedMoveCtrl.cpp           |  60 ++--
 rts/Sim/Misc/TeamHandler.h              |   5 +-
 rts/Sim/Units/Scripts/LuaUnitScript.cpp |  76 ++---
 rts/Sim/Units/Scripts/UnitScript.cpp    |   2 +-
 6 files changed, 269 insertions(+), 261 deletions(-)

diff --git a/rts/Game/GameHelper.cpp b/rts/Game/GameHelper.cpp
index f6cc6f9..e3080e2 100644
--- a/rts/Game/GameHelper.cpp
+++ b/rts/Game/GameHelper.cpp
@@ -795,8 +795,11 @@ namespace {
 //
 // It is only valid if nothing the precompute read changed before the replay:
 // the hooks in BrLosJoin.h mark a unit when its LOS state or mid/aim position
-// is written, a quad when its unit lists change, and everything on a synced Lua
-// control call, a COB set-value, a team change or a radar error size change.
+// (or position, or speed) is written, a quad when its unit lists change, and
+// everything on a team or alliance change, a radar error size change, or the
+// few Lua controls that write a scan input directly (SetUnitLosState,
+// SetUnitPosErrorParams, SetUnitLeavesGhost, SetAlly); every other Lua control
+// changes those inputs only through the hooked setters.
 // The replay also requires the owner unmarked and at the same position, its
 // exact radius inside the precomputed one, and the weapon's error vector,
 // ground-target flag and move-error experience as they were. Otherwise the
