+static std::atomic<int> brLosNext{0};
+static std::atomic<int> brLosDone{0};
+static int brLosCount = 0;
+static std::vector<CUnit*> brLosUnits; // the active units Update was called with
+
+// take the next sensor types nobody has started and run them, on any thread
+static void BrLosRunSome() {
+	for (int i; (i = brLosNext.fetch_add(1, std::memory_order_acq_rel)) < brLosCount; ) {
+		losHandler->BrUpdateType(i);
+		brLosDone.fetch_add(1, std::memory_order_release);
+	}
+}
+
+// BARREPLAY_H84_STATS=1: every 1800 frames, how many joins found the tasks
+// unfinished and how long they waited (the overlap the background run lost)
+static const bool brLosStats = (getenv("BARREPLAY_H84_STATS") != nullptr);
+static std::atomic<long long> brLosWaitNs{0};
+static std::atomic<int> brLosWaits{0}, brLosJoins{0};
+
+void BrLosJoinSlow() {
+	const bool unfinished = brLosDone.load(std::memory_order_acquire) < brLosCount;
+	const auto t0 = brLosStats? std::chrono::steady_clock::now(): std::chrono::steady_clock::time_point();
+	BrLosRunSome();
+	while (brLosDone.load(std::memory_order_acquire) < brLosCount)
+		_mm_pause();
+	g_brLosPending.store(0, std::memory_order_release);
+	if (brLosStats) {
+		brLosJoins.fetch_add(1, std::memory_order_relaxed);
+		if (unfinished) {
+			brLosWaits.fetch_add(1, std::memory_order_relaxed);
+			brLosWaitNs.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count(), std::memory_order_relaxed);
+		}
+	}
+}
+
+void CLosHandler::BrUpdateType(int idx)
+{
+	ILosType* lt = losTypes[idx];
+	for (CUnit* u : brLosUnits) {
+		lt->UpdateUnit(u, false);
+	}
+	lt->Update();
+}
