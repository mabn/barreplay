+/* This file is part of the Spring engine (GPL v2 or later), see LICENSE.html */
+
+#ifndef BR_LOS_JOIN_H
+#define BR_LOS_JOIN_H
+
+#include <atomic>
+
+// [barreplay] H84 (toggle 0x8000): CLosHandler::Update hands its work (one task
+// per sensor type, the same split the for_mt made) to the worker threads and
+// returns; the main thread goes on with the serial rest of the frame. Every way
+// into the LOS state, and every write to what the tasks read (the units' sensor
+// fields and midPos, the synced height maps, the global-LOS flags), first calls
+// BrLosJoin, which waits for the tasks (and runs any not yet started). The tasks
+// see the frame number and the active-unit list Update was called with. Nothing
+// outside the tasks touches their data before the join, so they compute exactly
+// what the for_mt did.
+extern std::atomic<int> g_brLosPending;
+void BrLosJoinSlow();
+static inline void BrLosJoin() {
+	if (__builtin_expect(g_brLosPending.load(std::memory_order_acquire) != 0, 0))
+		BrLosJoinSlow();
+}
+
+#endif
