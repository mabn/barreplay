Subject: [PATCH 61/62] P3: the precompute's quad queries use their own
 thread's vector pool

---
 rts/Game/GameHelper.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/rts/Game/GameHelper.cpp b/rts/Game/GameHelper.cpp
index 2882687..f6cc6f9 100644
--- a/rts/Game/GameHelper.cpp
+++ b/rts/Game/GameHelper.cpp
@@ -876,6 +876,7 @@ namespace BrScan {
 		e.superRadius = std::max(r1, r2);
 
 		QuadFieldQuery qfQuery;
+		qfQuery.threadOwner = ThreadPool::GetThreadNum(); // runs on any thread
 		quadField.GetQuads(qfQuery, e.ownerPos, e.superRadius);
 		e.quads.assign(qfQuery.quads->begin(), qfQuery.quads->end());
 		e.occ.clear();
