From 40493ac13274324c0d25424794bab17dbdc379d2 Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Sat, 17 Oct 2026 20:38:13 +0000
Subject: [PATCH 54/54] H82: GenerateWeaponTargets prefetches through the next
 quads: Quad, list header, pointer array, first candidates (toggle 0x10000)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rts/Game/GameHelper.cpp | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/rts/Game/GameHelper.cpp b/rts/Game/GameHelper.cpp
index 2772224..659d7d2 100644
--- a/rts/Game/GameHelper.cpp
+++ b/rts/Game/GameHelper.cpp
@@ -696,12 +696,40 @@ size_t CGameHelper::GenerateWeaponTargets(const CWeapon* weapon, const CUnit* av
 
 	const int tempNum = gs->GetTempNum();
 	const bool prefetchCandidates = ((g_brToggles & 0x400) != 0);
+	const bool prefetchQuads = ((g_brToggles & 0x10000) != 0);
 
 	for (int t = 0; t < teamHandler.ActiveAllyTeams(); ++t) {
 		if (teamHandler.Ally(weaponOwner->allyteam, t))
 			continue;
 
-		for (const int qi: *qfQuery.quads) {
+		const std::vector<int>& qv = *qfQuery.quads;
+		for (size_t qn = 0, qc = qv.size(); qn < qc; ++qn) {
+			const int qi = qv[qn];
+			// [barreplay] H82 (toggle 0x10000): a pipeline over the next quads, so
+			// a quad's list and its first candidates are in cache when the loop
+			// gets there (H77 only reaches 6 ahead inside a list, and most lists
+			// here are short): the Quad 3 ahead, its list header 2 ahead, the
+			// list's pointer array 1 ahead, the first 6 candidates of this one.
+			// Prefetches and reads only: the lists the loop uses are read below,
+			// as before.
+			if (prefetchQuads) {
+				if (qn + 3 < qc)
+					__builtin_prefetch(&quadField.GetQuad(qv[qn + 3]).teamUnits);
+				if (qn + 2 < qc)
+					__builtin_prefetch(&quadField.GetQuad(qv[qn + 2]).teamUnits[t]);
+				if (qn + 1 < qc) {
+					const std::vector<CUnit*>& next = quadField.GetQuad(qv[qn + 1]).teamUnits[t];
+					if (!next.empty())
+						__builtin_prefetch(next.data());
+				}
+				const std::vector<CUnit*>& here = quadField.GetQuad(qi).teamUnits[t];
+				for (size_t pi = 0, pn = std::min<size_t>(here.size(), 6); pi < pn; ++pi) {
+					const CUnit* pu = here[pi];
+					__builtin_prefetch(&pu->tempNum);
+					__builtin_prefetch(&pu->losStatus[weaponOwner->allyteam]);
+					__builtin_prefetch(&pu->aimPos);
+				}
+			}
 			const std::vector<CUnit*>& allyTeamUnits = quadField.GetQuad(qi).teamUnits[t];
 
 			for (size_t ui = 0, un = allyTeamUnits.size(); ui < un; ++ui) {
-- 
