From d4fde36129ecac63015447613ba54441de32b144 Mon Sep 17 00:00:00 2001
From: mabn <github@mabn.pl>
Date: Mon, 19 Oct 2026 13:52:00 +0000
Subject: [PATCH 103/108] [barreplay] H101: builders, factories and units
 firing a synced-received air/water event are serial points

CBuilder and CFactory override Update; BAR's synced gadgets receive the air and
water events. Serial points are planned on all threads and planned again after
one that wrote through Lua, changed the height map or created a unit.
---
 rts/Lua/LuaUtils.cpp              |   6 ++
 rts/Sim/Objects/SolidObject.cpp   |   8 +-
 rts/Sim/Objects/SolidObject.h     |   1 +
 rts/Sim/Units/Unit.cpp            |  20 ++++
 rts/Sim/Units/Unit.h              |   4 +
 rts/Sim/Units/UnitHandler.cpp     | 159 ++++++++++++++++++++++--------
 rts/Sim/Units/UnitTypes/Builder.h |   1 +
 rts/Sim/Units/UnitTypes/Factory.h |   1 +
 8 files changed, 156 insertions(+), 44 deletions(-)

diff --git a/rts/Lua/LuaUtils.cpp b/rts/Lua/LuaUtils.cpp
index a775ad3..0f53876 100644
--- a/rts/Lua/LuaUtils.cpp
+++ b/rts/Lua/LuaUtils.cpp
@@ -9,8 +9,13 @@
 #include "Sim/Weapons/BrPipeTarget.h"
 #include "Sim/Misc/BrLosOverlap.h"
 
+// [barreplay] H101: how many calls of a Lua function that writes simulation
+// state there have been (the functions entered through the two trampolines)
+unsigned g_brLuaWrites = 0;
+
 int BrLuaDrainingCall(lua_State* L)
 {
+	++g_brLuaWrites;
 	BrP4::Drain(BrP4::DR_LUA);
 	// [barreplay] P7: a Lua write in the script tick can change any LOS input
 	BrP7::MarkAll();
@@ -23,6 +28,7 @@ int BrLuaDrainingCall(lua_State* L)
 // what they change for P7 themselves
 int BrLuaDrainingCallLus(lua_State* L)
 {
+	++g_brLuaWrites;
 	BrP4::Drain(BrP4::DR_LUA);
 	const lua_CFunction f = reinterpret_cast<lua_CFunction>(lua_touserdata(L, lua_upvalueindex(1)));
 	return f(L);
diff --git a/rts/Sim/Objects/SolidObject.cpp b/rts/Sim/Objects/SolidObject.cpp
index f8b272c..2486d00 100644
--- a/rts/Sim/Objects/SolidObject.cpp
+++ b/rts/Sim/Objects/SolidObject.cpp
@@ -109,6 +109,12 @@ void CSolidObject::UpdatePhysicalState(float eps)
 void CSolidObject::UpdatePhysicalStateAt(float eps, float groundHeight)
 {
 	RECOIL_DETAILED_TRACY_ZONE;
+	physicalState = static_cast<PhysicalState>(BrComputePhysicalStateAt(eps, groundHeight));
+}
+
+// [barreplay] H101: what UpdatePhysicalStateAt would set, without setting it
+unsigned int CSolidObject::BrComputePhysicalStateAt(float eps, float groundHeight) const
+{
 	const float waterLevel = CGround::GetWaterLevel(pos.x, pos.z);
 	// Get height of whichever surface is higher between ground and water
 	const float topSurfaceHeight = std::max(groundHeight, waterLevel);
@@ -137,7 +143,7 @@ void CSolidObject::UpdatePhysicalStateAt(float eps, float groundHeight)
 	ps |= (PSTATE_BIT_INAIR       * ((    ps   & MASK_NOAIR) ==    0));
 	#undef MASK_NOAIR
 
-	physicalState = static_cast<PhysicalState>(ps);
+	return ps;
 
 	// verify mutex relations (A != B); if one
 	// fails then A and B *must* both be false
