+// [barreplay] P7 (BrLosOverlap.h): Update()'s work in two halves. Phase A
+// (on a worker, in the script tick) runs the per-unit loop, the delayed
+// queues, the filter and the raycasts, keeping the squares a recalculated
+// instance has to be removed with; phase B (at the LOS point) removes and adds
+// the squares and does the cache bookkeeping, exactly as Update() would.
+void ILosType::BrPhaseA(const std::vector<CUnit*>& units)
+{
+	for (CUnit* u: units) {
+		UpdateUnit(u, false);
+	}
+
+	brPlanned = false;
+	brOld.clear();
+
+	// delayed delete
+	while (!delayedDeleteQue.empty() && delayedDeleteQue.front().timeoutTime < gs->frameNum) {
+		UnrefInstance(delayedDeleteQue.front().instance);
+		delayedDeleteQue.pop_front();
+	}
+
+	// relos after terraform is delayed
+	while (!delayedTerraQue.empty() && delayedTerraQue.front().timeoutTime < gs->frameNum) {
+		SLosInstance* li = delayedTerraQue.front().instance;
+		li->isQueuedForTerraform = false;
+		if (!li->isQueuedForUpdate)
+			losUpdate.push_back(li);
+
+		delayedTerraQue.pop_front();
+	}
+
+	if (losUpdate.empty())
+		return;
+
+	losRemove.clear();
+	losRemove.reserve(losUpdate.size());
+	losAdd.clear();
+	losAdd.reserve(losUpdate.size());
+	losDeleted.clear();
+	losDeleted.reserve(losUpdate.size());
+
+	if (algoType == LOS_ALGO_RAYCAST) {
+		losRecalc.clear();
+		losRecalc.reserve(losUpdate.size());
+	}
+
+	for (SLosInstance* li: losUpdate) {
+		const auto status = OptimizeInstanceUpdate(li);
+		li->isQueuedForUpdate = false;
+
+		switch (status) {
+			case SLosInstance::TLosStatus::NEW: {
+				if (algoType == LOS_ALGO_RAYCAST) losRecalc.push_back(li);
+				losAdd.push_back(li);
+			} break;
+			case SLosInstance::TLosStatus::REACTIVATE: {
+				losAdd.push_back(li);
+			} break;
+			case SLosInstance::TLosStatus::RECALC: {
+				losRemove.push_back(li);
+				if (algoType == LOS_ALGO_RAYCAST) {
+					losRecalc.push_back(li);
+					li->brKeepOld = true; // removed in phase B with the squares it has now
+				}
+				losAdd.push_back(li);
+			} break;
+			case SLosInstance::TLosStatus::REMOVE: {
+				losRemove.push_back(li);
+				losDeleted.push_back(li);
+			} break;
+			case SLosInstance::TLosStatus::NONE: {
+			} break;
+			default: assert(false);
+		}
+
+		if (status == SLosInstance::TLosStatus::REMOVE) {
+			li->status &= SLosInstance::TLosStatus::RECALC;
+		} else {
+			li->status = SLosInstance::TLosStatus::NONE;
+		}
+	}
+
+	// raycast terrain (serially: this already runs beside the other types)
+	if (algoType == LOS_ALGO_RAYCAST) {
+		for (SLosInstance* li: losRecalc) {
+			assert(li->refCount > 0);
+			if (li->brKeepOld) {
+				li->brOldIdx = int(brOld.size());
+				brOld.emplace_back(li, std::move(li->squares));
+			}
+			li->squares.clear();
+			losMaps[li->allyteam].PrepareRaycast(li);
+		}
+	}
+
+	losUpdate.clear();
+	brPlanned = true;
+}
+
+void ILosType::BrPhaseB()
+{
+	if (!brPlanned)
+		return;
+
+	brPlanned = false;
+
+	// remove sight (a recalculated instance with its old squares)
+	for (SLosInstance* li: losRemove) {
+		if (li->brKeepOld) {
+			std::vector<SLosInstance::RLE>& old = brOld[li->brOldIdx].second;
+			std::swap(li->squares, old);
+			LosRemove(li);
+			std::swap(li->squares, old);
+			li->brKeepOld = false;
+			li->brOldIdx = -1;
+		} else {
+			LosRemove(li);
+		}
+	}
+
+	// add sight
+	for (SLosInstance* li: losAdd) {
+		assert(li->refCount > 0);
+		LosAdd(li);
+	}
+
+	// delete / move to cache unused instances
+	if (algoType == LOS_ALGO_RAYCAST) {
+		while (!losCache.empty() && ((losCache.size() + losDeleted.size()) > CACHE_SIZE)) {
+			SLosInstance* li = losCache.front();
+			losCache.pop_front();
+			li->isCached = false;
+			DeleteInstance(li);
+		}
+
+		for (SLosInstance* li: losDeleted) {
+			assert(li->refCount == 0);
+			AddInstanceToCache(li);
+		}
+	} else {
+		assert(losCache.empty());
+		for (SLosInstance* li: losDeleted) {
+			DeleteInstance(li);
+		}
+	}
+
+	brOld.clear();
+}
+
