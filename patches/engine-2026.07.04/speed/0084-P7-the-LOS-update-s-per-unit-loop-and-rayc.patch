+// [barreplay] P7 (BrLosOverlap.h)
+namespace BrP7 {
+	std::atomic<int> open{0};
+	namespace {
+		bool launched = false, joined = false, all = false;
+		std::vector<CUnit*> units; // the active units when phase A started
+		std::vector<CUnit*> marked;
+		std::atomic_flag lock = ATOMIC_FLAG_INIT;
+		struct Stats { long long frames = 0, allFrames = 0, marks = 0, joinsEarly = 0; } st;
+		int lastLog = 0;
+
+		auto phaseA = [](const int idx) { losHandler->BrP7PhaseA(idx); };
+		decltype(for_mt_background(0, 1, phaseA)) task;
+	}
+
+	void MarkSlow(const CUnit* unit) {
+		while (lock.test_and_set(std::memory_order_acquire)) {}
+		marked.push_back(const_cast<CUnit*>(unit));
+		st.marks++;
+		lock.clear(std::memory_order_release);
+	}
+	void MarkAllSlow() {
+		all = true;
+	}
+	void JoinSlow() {
+		if (!launched || joined)
+			return;
+		st.joinsEarly++;
+		wait_for_mt_background(task);
+		joined = true;
+	}
+	void Begin() {
+		if (losHandler != nullptr)
+			losHandler->BrP7Begin();
+	}
+}
+
+void CLosHandler::BrP7PhaseA(int idx)
+{
+	losTypes[idx]->BrPhaseA(BrP7::units);
+}
+
+void CLosHandler::BrP7Begin()
+{
+	using namespace BrP7;
+	if ((g_brToggles2 & 0x10) == 0 || !ThreadPool::HasThreads() || ThreadPool::IsInMultiThreadedSection())
+		return;
+	#if (USE_STAGGERED_UPDATES == 1)
+	return;
+	#endif
+
+	units = unitHandler.GetActiveUnits();
+	marked.clear();
+	all = false;
+	joined = false;
+	launched = true;
+	open.store(1, std::memory_order_release);
+	task = for_mt_background(0, losTypes.size(), phaseA);
+}
+
+void CLosHandler::BrP7JoinA()
+{
+	BrP7::JoinSlow();
+}
+
+// at the LOS point: false when phase A did not run (the ordinary update follows)
+bool CLosHandler::BrP7Finish()
+{
+	using namespace BrP7;
+	if (!launched)
+		return false;
+
+	if (!joined) {
+		wait_for_mt_background(task);
+		joined = true;
+	}
+	open.store(0, std::memory_order_release);
+	launched = false;
+	st.frames++;
+
+	for_mt(0, losTypes.size(), [&](const int idx) {
+		ILosType* lt = losTypes[idx];
+		lt->BrPhaseB();
+
+		if (all) {
+			// a write phase A cannot follow: the whole ordinary update again
+			for (CUnit* u: unitHandler.GetActiveUnits()) {
+				lt->UpdateUnit(u, false);
+			}
+		} else {
+			for (CUnit* u: marked) {
+				lt->UpdateUnit(u, false);
+			}
+		}
+		lt->Update();
+	});
+
+	st.allFrames += all;
+	if (getenv("BARREPLAY_P7_STATS") != nullptr && (gs->frameNum - lastLog) >= 900) {
+		lastLog = gs->frameNum;
+		LOG("[BR_P7] f=%d frames=%lld allFrames=%lld marks=%lld joinsEarly=%lld", gs->frameNum, st.frames, st.allFrames, st.marks, st.joinsEarly);
+	}
+	marked.clear();
+	all = false;
+	return true;
+}
+
