diff --git a/rts/Sim/Misc/BrLosOverlap.h b/rts/Sim/Misc/BrLosOverlap.h
new file mode 100644
index 0000000..e9de6a4
--- /dev/null
+++ b/rts/Sim/Misc/BrLosOverlap.h
@@ -0,0 +1,56 @@
+/* This file is part of the Spring engine (GPL v2 or later), see LICENSE.html */
+
+#ifndef BR_LOS_OVERLAP_H
+#define BR_LOS_OVERLAP_H
+
+#include <atomic>
+
+// [barreplay] P7 (toggle2 0x10): the LOS update in two phases. Phase A, every
+// sensor type's per-unit loop (instance lookups, creation, refcounts) and the
+// raycasts of new and recalculated instances, runs on the workers while the
+// main thread runs the script tick (COB threads, animations, transportees),
+// which reads no LOS state. Phase B, the LOS map update (the instances'
+// squares removed and added) and the cache bookkeeping, stays at the usual LOS
+// point, so every LOS query before it still sees last frame's maps.
+//
+// Phase A reads the units' LOS inputs early. Whatever writes one of them in the
+// window marks the unit (Mark), and phase B brings that unit's instances in
+// line with its final inputs (UpdateUnit again, then the ordinary update of
+// whatever that queued); a Lua write marks everything (MarkAll), and phase B
+// then runs the whole ordinary LOS update again. The LOS maps are integer sums
+// of the active instances' squares, which depend only on each instance's key
+// and the height map (fixed in the window), so the end state is the one the
+// ordinary update computes. Anything in the window that touches the LOS
+// handler's own state (a unit dying, taken, loaded, reverse built; a height map
+// change) waits for phase A first (Join).
+
+class CUnit;
+
+extern unsigned g_brToggles2;
+
+namespace BrP7 {
+	// phase A launched this frame and the LOS point not reached yet
+	extern std::atomic<int> open;
+
+	void MarkSlow(const CUnit* unit);
+	void MarkAllSlow();
+	void JoinSlow();
+
+	inline void Mark(const CUnit* unit) {
+		if (__builtin_expect(open.load(std::memory_order_relaxed) != 0, 0))
+			MarkSlow(unit);
+	}
+	inline void MarkAll() {
+		if (__builtin_expect(open.load(std::memory_order_relaxed) != 0, 0))
+			MarkAllSlow();
+	}
+	inline void Join() {
+		if (__builtin_expect(open.load(std::memory_order_relaxed) != 0, 0))
+			JoinSlow();
+	}
+
+	// before the script tick (Game.cpp): launch phase A when it is on
+	void Begin();
+}
+
+#endif
