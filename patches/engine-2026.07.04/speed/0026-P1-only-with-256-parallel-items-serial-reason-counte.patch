+// [barreplay] GC cost per Lua state, for the bench harness
+namespace {
+	struct BrGcStat { std::string name; unsigned long long cycles = 0, calls = 0; };
+	std::vector<BrGcStat> brGcStats;
+}
+int BrLuaGcStatsLine(char* buf, int size) {
+	int n = snprintf(buf, size, "[BR_LUAGC]");
+	for (const auto& g: brGcStats) {
+		if (n >= size) break;
+		n += snprintf(buf + n, size - n, " %s=%.2fe9/%llu", g.name.c_str(), g.cycles * 1e-9, g.calls);
+	}
+	if (n < size) n += snprintf(buf + n, size - n, "\n");
+	return n;
+}
+
 void CLuaHandle::CollectGarbage(bool forced)
 {
 	RECOIL_DETAILED_TRACY_ZONE;
+	const unsigned long long brT0 = __rdtsc();
+	struct BrGcAcc {
+		const CLuaHandle* h; unsigned long long t0;
+		~BrGcAcc() {
+			const std::string key = h->GetName() + (h->GetSynced()? "/s": "/u");
+			for (auto& g: brGcStats) {
+				if (g.name == key) { g.cycles += __rdtsc() - t0; g.calls++; return; }
+			}
+			brGcStats.push_back({key, __rdtsc() - t0, 1});
+		}
+	} brGcAcc{this, brT0};
 	const float gcMemLoadMult = D.gcCtrl.baseMemLoadMult;
 	const float gcRunTimeMult = D.gcCtrl.baseRunTimeMult;
 
