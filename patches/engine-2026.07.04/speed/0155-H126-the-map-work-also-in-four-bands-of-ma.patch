-void ILosType::BrMapWork(int a)
+// [barreplay] H126: ally team a's removes, then its adds (the raycasts have
+// run), on the rows of one band of its map; an instance whose circle misses
+// the band is skipped whole
+void ILosType::BrMapWork(int a, int band, int bands)
 {
+	CLosMap& m = losMaps[a];
+	const int rows = m.BrRows();
+	const int rowLo = int((int64_t(rows) * band) / bands);
+	const int rowHi = int((int64_t(rows) * (band + 1)) / bands);
+	const auto misses = [&](const SLosInstance* li) {
+		return (li->basePos.y + li->radius < rowLo) || (li->basePos.y - li->radius >= rowHi);
+	};
+	const bool raycast = (algoType == LOS_ALGO_RAYCAST);
+
 	for (const int k: brRem[a]) {
-		if (brRecalcRem[k]) {
-			losMaps[a].BrAddSquares(brOld[k], -1);
+		const SLosInstance* li = losRemove[k];
+		if (misses(li))
+			continue;
+		if (raycast) {
+			m.BrAddSquaresBand(brRecalcRem[k] ? brOld[k] : li->squares, -1, rowLo, rowHi);
 		} else {
-			LosRemove(losRemove[k]);
+			m.BrAddCircleBand(li, -1, rowLo, rowHi);
 		}
 	}
-	for (SLosInstance* li: brAdd[a]) {
+	for (const SLosInstance* li: brAdd[a]) {
 		assert(li->refCount > 0);
-		LosAdd(li);
+		if (misses(li))
+			continue;
+		if (raycast) {
+			m.BrAddSquaresBand(li->squares, 1, rowLo, rowHi);
+		} else {
+			m.BrAddCircleBand(li, 1, rowLo, rowHi);
+		}
 	}
 }
 
