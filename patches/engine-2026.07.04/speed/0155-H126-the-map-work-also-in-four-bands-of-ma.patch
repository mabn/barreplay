@@ -53,20 +53,32 @@ public:
 	// FIXME temp fix for CBaseGroundDrawer and AI interface, which need raw data
 	const unsigned short& front() const { return losmap.front(); }
 	const auto& GetLosMap() const { return losmap; }
-	// [barreplay] H126: AddRaycast's plain path (any amount but a visible
-	// add's) over the given squares instead of the instance's own (a template
-	// only because SLosInstance is incomplete here; 0 is EMPTY_RLE's length)
+	// [barreplay] H126: AddRaycast's counter loop over the given squares (an
+	// instance's, or its old ones) and AddCircle's, both for the map rows in
+	// [rowLo, rowHi) only. A span lies within one row (AddSquaresToInstance
+	// makes them row by row, of in-map squares only), so it belongs to the
+	// band its start is in, and two bands never touch the same counter. A
+	// visible add's report of squares entering LOS is left out: in full view,
+	// the only place this runs, CReadMap::UpdateLOS returns at once. (A
