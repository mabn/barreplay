+	// length.)
 	template <typename RLEs>
-	void BrAddSquares(const RLEs& losSquares, int amount) {
+	void BrAddSquaresBand(const RLEs& losSquares, int amount, int rowLo, int rowHi) {
 		if (losSquares.empty() || losSquares[0].length == 0)
 			return;
 
+		const int lo = rowLo * size.x;
+		const int hi = rowHi * size.x;
 		for (const auto rle: losSquares) {
+			if (rle.start < lo || rle.start >= hi)
+				continue;
 			for (int idx = rle.start, len = rle.length; len > 0; --len, ++idx) {
 				losmap[idx] += amount;
 			}
 		}
 	}
+	void BrAddCircleBand(const SLosInstance* instance, int amount, int rowLo, int rowHi);
+	int BrRows() const { return size.y; } // [barreplay] H126
