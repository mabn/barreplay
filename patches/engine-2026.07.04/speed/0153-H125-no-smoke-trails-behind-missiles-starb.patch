 #define SMOKE_TRAIL_PROJECTILE_H
 
 #include "Sim/Projectiles/Projectile.h"
+#include "Map/Ground.h"
 
 struct AtlasedTexture;
+class CSmokeTrailProjectile;
+
+extern unsigned g_brToggles3; // [barreplay] (Sim/MoveTypes/Systems/GeneralMoveSystem.cpp)
+
+// [barreplay] H125 (toggle3 0x200000): missiles, starburst missiles and
+// flying debris make no smoke trails. A trail is an unsynced projectile drawn
+// behind them; the one thing a synced projectile takes from it is the trail's
+// useAirLos, which its constructor computes from where it starts (false, or
+// more than 10 elmos above the ground at its midpoint) — AirLos gives that
+// without the trail. In a trail's place the projectile holds NoTrail(), a tag
+// never dereferenced, so every "is there a trail" test answers as before.
+namespace BrH125 {
+	extern unsigned char noTrailTag;
+	inline bool On() { return (g_brToggles3 & 0x200000) != 0; }
+	inline CSmokeTrailProjectile* NoTrail() { return reinterpret_cast<CSmokeTrailProjectile*>(&noTrailTag); }
+	// CSmokeTrailProjectile(owner, pos1, pos2, ...)'s useAirLos
+	inline bool AirLos(const float3& pos1, const float3& pos2) {
+		const float3 mid = (pos1 + pos2) * 0.5f;
+		return ((mid.y - CGround::GetApproximateHeight(mid.x, mid.z)) > 10.0f);
+	}
+}
 
 class CSmokeTrailProjectile : public CProjectile
 {
