+/* This file is part of the Spring engine (GPL v2 or later), see LICENSE.html */
+
+#ifndef BR_PIPE_TARGET_H
+#define BR_PIPE_TARGET_H
+
+// [barreplay] P4 (toggle 0x800000): the slow-update loop's weapon target
+// searches (CWeapon::AutoTarget: GenerateWeaponTargets and the TryTarget walk
+// over its candidates) run on worker threads while the main thread goes on
+// with the next units' slow updates, with EXACTLY the sequential result.
+//
+// A search only reads. What it reads is: the enemy units in the quads around
+// its weapon (what GenerateWeaponTargets lists), the units and features the
+// line-of-fire rays meet inside that area, the ground, its own weapon and
+// owner, and some global tables. The main thread keeps everything else in
+// sequential order (RNG draws, COB queries, tempNum, Lua) and applies each
+// search's result (SetAttackTarget) in launch order. It waits for the
+// searches still running before anything that could change what they read:
+//   - before a unit's slow update, when the unit is an ENEMY of a running
+//     search's weapon and inside its area (the slow update writes the unit's
+//     own health, paralysis, radar error and so on, which only the scan
+//     reads);
+//   - before every Lua callin, every COB call that may reach Lua or move
+//     pieces a ray reads (CobCallNeedsDrain), every death, damage, explosion,
+//     quad-list change, position, rotation or cloak change, team change,
+//     transport change and LOS-state change.
+// Piece matrices are recomputed lazily on read, which is a write: while a
+// slice runs, nobody writes them; a dirty one is computed into scratch
+// (LocalModelPiece::BrScratchModelSpaceMatrix), by the same operations.
+
+#include <atomic>
+
+class CUnit;
+class CWeapon;
+
+extern unsigned g_brToggles;
+
+namespace BrP4 {
+	// inside a pipelined slow-update slice (written by the main thread only)
+	extern std::atomic<bool> active;
+	// this thread is running a search out of order
+	extern thread_local bool inWorker;
+
+	inline bool Active() { return active.load(std::memory_order_relaxed); }
+
+	// the slow-update slice: Begin returns whether searches are pipelined
+	bool Begin();
+	void End();
+
+	// before u's slow update (main)
+	void BeforeUnit(const CUnit* u);
+	// before w's slow update: a slaved weapon reads its master's target
+	void BeforeWeapon(const CWeapon* w);
+
+	// AutoTarget's search for w, run out of order; false = run it now
+	bool Launch(CWeapon* w, const CUnit* avoidUnit);
+
+	// a write the searches may read is about to happen: finish and apply all
+	void DrainSlow(int reason);
+	inline void Drain(int reason) {
+		if (__builtin_expect(Active(), false))
+			DrainSlow(reason);
+	}
+
+	// a COB call must wait for the searches: the function (or one it calls)
+	// reaches Lua, or moves pieces at once and the unit's collision volume is
+	// its piece tree; decided once per function from its bytecode. Every
+	// other global effect a script can have goes through a hooked function.
+	bool CobCallNeedsDrain(const void* cobFile, int functionId, bool pieceTreeUnit);
+
+	enum DrainReason { DR_LUA, DR_COB, DR_KILL, DR_DAMAGE, DR_QUAD, DR_MOVE, DR_TEAM, DR_TRANSPORT, DR_EXPLOSION, DR_LOS, DR_FEATURE, DR_ENEMY, DR_RAYS, DR_SLAVE, DR_N };
+}
+
+#endif
