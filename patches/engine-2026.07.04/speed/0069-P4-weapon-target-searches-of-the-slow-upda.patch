index 0000000..56b0dd3
--- /dev/null
+++ b/rts/Sim/Weapons/BrPipeTarget.cpp
@@ -0,0 +1,458 @@
+/* This file is part of the Spring engine (GPL v2 or later), see LICENSE.html */
+
+// [barreplay] P4: pipelined weapon target searches in the slow-update loop.
+// See BrPipeTarget.h for what is read, what is waited for, and why the result
+// is the sequential one.
+
+#include "BrPipeTarget.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+#include <immintrin.h>
+#include <x86intrin.h>
+
+#include "Weapon.h"
+#include "WeaponDef.h"
+#include "Map/ReadMap.h"
+#include "Sim/Misc/GlobalSynced.h"
+#include "Sim/Misc/QuadField.h"
+#include "Sim/Misc/TeamHandler.h"
+#include "Sim/Units/Unit.h"
+#include "Sim/Units/Scripts/CobFile.h"
+#include "Sim/Units/Scripts/CobOpCodes.h"
+#include "System/EventHandler.h"
+#include "System/Log/ILog.h"
+#include "System/Threading/ThreadPool.h"
+
+namespace BrP4 {
+	std::atomic<bool> active{false};
+	thread_local bool inWorker = false;
+
+	namespace {
+		struct Task {
+			CWeapon* w;
+			const CUnit* avoid;
+			float cx, cz, r;    // the scan circle: GenerateWeaponTargets' GetQuads
+			int ownerAlly;
+			CUnit* result;
+			CUnit* checkResult; // BARREPLAY_P4_CHECK: the search run in order
+			std::atomic<int> done;
+		};
+
+		constexpr int MAX_TASKS = 8192;
+		std::unique_ptr<Task[]> tasks;
+
+		// tasks [0, published) launched, [0, claimNext) taken by some thread,
+		// [0, committed) applied (main thread only)
+		std::atomic<int> published{0};
+		std::atomic<int> claimNext{0};
+		std::atomic<bool> closed{false};
+		int committed = 0;
+		int lastNear = -1;
+
+		float margin = 0.0f;
+		int nWorkers = 2;
+		bool check = false;
+		bool statsOn = false;
+		bool draining = false;
+		bool inited = false;
+
+		thread_local std::vector<std::pair<float, CUnit*>> tlPairs;
+		std::vector<std::pair<float, CUnit*>> checkPairs;
+
+		struct Stats {
+			long long slices = 0, launched = 0, notNative = 0, targetWeight = 0, full = 0;
+			long long drains[DR_N] = {};
+			long long waits = 0, waitCycles = 0, inlineRuns = 0, mismatches = 0, workerHooks = 0;
+			int lastFrame = 0;
+		} st;
+
+		const char* DrainName(int r) {
+			static const char* names[DR_N] = {"lua", "cob", "kill", "damage", "quad", "move", "team", "transport", "explosion", "los", "feature", "enemy", "rays", "slave"};
+			return (r >= 0 && r < DR_N)? names[r]: "?";
+		}
+
+		void RunTask(Task& t, int thread) {
+			t.result = t.w->BrSearchTarget(t.avoid, tlPairs, -1, thread);
+			t.done.store(1, std::memory_order_release);
+		}
+
+		void WorkerLoop() {
+			const int thread = ThreadPool::GetThreadNum();
+			inWorker = true;
+			// quad queries made deeper down (TraceRay) use this thread's pools
+			g_brQfThread = thread;
+
+			for (;;) {
+				int i = claimNext.load(std::memory_order_acquire);
+
+				if (i < published.load(std::memory_order_acquire)) {
+					if (claimNext.compare_exchange_weak(i, i + 1, std::memory_order_acq_rel))
+						RunTask(tasks[i], thread);
+					continue;
+				}
+				if (closed.load(std::memory_order_acquire))
+					break;
+
+				_mm_pause();
+			}
+
+			g_brQfThread = 0;
+			inWorker = false;
+		}
+
+		// main: task i has finished; run it here if no thread has taken it yet
+		void Complete(int i) {
+			Task& t = tasks[i];
+
+			if (t.done.load(std::memory_order_acquire))
+				return;
+
+			int c = i;
+			if (claimNext.compare_exchange_strong(c, i + 1, std::memory_order_acq_rel)) {
+				RunTask(t, 0);
+				st.inlineRuns++;
+				return;
+			}
+
+			const unsigned long long t0 = __rdtsc();
+			while (!t.done.load(std::memory_order_acquire))
+				_mm_pause();
+			st.waits++;
+			st.waitCycles += (__rdtsc() - t0);
+		}
+
+		void Apply(Task& t) {
+			CUnit* r = t.result;
+
+			if (check && t.checkResult != r) {
+				st.mismatches++;
+				LOG_L(L_WARNING, "[BR_P4] mismatch f=%d unit %d weapon %d: pipelined %d, in order %d", gs->frameNum, t.w->owner->id, t.w->weaponNum, (r != nullptr)? r->id: -1, (t.checkResult != nullptr)? t.checkResult->id: -1);
+				r = t.checkResult;
+			}
+
+			// AutoTarget's tail
+			if (r != nullptr)
+				t.w->SetAttackTarget(SWeaponTarget(r));
+		}
+
+		// apply every finished task at the head, in order
+		void CommitDone() {
+			const int n = published.load(std::memory_order_relaxed);
+
+			while (committed < n && tasks[committed].done.load(std::memory_order_acquire)) {
+				Apply(tasks[committed]);
+				committed++;
+			}
+		}
+
+		// main: finish and apply tasks [committed, last]
+		void CommitThrough(int last) {
+			while (committed <= last) {
+				Complete(committed);
+				Apply(tasks[committed]);
+				committed++;
+			}
+		}
+
+		void StatsLine() {
+			if (!statsOn || (gs->frameNum - st.lastFrame) < 900)
+				return;
+			st.lastFrame = gs->frameNum;
+
+			char buf[512];
+			int k = snprintf(buf, sizeof(buf), "[BR_P4] f=%d slices=%lld launched=%lld serial(notNative=%lld weight=%lld full=%lld) waits=%lld waitMs=%.1f inline=%lld mismatches=%lld workerHooks=%lld drains:", gs->frameNum, st.slices, st.launched, st.notNative, st.targetWeight, st.full, st.waits, st.waitCycles / 3.0e6, st.inlineRuns, st.mismatches, st.workerHooks);
+			for (int r = 0; r < DR_N && k < int(sizeof(buf)); ++r)
+				k += snprintf(buf + k, sizeof(buf) - k, " %s=%lld", DrainName(r), st.drains[r]);
+			LOG("%s", buf);
+		}
+
+		auto workerFn = [](const int) { WorkerLoop(); };
+		std::shared_ptr<ForTaskGroup<decltype(workerFn)>> taskGroup;
+	}
+
+
+	bool Begin()
+	{
+		if ((g_brToggles & 0x800000) == 0)
+			return false;
+
+		if (!inited) {
+			inited = true;
+			tasks.reset(new Task[MAX_TASKS]);
+			check = (getenv("BARREPLAY_P4_CHECK") != nullptr);
+			statsOn = (getenv("BARREPLAY_P4_STATS") != nullptr);
+			if (const char* w = getenv("BARREPLAY_P4_WORKERS"))
+				nWorkers = std::max(0, atoi(w));
+			LOG("[barreplay] P4 pipelined target searches: %d workers%s", nWorkers, check? ", checking every result against the search run in order": "");
+		}
+
+		if (!ThreadPool::HasThreads())
+			return false;
+
+		const int nw = std::min(nWorkers, ThreadPool::GetNumThreads() - 1);
+		if (nw <= 0)
+			return false;
+
+		published.store(0, std::memory_order_relaxed);
+		claimNext.store(0, std::memory_order_relaxed);
+		closed.store(false, std::memory_order_relaxed);
+		committed = 0;
+		margin = 3.0f * std::max(quadField.GetQuadSizeX(), quadField.GetQuadSizeZ());
+		st.slices++;
+
+		static TaskPool<ForTaskGroup, decltype(workerFn)> pool;
+		taskGroup = pool.GetTaskGroup();
+		taskGroup->Enqueue(0, nw, 1, workerFn);
+		taskGroup->UpdateId();
+		for (int i = 1; i <= nw; ++i) {
+			taskGroup->wantedThread.store(i);
+			ThreadPool::PushTaskGroup(taskGroup);
+		}
+		ThreadPool::NotifyWorkerThreads(true, false);
+
+		// the workers are spinning in this slice: a parallel loop started from
+		// inside it would wait for them forever, so those run inline
+		ThreadPool::SetInlineOnly(true);
+		active.store(true, std::memory_order_relaxed);
+		return true;
+	}
+
+	void End()
+	{
+		CommitThrough(published.load(std::memory_order_relaxed) - 1);
+
+		closed.store(true, std::memory_order_release);
+		ThreadPool::SetInlineOnly(false);
+		{
+			// a worker slice nobody had started finds the slice closed
+			MultithreadedSection mtSection;
+			ThreadPool::WaitForFinished(taskGroup);
+		}
+		taskGroup.reset();
+		active.store(false, std::memory_order_relaxed);
+		StatsLine();
+	}
+
+	void BeforeUnit(const CUnit* u)
+	{
+		CommitDone();
+
+		const int n = published.load(std::memory_order_relaxed);
+		if (committed == n)
+			return;
+
+		// the unit's slow update writes the unit; the scans read enemy units
+		// in the quads around their weapons (any unit whose quads overlap the
+		// scan circle: its own radius plus a quad's slack on each side)
+		const float ux = u->pos.x;
+		const float uz = u->pos.z;
+		const float ur = u->radius + margin;
+		const int ua = u->allyteam;
+		int last = -1;
+
+		for (int i = committed; i < n; ++i) {
+			const Task& t = tasks[i];
+			const float dx = ux - t.cx;
+			const float dz = uz - t.cz;
+			const float rr = t.r + ur;
+
+			if ((dx * dx + dz * dz) > (rr * rr))
+				continue;
+			if (teamHandler.Ally(t.ownerAlly, ua))
+				continue;
+
+			last = i;
+		}
+
+		if (last < 0)
+			return;
+
+		st.drains[DR_ENEMY]++;
+		CommitThrough(last);
+	}
+
+	void BeforeWeapon(const CWeapon* w)
+	{
+		if (w->slavedTo == nullptr)
+			return;
+
+		const int n = published.load(std::memory_order_relaxed);
+		for (int i = n - 1; i >= committed; --i) {
+			if (tasks[i].w != w->slavedTo)
+				continue;
+			st.drains[DR_SLAVE]++;
+			CommitThrough(i);
+			return;
+		}
+	}
+
+	bool Launch(CWeapon* w, const CUnit* avoidUnit)
+	{
+		if (w->hasTargetWeight) {
+			// the script decides the weight: COB or Lua, in order
+			st.targetWeight++;
+			return false;
+		}
+
+		const WeaponDef* wd = w->weaponDef;
+		if (!eventHandler.BrAllowWeaponTargetNative(wd->id)) {
+			st.notNative++;
+			return false;
+		}
+
+		const int n = published.load(std::memory_order_relaxed);
+		if (n >= MAX_TASKS) {
+			st.full++;
+			return false;
+		}
+
+		const CUnit* o = w->owner;
+		Task& t = tasks[n];
+		t.w = w;
+		t.avoid = avoidUnit;
+		t.cx = o->pos.x;
+		t.cz = o->pos.z;
+		// GenerateWeaponTargets' scanRadius
+		const float minMapHeight = std::max(0.0f, readMap->GetCurrMinHeight());
+		t.r = std::fabs(w->range + w->autoTargetRangeBoost + (w->aimFromPos.y - minMapHeight) * wd->heightmod);
+		t.ownerAlly = o->allyteam;
+		t.result = nullptr;
+		t.checkResult = nullptr;
+
+		// the synced tempNum the search would take here; the search itself
+		// marks with its thread's own numbers
+		const int tempNum = gs->GetTempNum();
+
+		if (check)
+			t.checkResult = w->BrSearchTarget(avoidUnit, checkPairs, tempNum, -1);
+
+		t.done.store(0, std::memory_order_relaxed);
+		published.store(n + 1, std::memory_order_release);
+		st.launched++;
+		return true;
+	}
+
+	void DrainSlow(int reason)
+	{
+		if (inWorker) {
+			// a search wrote something: a hook in a path searches were
+			// believed not to take (the check mode would show what it cost)
+			st.workerHooks++;
+			return;
+		}
+		if (draining)
+			return;
+
+		const int n = published.load(std::memory_order_relaxed);
+		if (committed == n)
+			return;
+
+		draining = true;
+		st.drains[reason]++;
+		CommitThrough(n - 1);
+		draining = false;
+	}
+
+
+	// COB: a function is harmless when nothing it runs reaches Lua; piece
+	// writes that take effect at once (TURN_NOW, MOVE_NOW, SCALE_NOW, SHOW,
+	// HIDE, EXPLODE's hiding) matter only on a unit whose collision volume is
+	// its piece tree,
+	// which the line-of-fire rays read. Every other global effect a script
+	// can have (kills, damage, explosions, moves, turns, transport, cloak,
+	// team) goes through a hooked engine function.
+	namespace {
+		enum : uint8_t { CF_UNKNOWN = 0, CF_HARMLESS = 1, CF_PIECES = 2, CF_HARMFUL = 3, CF_VISITING = 4 };
+
+		std::unordered_map<const CCobFile*, std::vector<uint8_t>> cobMemo;
+
+		uint8_t AnalyzeCob(const CCobFile* f, std::vector<uint8_t>& memo, int fn) {
+			if (fn < 0 || size_t(fn) >= f->scriptNames.size())
+				return CF_HARMFUL;
+
+			uint8_t& m = memo[fn];
+			if (m == CF_VISITING)
+				return CF_HARMFUL; // recursion: not worth proving
+			if (m != CF_UNKNOWN)
+				return m;
+
+			m = CF_VISITING;
+
+			uint8_t res = CF_HARMLESS;
+			const auto& code = f->code;
+			const int beg = f->scriptOffsets[fn];
+			const int end = std::min<int>(beg + f->scriptLengths[fn], code.size());
+
+			for (int pc = beg; pc < end && res != CF_HARMFUL; ) {
+				const int op = code[pc++];
+
+				switch (op) {
+					case PUSH_CONSTANT: case PUSH_LOCAL_VAR: case PUSH_STATIC:
+					case POP_LOCAL_VAR: case POP_STATIC:
+					case JUMP: case JUMP_NOT_EQUAL:
+					case SHADE: case DONT_SHADE: case CACHE: case DONT_CACHE:
+					case PLAY_SOUND: case SCALE: case WAIT_SCALE:
+					case EMIT_SFX: {
+						pc += 1;
+					} break;
+					case SPIN: case STOP_SPIN: case TURN: case MOVE:
+					case WAIT_TURN: case WAIT_MOVE:
+					case START: { // the started thread runs in the COB tick, not here
+						pc += 2;
+					} break;
+					case MOVE_NOW: case TURN_NOW: {
+						pc += 2;
+						res = std::max<uint8_t>(res, CF_PIECES);
+					} break;
+					case SCALE_NOW: case SHOW: case HIDE: case EXPLODE: {
+						pc += 1;
+						res = std::max<uint8_t>(res, CF_PIECES);
+					} break;
+					case SLEEP: case RETURN: case CREATE_LOCAL_VAR: case POP_STACK:
+					case ADD: case SUB: case MUL: case DIV: case MOD:
+					case BITWISE_AND: case BITWISE_OR: case BITWISE_XOR: case BITWISE_NOT:
+					case LOGICAL_AND: case LOGICAL_OR: case LOGICAL_XOR: case LOGICAL_NOT:
+					case SET_LESS: case SET_LESS_OR_EQUAL: case SET_GREATER: case SET_GREATER_OR_EQUAL:
+					case SET_EQUAL: case SET_NOT_EQUAL:
+					case RAND: case SIGNAL: case SET_SIGNAL_MASK:
+					case GET_UNIT_VALUE: case GET: case SET: case ATTACH: case DROP: {
+					} break;
+					case CALL: case REAL_CALL: {
+						const int callee = (pc < end)? code[pc]: -1;
+						pc += 2;
+						if (callee < 0 || size_t(callee) >= f->scriptNames.size() || f->scriptNames[callee].find("lua_") == 0)
+							res = CF_HARMFUL;
+						else
+							res = std::max<uint8_t>(res, AnalyzeCob(f, memo, callee));
+					} break;
+					default: { // LUA_CALL, BATCH_LUA, SIGNATURE_LUA, anything unknown
+						res = CF_HARMFUL;
+					} break;
+				}
+			}
+
+			memo[fn] = res;
+			return res;
+		}
+	}
+
+	bool CobCallNeedsDrain(const void* cobFileV, int functionId, bool pieceTreeUnit)
+	{
+		const CCobFile* f = static_cast<const CCobFile*>(cobFileV);
+		if (f == nullptr)
+			return true;
+
+		std::vector<uint8_t>& memo = cobMemo[f];
+		if (memo.size() != f->scriptNames.size())
+			memo.assign(f->scriptNames.size(), CF_UNKNOWN);
+
+		const uint8_t r = AnalyzeCob(f, memo, functionId);
+		return (r == CF_HARMFUL || (r == CF_PIECES && pieceTreeUnit));
+	}
+}
