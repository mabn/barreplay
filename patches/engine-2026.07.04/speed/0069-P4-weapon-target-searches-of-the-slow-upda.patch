+// N1's checks, once a frame, on the main thread (they read the Lua state)
+static void BrFastAAFrame(lua_State* L)
+{
+	if (brFastAA.frame == gs->frameNum)
+		return;
+
+	brFastAA.frame = gs->frameNum;
+	if (!brFastAA.validated) {
+		brFastAA.validated = true;
+		brFastAA.ok = BrCheckFastAA(L, true);
+		LOG("[barreplay] N1 native AA targeting priority: %s", brFastAA.ok ? "on" : "off (the Lua path differs)");
+	} else if (brFastAA.ok) {
+		brFastAA.ok = BrCheckFastAA(L, false);
+		if (!brFastAA.ok)
+			LOG("[barreplay] N1 native AA targeting priority: off from frame %d", gs->frameNum);
+	}
+}
+
+// [barreplay] P4: no Lua for this def: not watched, or N1 takes the call
+bool CSyncedLuaHandle::BrAllowWeaponTargetNative(unsigned int weaponDefID)
+{
+	if (weaponDefID >= watchAllowTargetDefs.size() || !watchAllowTargetDefs[weaponDefID])
+		return true;
+	if ((g_brToggles & 4) == 0 || GetName() != "LuaRules")
+		return false;
+
+	BrFastAAFrame(L);
+	return brFastAA.ok;
+}
