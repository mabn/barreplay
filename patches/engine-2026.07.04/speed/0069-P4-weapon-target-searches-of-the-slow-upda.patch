 #include "3DModelPiece.hpp"
 #include "LocalModel.hpp"
@@ -139,20 +140,59 @@ bool LocalModelPiece::SetPieceSpaceMatrix(const CMatrix44f& mat)
 
 const Transform& LocalModelPiece::GetModelSpaceTransform() const
 {
-	if (dirty)
+	if (dirty) {
+		if (__builtin_expect(BrP4::inWorker || BrP4::Active(), false))
+			return BrScratchModelSpaceTransform();
 		UpdateParentMatricesRec();
+	}
 
 	return modelSpaceTra;
 }
 
 const CMatrix44f& LocalModelPiece::GetModelSpaceMatrix() const
 {
-	if (dirty)
+	if (dirty) {
+		if (__builtin_expect(BrP4::inWorker || BrP4::Active(), false))
+			return BrScratchModelSpaceMatrix();
 		UpdateParentMatricesRec();
+	}
 
 	return modelSpaceMat;
 }
 
+// the operations of UpdateParentMatricesRec, in the same order, on copies
+Transform LocalModelPiece::BrComputeModelSpaceTransform() const
+{
+	if (!dirty)
+		return modelSpaceTra;
+
+	const Transform pst = CalcPieceSpaceTransform(pos, rot, scale);
+
+	if (parent != nullptr)
+		return (parent->BrComputeModelSpaceTransform() * pst);
+
+	return pst;
+}
+
+// callers copy the result at once; a ring keeps a few calls' worth alive
+static thread_local Transform brScratchTra[16];
+static thread_local CMatrix44f brScratchMat[16];
+static thread_local unsigned brScratchIdx = 0;
+
+const Transform& LocalModelPiece::BrScratchModelSpaceTransform() const
+{
+	Transform& t = brScratchTra[(brScratchIdx++) & 15];
+	t = BrComputeModelSpaceTransform();
+	return t;
+}
+
+const CMatrix44f& LocalModelPiece::BrScratchModelSpaceMatrix() const
+{
+	CMatrix44f& m = brScratchMat[(brScratchIdx++) & 15];
+	m = BrComputeModelSpaceTransform().ToMatrix();
+	return m;
+}
+
 void LocalModelPiece::SetScriptVisible(bool b)
 {
 	scriptSetVisible = b;
