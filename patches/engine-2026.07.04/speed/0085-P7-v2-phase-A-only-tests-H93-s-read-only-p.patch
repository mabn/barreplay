-// at the LOS point: false when phase A did not run (the ordinary update follows)
+// at the LOS point: false when the window did not open (the ordinary update runs)
 bool CLosHandler::BrP7Finish()
 {
 	using namespace BrP7;
 	if (!launched)
 		return false;
 
-	if (!joined) {
-		wait_for_mt_background(task);
-		joined = true;
-	}
+	wait_for_mt_background(task);
 	open.store(0, std::memory_order_release);
 	launched = false;
 	st.frames++;
 
-	for_mt(0, losTypes.size(), [&](const int idx) {
-		ILosType* lt = losTypes[idx];
-		lt->BrPhaseB();
-
-		if (all) {
-			// a write phase A cannot follow: the whole ordinary update again
+	if (all) {
+		// a Lua write: the ordinary update, every unit tested again
+		st.allFrames++;
+		for_mt(0, losTypes.size(), [&](const int idx) {
+			ILosType* lt = losTypes[idx];
 			for (CUnit* u: unitHandler.GetActiveUnits()) {
 				lt->UpdateUnit(u, false);
 			}
-		} else {
-			for (CUnit* u: marked) {
-				lt->UpdateUnit(u, false);
+			lt->Update();
+		});
+	} else {
+		// a unit whose inputs changed in the window: tested again, every type
+		if (!marked.empty()) {
+			idxOf.assign(unitHandler.MaxUnits(), -1);
+			for (size_t n = 0; n < units.size(); ++n)
+				idxOf[units[n]->id] = int(n);
+			for (const CUnit* u: marked) {
+				const int i = idxOf[u->id];
+				if (i >= 0 && units[i] == u)
+					needs[i] = 0xFF;
 			}
+			st.marks += marked.size();
 		}
-		lt->Update();
-	});
+		for_mt(0, losTypes.size(), [&](const int idx) {
+			ILosType* lt = losTypes[idx];
+			const uint8_t bit = uint8_t(1u << idx);
+			for (size_t n = 0, m = units.size(); n < m; ++n) {
+				if ((needs[n] & bit) != 0)
+					lt->UpdateUnit(units[n], false);
+			}
+			lt->Update();
+		});
+	}
 
-	st.allFrames += all;
 	if (getenv("BARREPLAY_P7_STATS") != nullptr && (gs->frameNum - lastLog) >= 900) {
 		lastLog = gs->frameNum;
-		LOG("[BR_P7] f=%d frames=%lld allFrames=%lld marks=%lld joinsEarly=%lld", gs->frameNum, st.frames, st.allFrames, st.marks, st.joinsEarly);
+		size_t nn = 0;
+		for (const uint8_t v: needs) nn += __builtin_popcount(v);
+		LOG("[BR_P7] f=%d frames=%lld allFrames=%lld marks=%lld needed=%zu of %zu", gs->frameNum, st.frames, st.allFrames, st.marks, nn, units.size() * losTypes.size());
 	}
 	marked.clear();
 	all = false;
