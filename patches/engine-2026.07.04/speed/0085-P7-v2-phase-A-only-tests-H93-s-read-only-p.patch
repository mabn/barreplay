 	}
@@ -1001,8 +849,7 @@ void CLosHandler::UnitReverseBuilt(const CUnit* unit)
 void CLosHandler::UnitLoaded(const CUnit* unit, const CUnit* transport)
 {
 	RECOIL_DETAILED_TRACY_ZONE;
-	BrP7::Join(); // [barreplay] P7: phase A owns the instances while it runs
-	BrP7::Mark(unit);
+	BrP7::Mark(unit); // [barreplay] P7
 	if (!unit->IsStunned())
 		return;
 
@@ -1016,42 +863,48 @@ void CLosHandler::UnitLoaded(const CUnit* unit, const CUnit* transport)
 namespace BrP7 {
 	std::atomic<int> open{0};
 	namespace {
-		bool launched = false, joined = false, all = false;
-		std::vector<CUnit*> units; // the active units when phase A started
+		bool launched = false, all = false;
+		std::vector<CUnit*> units;    // the active units when the window opened
+		std::vector<uint8_t> needs;   // per unit: a bit per LOS type, UpdateUnit would act
+		std::vector<int> idxOf;       // unit id -> index in units (-1)
 		std::vector<CUnit*> marked;
 		std::atomic_flag lock = ATOMIC_FLAG_INIT;
-		struct Stats { long long frames = 0, allFrames = 0, marks = 0, joinsEarly = 0; } st;
+		struct Stats { long long frames = 0, allFrames = 0, marks = 0, needed = 0, scanned = 0; } st;
 		int lastLog = 0;
 
-		auto phaseA = [](const int idx) { losHandler->BrP7PhaseA(idx); };
+		auto phaseA = [](const int chunk) { losHandler->BrP7PhaseA(chunk); };
 		decltype(for_mt_background(0, 1, phaseA)) task;
+		constexpr int CHUNK = 256;
 	}
 
 	void MarkSlow(const CUnit* unit) {
 		while (lock.test_and_set(std::memory_order_acquire)) {}
 		marked.push_back(const_cast<CUnit*>(unit));
-		st.marks++;
 		lock.clear(std::memory_order_release);
 	}
 	void MarkAllSlow() {
 		all = true;
 	}
-	void JoinSlow() {
-		if (!launched || joined)
-			return;
-		st.joinsEarly++;
-		wait_for_mt_background(task);
