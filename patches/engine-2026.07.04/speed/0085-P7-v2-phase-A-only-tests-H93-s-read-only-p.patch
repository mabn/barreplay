-	}
+	void JoinSlow() {}
 	void Begin() {
 		if (losHandler != nullptr)
 			losHandler->BrP7Begin();
 	}
 }
 
-void CLosHandler::BrP7PhaseA(int idx)
+// phase A, one chunk of units: H93's test of every type (UpdateUnit's tests in
+// its order, reads only), the bit set where UpdateUnit would act
+void CLosHandler::BrP7PhaseA(int chunk)
 {
-	losTypes[idx]->BrPhaseA(BrP7::units);
+	using namespace BrP7;
+	const size_t b = size_t(chunk) * CHUNK, e = std::min(units.size(), b + CHUNK);
+	for (size_t n = b; n < e; ++n) {
+		const CUnit* u = units[n];
+		uint8_t m = 0;
+		for (size_t t = 0; t < losTypes.size(); ++t)
+			m |= uint8_t(losTypes[t]->BrNeedsUpdate(u)) << t;
+		needs[n] = m;
+	}
 }
 
 void CLosHandler::BrP7Begin()
@@ -1064,55 +917,67 @@ void CLosHandler::BrP7Begin()
 	#endif
 
 	units = unitHandler.GetActiveUnits();
+	needs.assign(units.size(), 0);
 	marked.clear();
 	all = false;
-	joined = false;
 	launched = true;
 	open.store(1, std::memory_order_release);
-	task = for_mt_background(0, losTypes.size(), phaseA);
+	task = for_mt_background(0, int((units.size() + CHUNK - 1) / CHUNK), phaseA);
 }
 
