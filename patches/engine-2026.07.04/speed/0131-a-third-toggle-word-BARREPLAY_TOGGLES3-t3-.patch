diff --git a/rts/Sim/Misc/LosHandler.cpp b/rts/Sim/Misc/LosHandler.cpp
index f040851..b75eef3 100644
--- a/rts/Sim/Misc/LosHandler.cpp
+++ b/rts/Sim/Misc/LosHandler.cpp
@@ -1337,6 +1337,87 @@ void CLosHandler::UpdateHeightMapSynced(SRectangle rect)
 }
 
 
+// [barreplay] H108 (toggle3 0x1): a frame's map-damage craters at once. Each
+// crater used to scan every cached and every used instance of every type.
+// One pass over each instead deletes the cached instances overlapping any
+// crater and queues for recalculation the used ones overlapping any, which are
+// the same two sets the craters one by one produce: nothing between them reads
+// or changes an instance (the height map, features, the smooth mesh and the
+// pathing are updated in between, none of which looks at LOS), a crater only
+// deletes instances nobody holds and only queues instances somebody does, and
+// a deleted instance is never queued. What can differ is only the order in
+// which instances are queued and deleted, and the queue is drained whole into
+// the update, whose map additions and removals are integer sums.
+void ILosType::BrUpdateHeightMapSyncedBatch(const std::vector<SRectangle>& rects)
+{
+	RECOIL_DETAILED_TRACY_ZONE;
+	if (algoType == LOS_ALGO_CIRCLE || rects.empty())
+		return;
+
+	// UpdateHeightMapSynced's CheckOverlap, for one rectangle
+	auto CheckOverlap = [&](const SLosInstance* li, const SRectangle& rect) -> bool {
+		int2 pos = li->basePos * mipDiv;
+		const int radius = li->radius * mipDiv;
+
+		const int hw = rect.GetWidth() * (SQUARE_SIZE / 2);
+		const int hh = rect.GetHeight() * (SQUARE_SIZE / 2);
+
+		int2 circleDistance;
+		circleDistance.x = std::abs(pos.x - rect.x1 * SQUARE_SIZE) - hw;
+		circleDistance.y = std::abs(pos.y - rect.y1 * SQUARE_SIZE) - hh;
+
+		if (circleDistance.x > radius) { return false; }
+		if (circleDistance.y > radius) { return false; }
+		if (circleDistance.x <= 0) { return true; }
+		if (circleDistance.y <= 0) { return true; }
+
+		return (Square(circleDistance.x) + Square(circleDistance.y)) <= Square(radius);
+	};
+	auto AnyOverlap = [&](const SLosInstance* li) -> bool {
+		for (const SRectangle& r: rects)
+			if (CheckOverlap(li, r))
+				return true;
+		return false;
+	};
+
+	for (auto it = losCache.begin(); it != losCache.end();) {
+		SLosInstance* li = *it;
+		if (li->refCount > 0 || !AnyOverlap(li)) {
+			++it;
+			continue;
+		}
+
+		it = losCache.erase(it);
+		li->isCached = false;
+		DeleteInstance(li);
+	}
+
+	for (auto& p: instanceHashes) {
+		for (SLosInstance* li: p.second) {
+			if (li->status & SLosInstance::TLosStatus::RECALC)
+				continue;
+			if (!AnyOverlap(li))
+				continue;
+
+			UpdateInstanceStatus(li, SLosInstance::TLosStatus::RECALC);
+		}
+	}
+}
+
+void CLosHandler::BrUpdateHeightMapSyncedBatch(const std::vector<SRectangle>& rects)
+{
+	RECOIL_DETAILED_TRACY_ZONE;
+	BrP7::RevertAll();
+	if ((g_brToggles & 0x40000000) != 0 && ThreadPool::HasThreads() && !ThreadPool::IsInMultiThreadedSection()) {
+		for_mt(0, losTypes.size(), [&](const int idx) {
+			losTypes[idx]->BrUpdateHeightMapSyncedBatch(rects);
+		});
+		return;
+	}
+	for (ILosType* lt: losTypes)
+		lt->BrUpdateHeightMapSyncedBatch(rects);
+}
