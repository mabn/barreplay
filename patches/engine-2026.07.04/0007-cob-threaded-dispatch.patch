+// [barreplay] THREADED DISPATCH (GCC/Clang computed goto). The interpreter
+// used to return to ONE indirect jump - the switch - after every opcode, so
+// that jump's target was the next opcode of whatever script ran, and it was
+// one of the most mispredicted branches of a re-simulation. Here every handler
+// ends in its own copy of the fetch + jump (COB_NEXT), whose target the branch
+// predictor learns per opcode pair. The switch is kept, and is still how the
+// loop is entered and where any other break lands, so the behaviour of every
+// opcode is the code below unchanged: COB_NEXT checks `state == Run` exactly
+// as the loop condition did, and fetches the opcode the same way.
+#if defined(__GNUC__) && !defined(COB_NO_THREADED_DISPATCH)
+#define COB_THREADED_DISPATCH 1
+#define COB_LABEL(name) cob_op_##name:
+#define COB_NEXT() do { \
+	if (state != Run) \
+		goto cob_exit; \
+	opcode = GET_LONG_PC(); \
+	const unsigned cobSlot = static_cast<unsigned>(opcode >> 12) - 0x10000u; \
+	goto *cobOps[(cobSlot < (sizeof(cobOps) / sizeof(cobOps[0])))? cobSlot: 0]; \
+} while (false)
+#else
+#define COB_THREADED_DISPATCH 0
+#define COB_LABEL(name)
+#define COB_NEXT() break
+#endif
+#define COB_CASE(op) case (op >> 12): COB_LABEL(op)
+
+#if COB_THREADED_DISPATCH && defined(__GNUC__) && !defined(__clang__)
+// Without these GCC folds the per-handler jumps back into a shared one
+// (cross-jumping merges identical tails, GCSE hoists the common fetch) and the
+// replication above is undone. Integer bookkeeping only: neither pass touches
+// floating-point semantics.
+#pragma GCC push_options
+#pragma GCC optimize ("no-crossjumping", "no-gcse")
+#define COB_POP_OPTIONS 1
+#endif
+
